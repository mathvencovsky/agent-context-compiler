          'Configure the app entrypoint in pyproject.toml',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 48,
        'page': None,
        'text': '''
          .
          ├── backend
          │   ├── main.py
          │   ├── __init__.py
  
        ''',
        'type': 'code',
      }),
