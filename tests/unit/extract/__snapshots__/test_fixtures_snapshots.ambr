        'links': list([
        ]),
        'order': 232,
        'page': None,
        'text': 'Default factories can take the validated model data as an argument.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_4b441d94a068',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
