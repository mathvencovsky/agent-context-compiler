        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic/base_model/#pydantic.BaseModel',
            'text': 'BaseModel',
          }),
        ]),
        'order': 3,
        'page': None,
        'text': 'One of the primary ways of defining schema in Pydantic is via models. Models are simply classes which inherit from BaseModel and define fields as annotated attributes.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_f97b52ebb1d3',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 4,
        'page': None,
        'text': 'You can think of models as similar to structs in languages like C, or as the requirements of a single endpoint in an API.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_a3a75678c475',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://docs.python.org/3/library/dataclasses.html#module-dataclasses',
