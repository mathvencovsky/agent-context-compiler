            dict({
              'definition': 'Return True if the path points to a regular file. False will be returned if the path is invalid, inaccessible or missing, or if it points to something other than a regular file. Use Path.stat() to distinguish between these cases. This method normally follows symlinks; to exclude symlinks, add the argument follow_symlinks=False. Changed in version 3.13: The follow_symlinks parameter was added.',
              'term': 'Path.is_file(*, follow_symlinks=True)',
            }),
          ]),
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
