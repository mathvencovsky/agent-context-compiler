        ]),
        'level': None,
        'links': list([
        ]),
        'order': 48,
        'page': None,
        'text': 'The string representation of a path is the raw filesystem path itself (in native form, e.g. with backslashes under Windows), which you can pass to any function taking a file path as a string:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_9574075d594b',
        'data': dict({
          'code': '''
            >>> p = PurePath('/etc')
            >>> str(p)
            '/etc'
            >>> p = PureWindowsPath('c:/Program Files')
            >>> str(p)
            'c:\\Program Files'
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Pure paths',
          'Operators',
        ]),
        'level': None,
        'links': list([
        ]),
