      dict({
        'block_id': 'b_2ded5a17c0f5',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Model copy',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic/base_model/#pydantic.BaseModel.model_copy',
            'text': 'model_copy()',
          }),
        ]),
        'order': 119,
        'page': None,
        'text': 'The model_copy() method allows models to be duplicated (with optional updates that aren’t validated), which is particularly useful when working with frozen models.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_b14c17426736',
        'data': dict({
          'code': '''
            from pydantic import BaseModel
            
            
            class BarModel(BaseModel):
                whatever: int
            
            
            class FooBarModel(BaseModel):
                banana: float
                foo: str
                bar: BarModel
            
            
            m = FooBarModel(banana=3.14, foo='hello', bar={'whatever': 123})
            
            print(m.model_copy(update={'banana': 0}))
            #> banana=0 foo='hello' bar=BarModel(whatever=123)
            
            # normal copy gives the same object reference for bar:
            print(id(m.bar) == id(m.model_copy().bar))
            #> True
            # deep copy gives a new object reference for `bar`:
            print(id(m.bar) == id(m.model_copy(deep=True).bar))
            #> False
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Model copy',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 120,
        'page': None,
        'text': '''
          from pydantic import BaseModel
          
          
          class BarModel(BaseModel):
              whatever: int
          
          
          class FooBarModel(BaseModel):
              banana: float
              foo: str
              bar: BarModel
          
          
          m = FooBarModel(banana=3.14, foo='hello', bar={'whatever': 123})
          
          print(m.model_copy(update={'banana': 0}))
          #> banana=0 foo='hello' bar=BarModel(whatever=123)
          
          # normal copy gives the same object reference for bar:
          print(id(m.bar) == id(m.model_copy().bar))
          #> True
          # deep copy gives a new object reference for `bar`:
          print(id(m.bar) == id(m.model_copy(deep=True).bar))
          #> False
  
        ''',
        'type': 'code',
      }),
