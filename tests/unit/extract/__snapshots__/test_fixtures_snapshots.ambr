        'type': 'code',
      }),
      dict({
        'block_id': 'b_ee08ae3cbe52',
        'data': dict({
          'kind': 'warning',
        }),
        'heading_path': list([
          'Models',
          'Generic models',
          'Validation of unparametrized type variables',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 163,
        'page': None,
        'text': "Caution In some cases, validation against an unparametrized generic model can lead to data loss. Specifically, if a subtype of the type variable upper bound, constraints, or default is being used and the model isn’t explicitly parametrized, the resulting type will not be the one being provided: When the generic isn't parametrized, the input data is validated against the ItemT upper bound. Given that ItemBase has no fields, the item field information is lost. In this case, the type variable is explicitly parametrized, so the input data is validated against the IntItem class.",
        'type': 'admonition',
      }),
      dict({
        'block_id': 'b_6c5ba6d38149',
        'data': dict({
          'code': '''
            from typing import Generic, TypeVar
            
            from pydantic import BaseModel
            
            ItemT = TypeVar('ItemT', bound='ItemBase')
            
            
            class ItemBase(BaseModel): ...
            
            
            class IntItem(ItemBase):
                value: int
            
            
            class ItemHolder(BaseModel, Generic[ItemT]):
                item: ItemT
            
            
            loaded_data = {'item': {'value': 1}}
            
            
            print(ItemHolder(**loaded_data))  # (1)
            #> item=ItemBase()
            
            print(ItemHolder[IntItem](**loaded_data))  # (2)
            #> item=IntItem(value=1)
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Generic models',
          'Validation of unparametrized type variables',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 164,
        'page': None,
        'text': '''
          from typing import Generic, TypeVar
          
          from pydantic import BaseModel
          
          ItemT = TypeVar('ItemT', bound='ItemBase')
          
          
          class ItemBase(BaseModel): ...
          
          
          class IntItem(ItemBase):
              value: int
          
          
          class ItemHolder(BaseModel, Generic[ItemT]):
              item: ItemT
          
          
          loaded_data = {'item': {'value': 1}}
          
          
          print(ItemHolder(**loaded_data))  # (1)
          #> item=ItemBase()
          
          print(ItemHolder[IntItem](**loaded_data))  # (2)
          #> item=IntItem(value=1)
        ''',
        'type': 'code',
      }),
      dict({
