      dict({
        'block_id': 'b_7963f0ff6842',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'action',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.Action',
            'text': 'Action',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.BooleanOptionalAction',
            'text': 'BooleanOptionalAction',
          }),
        ]),
        'order': 129,
        'page': None,
        'text': "You may also specify an arbitrary action by passing an Action subclass (e.g. BooleanOptionalAction) or other object that implements the same interface. Only actions that consume command-line arguments (e.g. 'store', 'append', 'extend', or custom actions with non-zero nargs) can be used with positional arguments.",
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_e731af50bf6c',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'action',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.Action',
            'text': 'Action',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser.register',
            'text': 'register()',
          }),
        ]),
        'order': 130,
        'page': None,
        'text': 'The recommended way to create a custom action is to extend Action, overriding the __call__() method and optionally the __init__() and format_usage() methods. You can also register custom actions using the register() method and reference them by their registered name.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_2577a0b10b87',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'action',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 131,
        'page': None,
        'text': 'An example of a custom action:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_1126b5449123',
        'data': dict({
          'code': '''
            >>> class FooAction(argparse.Action):
            ...     def __init__(self, option_strings, dest, nargs=None, **kwargs):
            ...         if nargs is not None:
            ...             raise ValueError("nargs not allowed")
            ...         super().__init__(option_strings, dest, **kwargs)
            ...     def __call__(self, parser, namespace, values, option_string=None):
            ...         print('%r %r %r' % (namespace, values, option_string))
            ...         setattr(namespace, self.dest, values)
            ...
            >>> parser = argparse.ArgumentParser()
            >>> parser.add_argument('--foo', action=FooAction)
            >>> parser.add_argument('bar', action=FooAction)
            >>> args = parser.parse_args('1 --foo 2'.split())
            Namespace(bar=None, foo=None) '1' None
            Namespace(bar='1', foo=None) '2' '--foo'
            >>> args
            Namespace(bar='1', foo='2')
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'action',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 132,
        'page': None,
        'text': '''
          >>> class FooAction(argparse.Action):
          ...     def __init__(self, option_strings, dest, nargs=None, **kwargs):
          ...         if nargs is not None:
          ...             raise ValueError("nargs not allowed")
          ...         super().__init__(option_strings, dest, **kwargs)
          ...     def __call__(self, parser, namespace, values, option_string=None):
          ...         print('%r %r %r' % (namespace, values, option_string))
          ...         setattr(namespace, self.dest, values)
          ...
          >>> parser = argparse.ArgumentParser()
          >>> parser.add_argument('--foo', action=FooAction)
          >>> parser.add_argument('bar', action=FooAction)
          >>> args = parser.parse_args('1 --foo 2'.split())
          Namespace(bar=None, foo=None) '1' None
          Namespace(bar='1', foo=None) '2' '--foo'
          >>> args
          Namespace(bar='1', foo='2')
  
        ''',
        'type': 'code',
      }),
