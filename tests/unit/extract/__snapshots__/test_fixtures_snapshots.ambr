      dict({
        'block_id': 'b_5bf55b9ed40c',
        'data': dict({
          'items': list([
            dict({
              'definition': 'Load “dotenv” files to set environment variables. A given path takes precedence over .env, which takes precedence over .flaskenv. After loading and combining these files, values are only set if the key is not already set in os.environ. This is a no-op if python-dotenv is not installed. Changed in version 3.1: Added the load_defaults parameter. A given path takes precedence over default files. Changelog Changed in version 2.0: The current directory is not changed to the location of the loaded file. Changed in version 2.0: When loading the env files, set the default encoding to UTF-8. Changed in version 1.1.0: Returns False when python-dotenv is not installed, or when the given path isn’t a file. Added in version 1.0.',
              'term': 'flask.cli.load_dotenv(path=None, load_defaults=True)',
            }),
          ]),
        }),
        'heading_path': list([
          'API',
          'Command Line Interface',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://github.com/theskumar/python-dotenv#readme',
            'text': 'python-dotenv',
          }),
          dict({
            'href': 'https://docs.python.org/3/library/stdtypes.html#str',
            'text': 'str',
          }),
          dict({
            'href': 'https://docs.python.org/3/library/os.html#os.PathLike',
            'text': 'PathLike',
          }),
          dict({
            'href': 'https://docs.python.org/3/library/stdtypes.html#str',
            'text': 'str',
          }),
          dict({
            'href': 'https://docs.python.org/3/library/functions.html#bool',
            'text': 'bool',
          }),
          dict({
            'href': 'https://docs.python.org/3/library/functions.html#bool',
            'text': 'bool',
          }),
        ]),
        'order': 983,
        'page': None,
        'text': 'flask.cli.load_dotenv(path=None, load_defaults=True) Load “dotenv” files to set environment variables. A given path takes precedence over .env, which takes precedence over .flaskenv. After loading and combining these files, values are only set if the key is not already set in os.environ. This is a no-op if python-dotenv is not installed. Changed in version 3.1: Added the load_defaults parameter. A given path takes precedence over default files. Changelog Changed in version 2.0: The current directory is not changed to the location of the loaded file. Changed in version 2.0: When loading the env files, set the default encoding to UTF-8. Changed in version 1.1.0: Returns False when python-dotenv is not installed, or when the given path isn’t a file. Added in version 1.0.',
        'type': 'definition_list',
      }),
