        ]),
        'order': 1442,
        'page': None,
        'text': 'Breaking Changes',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_d74b0acf51ab',
        'data': dict({
          'items': list([
            '✨ Update internal AsyncExitStack to fix context for dependencies with yield. PR #4575 by @tiangolo.',
          ]),
          'ordered': False,
        }),
        'heading_path': list([
          'Release Notes',
          '0.74.0 (2022-02-17)',
          'Breaking Changes',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://github.com/tiangolo/fastapi/pull/4575',
            'text': '#4575',
          }),
          dict({
            'href': 'https://github.com/tiangolo',
            'text': '@tiangolo',
          }),
        ]),
        'order': 1443,
        'page': None,
        'text': '✨ Update internal AsyncExitStack to fix context for dependencies with yield. PR #4575 by @tiangolo.',
        'type': 'list',
      }),
      dict({
        'block_id': 'b_3913fb3cc97e',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.74.0 (2022-02-17)',
          'Breaking Changes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1444,
        'page': None,
        'text': 'Dependencies with yield can now catch HTTPException and custom exceptions. For example:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_d3a9d627e331',
        'data': dict({
          'code': '''
            async def get_database():
                with Session() as session:
                    try:
                        yield session
                    except HTTPException:
                        session.rollback()
                        raise
                    finally:
                        session.close()
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'Release Notes',
          '0.74.0 (2022-02-17)',
          'Breaking Changes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1445,
        'page': None,
        'text': '''
          async def get_database():
              with Session() as session:
                  try:
                      yield session
                  except HTTPException:
                      session.rollback()
                      raise
                  finally:
                      session.close()
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_8ebae253d81b',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.74.0 (2022-02-17)',
          'Breaking Changes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1446,
        'page': None,
        'text': 'After the dependency with yield handles the exception (or not) the exception is raised again. So that any exception handlers can catch it, or ultimately the default internal ServerErrorMiddleware.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_d83381c53323',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.74.0 (2022-02-17)',
          'Breaking Changes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1447,
        'page': None,
        'text': 'If you depended on exceptions not being received by dependencies with yield, and receiving an exception breaks the code after yield, you can use a block with try and finally:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_13fe81c2d6bd',
        'data': dict({
          'code': '''
            async def do_something():
                try:
                    yield something
                finally:
                    some_cleanup()
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'Release Notes',
          '0.74.0 (2022-02-17)',
          'Breaking Changes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1448,
        'page': None,
        'text': '''
          async def do_something():
              try:
                  yield something
              finally:
                  some_cleanup()
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_5fd0b606ffcb',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.74.0 (2022-02-17)',
          'Breaking Changes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1449,
        'page': None,
        'text': '...that way the finally block is run regardless of any exception that might happen.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_daa37f50b80d',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.74.0 (2022-02-17)',
        ]),
        'level': 3,
        'links': list([
        ]),
        'order': 1450,
        'page': None,
        'text': 'Features',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_37c8a57324a6',
        'data': dict({
          'items': list([
            'The same PR #4575 from above also fixes the contextvars context for the code before and after yield. This was the main objective of that PR.',
          ]),
          'ordered': False,
        }),
        'heading_path': list([
          'Release Notes',
          '0.74.0 (2022-02-17)',
          'Features',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://github.com/tiangolo/fastapi/pull/4575',
            'text': '#4575',
          }),
        ]),
        'order': 1451,
        'page': None,
        'text': 'The same PR #4575 from above also fixes the contextvars context for the code before and after yield. This was the main objective of that PR.',
        'type': 'list',
      }),
      dict({
        'block_id': 'b_76760d28fa70',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.74.0 (2022-02-17)',
          'Features',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1452,
        'page': None,
        'text': 'This means that now, if you set a value in a context variable before yield, the value would still be available after yield (as you would intuitively expect). And it also means that you can reset the context variable with a token afterwards.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_648ffca3c2fd',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.74.0 (2022-02-17)',
          'Features',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1453,
        'page': None,
        'text': 'For example, this works correctly now:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_07ac81f607b2',
        'data': dict({
          'code': '''
            from contextvars import ContextVar
            from typing import Any, Dict, Optional
            
            
            legacy_request_state_context_var: ContextVar[Optional[Dict[str, Any]]] = ContextVar(
                "legacy_request_state_context_var", default=None
            )
            
            async def set_up_request_state_dependency():
                request_state = {"user": "deadpond"}
                contextvar_token = legacy_request_state_context_var.set(request_state)
                yield request_state
                legacy_request_state_context_var.reset(contextvar_token)
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'Release Notes',
          '0.74.0 (2022-02-17)',
          'Features',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1454,
        'page': None,
        'text': '''
          from contextvars import ContextVar
          from typing import Any, Dict, Optional
          
          
          legacy_request_state_context_var: ContextVar[Optional[Dict[str, Any]]] = ContextVar(
              "legacy_request_state_context_var", default=None
          )
          
          async def set_up_request_state_dependency():
              request_state = {"user": "deadpond"}
              contextvar_token = legacy_request_state_context_var.set(request_state)
              yield request_state
              legacy_request_state_context_var.reset(contextvar_token)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_ebd70c6e12c9',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.74.0 (2022-02-17)',
          'Features',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1455,
        'page': None,
        'text': '...before this change it would raise an error when resetting the context variable, because the contextvars context was different, because of the way it was implemented.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_cc3cd24304f1',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.74.0 (2022-02-17)',
          'Features',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1456,
        'page': None,
        'text': "Note: You probably don't need contextvars, and you should probably avoid using them. But they are powerful and useful in some advanced scenarios, for example, migrating from code that used Flask's g semi-global variable.",
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_767efa002c9f',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.74.0 (2022-02-17)',
          'Features',
        ]),
        'level': None,
        'links': list([
