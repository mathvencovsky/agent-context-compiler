          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#metavar',
            'text': 'metavar',
          }),
        ]),
        'order': 117,
        'page': None,
        'text': 'By default, argparse automatically handles the internal naming and display names of arguments, simplifying the process without requiring additional configuration. As such, you do not need to specify the dest and metavar parameters. For optional arguments, the dest parameter defaults to the argument name, with underscores _ replacing hyphens -. The metavar parameter defaults to the upper-cased name. For example:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_e4055305137f',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(prog='PROG')
            >>> parser.add_argument('--foo-bar')
            >>> parser.parse_args(['--foo-bar', 'FOO-BAR'])
            Namespace(foo_bar='FOO-BAR')
            >>> parser.print_help()
            usage:  [-h] [--foo-bar FOO-BAR]
            
            optional arguments:
             -h, --help  show this help message and exit
             --foo-bar FOO-BAR
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'name or flags',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 118,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(prog='PROG')
          >>> parser.add_argument('--foo-bar')
          >>> parser.parse_args(['--foo-bar', 'FOO-BAR'])
