          dict({
            'href': 'https://urllib3.readthedocs.io/en/latest/reference/urllib3.util.html#urllib3.util.SSLContext',
            'text': 'ssl.SSLContext',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/requests_api_reference.html#requests.PreparedRequest',
