        'data': dict({
          'items': list([
            dict({
              'definition': 'Convert an integer number to an octal string prefixed with “0o”. The result is a valid Python expression. If integer is not a Python int object, it has to define an __index__() method that returns an integer. For example: If you want to convert an integer number to an octal string either with the prefix “0o” or not, you can use either of the following ways. See also format() for more information.',
              'term': 'oct(integer, /)',
            }),
          ]),
