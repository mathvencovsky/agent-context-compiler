          'OpenAPI',
          'Data "schema"',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 29,
        'page': None,
        'text': 'The term "schema" might also refer to the shape of some data, like a JSON content.',
        'type': 'paragraph',
      }),
      dict({
