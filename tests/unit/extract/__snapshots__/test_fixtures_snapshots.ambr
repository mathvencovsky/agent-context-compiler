      dict({
        'block_id': 'b_37e249e738b0',
        'data': dict({
          'code': '''
            from fastapi import FastAPI
            from pydantic import BaseModel
            
            
            class Item(BaseModel):
                name: str
                description: str | None = None
                price: float
                tax: float | None = None
            
            
            app = FastAPI()
            
            
            @app.put("/items/{item_id}")
            async def update_item(item_id: int, item: Item, q: str | None = None):
                result = {"item_id": item_id, **item.model_dump()}
                if q:
                    result.update({"q": q})
                return result
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'Request Body',
          'Request body + path + query parameters',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 54,
        'page': None,
        'text': '''
          from fastapi import FastAPI
          from pydantic import BaseModel
          
          
          class Item(BaseModel):
              name: str
              description: str | None = None
              price: float
              tax: float | None = None
          
          
          app = FastAPI()
          
          
          @app.put("/items/{item_id}")
          async def update_item(item_id: int, item: Item, q: str | None = None):
              result = {"item_id": item_id, **item.model_dump()}
              if q:
                  result.update({"q": q})
              return result
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_f6a7ac88daf1',
        'data': dict({
        }),
        'heading_path': list([
          'Request Body',
          'Request body + path + query parameters',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 55,
        'page': None,
        'text': 'The function parameters will be recognized as follows:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_35468c67fb9d',
        'data': dict({
          'items': list([
            'If the parameter is also declared in the path, it will be used as a path parameter.',
            'If the parameter is of a singular type (like int, float, str, bool, etc) it will be interpreted as a query parameter.',
            'If the parameter is declared to be of the type of a Pydantic model, it will be interpreted as a request body.',
          ]),
          'ordered': False,
        }),
        'heading_path': list([
          'Request Body',
          'Request body + path + query parameters',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 56,
        'page': None,
        'text': 'If the parameter is also declared in the path, it will be used as a path parameter. If the parameter is of a singular type (like int, float, str, bool, etc) it will be interpreted as a query parameter. If the parameter is declared to be of the type of a Pydantic model, it will be interpreted as a request body.',
        'type': 'list',
      }),
      dict({
        'block_id': 'b_a0c0778903e2',
        'data': dict({
          'kind': 'note',
        }),
        'heading_path': list([
          'Request Body',
          'Request body + path + query parameters',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 57,
        'page': None,
        'text': "Note FastAPI will know that the value of q is not required because of the default value = None. The str | None is not used by FastAPI to determine that the value is not required, it will know it's not required because it has a default value of = None. But adding the type annotations will allow your editor to give you better support and detect errors.",
        'type': 'admonition',
      }),
      dict({
