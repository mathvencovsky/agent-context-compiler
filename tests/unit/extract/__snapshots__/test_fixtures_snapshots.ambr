          }),
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic/base_model/#pydantic.BaseModel.model_construct',
            'text': 'model_construct()',
          }),
        ]),
        'order': 89,
        'page': None,
        'text': 'Note that for root models, the root value can be passed to model_construct() positionally, instead of using a keyword argument.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_27a301e5416a',
