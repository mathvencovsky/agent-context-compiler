      dict({
        'block_id': 'b_e3ed445977ce',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Discriminator',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 110,
        'page': None,
        'text': 'The parameter discriminator can be used to control the field that will be used to discriminate between different models in a union. It takes either the name of a field or a Discriminator instance. The Discriminator approach can be useful when the discriminator fields aren’t the same for all the models in the union.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_b82540403459',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Discriminator',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 111,
        'page': None,
        'text': 'The following example shows how to use discriminator with a field name:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_dea61f4759b7',
        'data': dict({
          'code': '''
            from typing import Literal
            
            from pydantic import BaseModel, Field
            
            
            class Cat(BaseModel):
                pet_type: Literal['cat']
                age: int
            
            
            class Dog(BaseModel):
                pet_type: Literal['dog']
                age: int
            
            
            class Model(BaseModel):
                pet: Cat | Dog = Field(discriminator='pet_type')
            
            
            print(Model.model_validate({'pet': {'pet_type': 'cat', 'age': 12}}))  # (1)
            #> pet=Cat(pet_type='cat', age=12)
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Fields',
          'Discriminator',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 112,
        'page': None,
        'text': '''
          from typing import Literal
          
          from pydantic import BaseModel, Field
          
          
          class Cat(BaseModel):
              pet_type: Literal['cat']
              age: int
          
          
          class Dog(BaseModel):
              pet_type: Literal['dog']
              age: int
          
          
          class Model(BaseModel):
              pet: Cat | Dog = Field(discriminator='pet_type')
          
          
          print(Model.model_validate({'pet': {'pet_type': 'cat', 'age': 12}}))  # (1)
          #> pet=Cat(pet_type='cat', age=12)
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_f27870bdad3e',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Discriminator',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/concepts/models/#validating-data',
            'text': 'Validating data',
          }),
        ]),
        'order': 113,
        'page': None,
        'text': 'See more about model_validate() in the Validating data documentation.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_173e09128945',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Discriminator',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 114,
        'page': None,
        'text': 'The following example shows how to use the discriminator keyword argument with a Discriminator instance:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_580ddb75a6f9',
        'data': dict({
          'code': '''
            from typing import Annotated, Literal
            
            from pydantic import BaseModel, Discriminator, Field, Tag
            
            
            class Cat(BaseModel):
                pet_type: Literal['cat']
                age: int
            
            
            class Dog(BaseModel):
                pet_kind: Literal['dog']
                age: int
            
            
            def pet_discriminator(v):
                if isinstance(v, dict):
                    return v.get('pet_type', v.get('pet_kind'))
                return getattr(v, 'pet_type', getattr(v, 'pet_kind', None))
            
            
            class Model(BaseModel):
                pet: Annotated[Cat, Tag('cat')] | Annotated[Dog, Tag('dog')] = Field(
                    discriminator=Discriminator(pet_discriminator)
                )
            
            
            print(repr(Model.model_validate({'pet': {'pet_type': 'cat', 'age': 12}})))
            #> Model(pet=Cat(pet_type='cat', age=12))
            
            print(repr(Model.model_validate({'pet': {'pet_kind': 'dog', 'age': 12}})))
            #> Model(pet=Dog(pet_kind='dog', age=12))
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Fields',
          'Discriminator',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 115,
        'page': None,
        'text': '''
          from typing import Annotated, Literal
          
          from pydantic import BaseModel, Discriminator, Field, Tag
          
          
          class Cat(BaseModel):
              pet_type: Literal['cat']
              age: int
          
          
          class Dog(BaseModel):
              pet_kind: Literal['dog']
              age: int
          
          
          def pet_discriminator(v):
              if isinstance(v, dict):
                  return v.get('pet_type', v.get('pet_kind'))
              return getattr(v, 'pet_type', getattr(v, 'pet_kind', None))
          
          
          class Model(BaseModel):
              pet: Annotated[Cat, Tag('cat')] | Annotated[Dog, Tag('dog')] = Field(
                  discriminator=Discriminator(pet_discriminator)
              )
          
          
          print(repr(Model.model_validate({'pet': {'pet_type': 'cat', 'age': 12}})))
          #> Model(pet=Cat(pet_type='cat', age=12))
          
          print(repr(Model.model_validate({'pet': {'pet_kind': 'dog', 'age': 12}})))
          #> Model(pet=Dog(pet_kind='dog', age=12))
  
        ''',
        'type': 'code',
      }),
      dict({
