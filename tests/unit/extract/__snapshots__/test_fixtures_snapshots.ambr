        'data': dict({
          'code': '''
            >>> import requests
            >>> req = requests.Request('GET', 'https://httpbin.org/get')
            >>> r = req.prepare()
            >>> r
            <PreparedRequest [GET]>
            
            >>> s = requests.Session()
            >>> s.send(r)
            <Response [200]>
  
          ''',
