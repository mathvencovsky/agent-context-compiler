        'data': dict({
          'items': list([
            dict({
              'definition': 'Called after the request is dispatched and the response is returned, right before the request context is popped. This calls all functions decorated with teardown_request(), and Blueprint.teardown_request() if a blueprint handled the request. Finally, the request_tearing_down signal is sent. This is called by RequestContext.pop(), which may be delayed during testing to maintain access to resources. Changelog Changed in version 0.9: Added the exc argument.',
              'term': 'do_teardown_request(exc=_sentinel)',
            }),
          ]),
