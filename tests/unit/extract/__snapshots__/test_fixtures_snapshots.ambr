        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic/fields/#pydantic.fields.PrivateAttr',
            'text': 'pydantic.fields.PrivateAttr',
          }),
        ]),
        'order': 225,
        'page': None,
        'text': 'pydantic.fields.PrivateAttr',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_564671356b6a',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Automatically excluded attributes',
          'Private model attributes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 226,
        'page': None,
        'text': 'Attributes whose name has a leading underscore are not treated as fields by Pydantic, and are not included in the model schema. Instead, these are converted into a “private attribute” which is not validated or even set during calls to __init__, model_validate, etc.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_1f165ecbbb7d',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Automatically excluded attributes',
          'Private model attributes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 227,
        'page': None,
        'text': 'Here is an example of usage:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_3b4c09bd6f26',
        'data': dict({
          'code': '''
            from datetime import datetime
            from random import randint
            from typing import Any
            
            from pydantic import BaseModel, PrivateAttr
            
            
            class TimeAwareModel(BaseModel):
                _processed_at: datetime = PrivateAttr(default_factory=datetime.now)
                _secret_value: str
            
                def model_post_init(self, context: Any) -> None:
                    # this could also be done with `default_factory`:
                    self._secret_value = randint(1, 5)
            
            
            m = TimeAwareModel()
            print(m._processed_at)
            #> 2032-01-02 03:04:05.000006
            print(m._secret_value)
            #> 3
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Automatically excluded attributes',
          'Private model attributes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 228,
        'page': None,
        'text': '''
          from datetime import datetime
          from random import randint
          from typing import Any
          
          from pydantic import BaseModel, PrivateAttr
          
          
          class TimeAwareModel(BaseModel):
              _processed_at: datetime = PrivateAttr(default_factory=datetime.now)
              _secret_value: str
          
              def model_post_init(self, context: Any) -> None:
                  # this could also be done with `default_factory`:
                  self._secret_value = randint(1, 5)
          
          
          m = TimeAwareModel()
          print(m._processed_at)
          #> 2032-01-02 03:04:05.000006
          print(m._secret_value)
          #> 3
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_a5ddab103312',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Automatically excluded attributes',
          'Private model attributes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 229,
        'page': None,
        'text': 'Private attribute names must start with underscore to prevent conflicts with model fields. However, dunder names (such as __attr__) are not supported, and will be completely ignored from the model definition.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_30bfc7ef5ca0',
        'data': dict({
