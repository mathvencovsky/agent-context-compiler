        'order': 167,
        'page': None,
        'text': 'As with regular fields, computed fields can be marked as being deprecated:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_536951aab55e',
        'data': dict({
          'code': '''
            from typing_extensions import deprecated
            
            from pydantic import BaseModel, computed_field
            
            
            class Box(BaseModel):
                width: float
                height: float
                depth: float
            
                @computed_field
                @property
                @deprecated("'volume' is deprecated")
                def volume(self) -> float:
                    return self.width * self.height * self.depth
  
          ''',
          'language': 'python',
        }),
