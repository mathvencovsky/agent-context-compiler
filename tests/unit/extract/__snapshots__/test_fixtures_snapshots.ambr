          dict({
            'href': 'https://docs.python.org/3/library/functions.html#bool',
            'text': 'bool',
          }),
        ]),
        'order': 671,
        'page': None,
        'text': 'flask.has_request_context() If you have code that wants to test if a request context is there or not this function can be used. For instance, you may want to take advantage of request information if the request object is available, but fail silently if it is unavailable. Alternatively you can also just test any of the context bound objects (such as request or g) for truthness: Changelog Added in version 0.7.',
        'type': 'definition_list',
      }),
      dict({
        'block_id': 'b_77c4b76f1163',
        'data': dict({
          'code': '''
            class User(db.Model):
            
                def __init__(self, username, remote_addr=None):
                    self.username = username
                    if remote_addr is None and has_request_context():
                        remote_addr = request.remote_addr
                    self.remote_addr = remote_addr
  
          ''',
          'language': None,
        }),
