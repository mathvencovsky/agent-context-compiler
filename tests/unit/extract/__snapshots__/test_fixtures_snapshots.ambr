        'level': None,
        'links': list([
        ]),
        'order': 51,
        'page': None,
        'text': 'For validation and serialization, you can define an alias for a field.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_5ed1a5286ef6',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Field aliases',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 52,
        'page': None,
        'text': 'There are three ways to define an alias:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_4cd101cd7f0e',
        'data': dict({
          'items': list([
            "Field(alias='foo')",
            "Field(validation_alias='foo')",
            "Field(serialization_alias='foo')",
          ]),
          'ordered': False,
        }),
        'heading_path': list([
          'Fields',
          'Field aliases',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 53,
        'page': None,
        'text': "Field(alias='foo') Field(validation_alias='foo') Field(serialization_alias='foo')",
        'type': 'list',
      }),
      dict({
        'block_id': 'b_1eb3a0396f55',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Field aliases',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 54,
        'page': None,
        'text': 'The alias parameter is used for both validation and serialization. If you want to use different aliases for validation and serialization respectively, you can use the validation_alias and serialization_alias parameters, which will apply only in their respective use cases.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_3884cda1b5f8',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Field aliases',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 55,
        'page': None,
        'text': 'Here is an example of using the alias parameter:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_94780b83bc40',
        'data': dict({
          'code': '''
            from pydantic import BaseModel, Field
            
            
            class User(BaseModel):
                name: str = Field(alias='username')
            
            
            user = User(username='johndoe')  # (1)
            print(user)
            #> name='johndoe'
            print(user.model_dump(by_alias=True))  # (2)
            #> {'username': 'johndoe'}
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Fields',
          'Field aliases',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 56,
        'page': None,
        'text': '''
          from pydantic import BaseModel, Field
          
          
          class User(BaseModel):
              name: str = Field(alias='username')
          
          
          user = User(username='johndoe')  # (1)
          print(user)
          #> name='johndoe'
          print(user.model_dump(by_alias=True))  # (2)
          #> {'username': 'johndoe'}
        ''',
        'type': 'code',
      }),
