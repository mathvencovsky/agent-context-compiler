      dict({
        'block_id': 'b_f00698b57d56',
        'data': dict({
          'items': list([
            dict({
              'definition': 'Return True if the path is a mount point: a point in a file system where a different file system has been mounted. On POSIX, the function checks whether path’s parent, path/.., is on a different device than path, or whether path/.. and path point to the same i-node on the same device — this should detect mount points for all Unix and POSIX variants. On Windows, a mount point is considered to be a drive letter root (e.g. c:\\), a UNC share (e.g. \\\\server\\share), or a mounted filesystem directory. Added in version 3.7. Changed in version 3.12: Windows support was added.',
              'term': 'Path.is_mount()',
            }),
          ]),
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Concrete paths',
          'Querying file type and status',
        ]),
        'level': None,
        'links': list([
        ]),
