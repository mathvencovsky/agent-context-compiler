        'data': dict({
          'items': list([
            dict({
              'definition': 'Return an enumerate object. iterable must be a sequence, an iterator, or some other object which supports iteration. The __next__() method of the iterator returned by enumerate() returns a tuple containing a count (from start which defaults to 0) and the values obtained from iterating over iterable. Equivalent to:',
              'term': 'enumerate(iterable, start=0)',
