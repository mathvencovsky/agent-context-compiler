      dict({
        'block_id': 'b_b114268bf31a',
        'data': dict({
          'code': '''
            from pydantic import BaseModel, Field
            
            
            class User(BaseModel):
                name: str
                age: int = Field(exclude=True)
            
            
            user = User(name='John', age=42)
            print(user.model_dump())  # (1)
            #> {'name': 'John'}
          ''',
          'language': 'python',
