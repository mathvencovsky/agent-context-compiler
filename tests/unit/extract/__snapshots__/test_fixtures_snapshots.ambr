        'data': dict({
          'items': list([
            dict({
              'definition': 'This method terminates the program, exiting with the specified status and, if given, it prints a message to sys.stderr before that. The user can override this method to handle these steps differently:',
              'term': 'ArgumentParser.exit(status=0, message=None)',
            }),
          ]),
