      dict({
        'block_id': 'b_60af733117f8',
        'data': dict({
          'items': list([
            dict({
              'definition': 'Most of the time, the attributes of the object returned by parse_args() will be fully determined by inspecting the command-line arguments and the argument actions. set_defaults() allows some additional attributes that are determined without any inspection of the command line to be added: Note that defaults can be set at both the parser level using set_defaults() and at the argument level using add_argument(). If both are called for the same argument, the last default set for an argument is used: Parser-level defaults can be particularly useful when working with multiple parsers. See the add_subparsers() method for an example of this type.',
              'term': 'ArgumentParser.set_defaults(**kwargs)',
            }),
          ]),
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'Other utilities',
          'Parser defaults',
