      dict({
        'block_id': 'b_d73bb86c70cf',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The parse_args() method',
          'Option value syntax',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser.parse_args',
            'text': 'parse_args()',
          }),
        ]),
        'order': 231,
        'page': None,
        'text': 'The parse_args() method supports several ways of specifying the value of an option (if it takes one). In the simplest case, the option and its value are passed as two separate arguments:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_76fce1eccb79',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(prog='PROG')
            >>> parser.add_argument('-x')
            >>> parser.add_argument('--foo')
            >>> parser.parse_args(['-x', 'X'])
            Namespace(foo=None, x='X')
            >>> parser.parse_args(['--foo', 'FOO'])
            Namespace(foo='FOO', x=None)
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The parse_args() method',
          'Option value syntax',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 232,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(prog='PROG')
          >>> parser.add_argument('-x')
          >>> parser.add_argument('--foo')
          >>> parser.parse_args(['-x', 'X'])
          Namespace(foo=None, x='X')
          >>> parser.parse_args(['--foo', 'FOO'])
          Namespace(foo='FOO', x=None)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_351deed8aff4',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The parse_args() method',
          'Option value syntax',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 233,
        'page': None,
        'text': 'For long options (options with names longer than a single character), the option and value can also be passed as a single command-line argument, using = to separate them:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_f614766d6c14',
        'data': dict({
          'code': '''
            >>> parser.parse_args(['--foo=FOO'])
            Namespace(foo='FOO', x=None)
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The parse_args() method',
          'Option value syntax',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 234,
        'page': None,
        'text': '''
          >>> parser.parse_args(['--foo=FOO'])
          Namespace(foo='FOO', x=None)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_b020b0f6033b',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The parse_args() method',
          'Option value syntax',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 235,
        'page': None,
        'text': 'For short options (options only one character long), the option and its value can be concatenated:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_6b5c8274a100',
        'data': dict({
          'code': '''
            >>> parser.parse_args(['-xX'])
            Namespace(foo=None, x='X')
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The parse_args() method',
          'Option value syntax',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 236,
        'page': None,
        'text': '''
          >>> parser.parse_args(['-xX'])
          Namespace(foo=None, x='X')
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_9dca1095a98d',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The parse_args() method',
          'Option value syntax',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 237,
        'page': None,
        'text': 'Several short options can be joined together, using only a single - prefix, as long as only the last option (or none of them) requires a value:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_c698f0dab422',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(prog='PROG')
            >>> parser.add_argument('-x', action='store_true')
            >>> parser.add_argument('-y', action='store_true')
            >>> parser.add_argument('-z')
            >>> parser.parse_args(['-xyzZ'])
            Namespace(x=True, y=True, z='Z')
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The parse_args() method',
          'Option value syntax',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 238,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(prog='PROG')
          >>> parser.add_argument('-x', action='store_true')
          >>> parser.add_argument('-y', action='store_true')
          >>> parser.add_argument('-z')
          >>> parser.parse_args(['-xyzZ'])
          Namespace(x=True, y=True, z='Z')
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_e1a4fdfa2a32',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The parse_args() method',
        ]),
        'level': 3,
        'links': list([
        ]),
        'order': 239,
        'page': None,
        'text': 'Invalid arguments',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_6dadc1d383c3',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The parse_args() method',
          'Invalid arguments',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser.parse_args',
            'text': 'parse_args()',
          }),
        ]),
        'order': 240,
        'page': None,
        'text': 'While parsing the command line, parse_args() checks for a variety of errors, including ambiguous options, invalid types, invalid options, wrong number of positional arguments, etc. When it encounters such an error, it exits and prints the error along with a usage message:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_bb2c2ecc39f1',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(prog='PROG')
            >>> parser.add_argument('--foo', type=int)
            >>> parser.add_argument('bar', nargs='?')
            
            >>> # invalid type
            >>> parser.parse_args(['--foo', 'spam'])
            usage: PROG [-h] [--foo FOO] [bar]
            PROG: error: argument --foo: invalid int value: 'spam'
            
            >>> # invalid option
            >>> parser.parse_args(['--bar'])
            usage: PROG [-h] [--foo FOO] [bar]
            PROG: error: unrecognized arguments: --bar
            
            >>> # wrong number of arguments
            >>> parser.parse_args(['spam', 'badger'])
            usage: PROG [-h] [--foo FOO] [bar]
            PROG: error: unrecognized arguments: badger
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The parse_args() method',
          'Invalid arguments',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 241,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(prog='PROG')
          >>> parser.add_argument('--foo', type=int)
          >>> parser.add_argument('bar', nargs='?')
          
          >>> # invalid type
          >>> parser.parse_args(['--foo', 'spam'])
          usage: PROG [-h] [--foo FOO] [bar]
          PROG: error: argument --foo: invalid int value: 'spam'
          
          >>> # invalid option
          >>> parser.parse_args(['--bar'])
          usage: PROG [-h] [--foo FOO] [bar]
          PROG: error: unrecognized arguments: --bar
          
          >>> # wrong number of arguments
          >>> parser.parse_args(['spam', 'badger'])
          usage: PROG [-h] [--foo FOO] [bar]
          PROG: error: unrecognized arguments: badger
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_fd5a42e49a1c',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The parse_args() method',
        ]),
        'level': 3,
        'links': list([
        ]),
        'order': 242,
        'page': None,
        'text': 'Arguments containing -',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_ba48101767fc',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The parse_args() method',
          'Arguments containing -',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser.parse_args',
            'text': 'parse_args()',
          }),
        ]),
        'order': 243,
        'page': None,
        'text': 'The parse_args() method attempts to give errors whenever the user has clearly made a mistake, but some situations are inherently ambiguous. For example, the command-line argument -1 could either be an attempt to specify an option or an attempt to provide a positional argument. The parse_args() method is cautious here: positional arguments may only begin with - if they look like negative numbers and there are no options in the parser that look like negative numbers:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_39cb266b16d3',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(prog='PROG')
            >>> parser.add_argument('-x')
            >>> parser.add_argument('foo', nargs='?')
            
            >>> # no negative number options, so -1 is a positional argument
            >>> parser.parse_args(['-x', '-1'])
            Namespace(foo=None, x='-1')
            
            >>> # no negative number options, so -1 and -5 are positional arguments
            >>> parser.parse_args(['-x', '-1', '-5'])
            Namespace(foo='-5', x='-1')
            
            >>> parser = argparse.ArgumentParser(prog='PROG')
            >>> parser.add_argument('-1', dest='one')
            >>> parser.add_argument('foo', nargs='?')
            
            >>> # negative number options present, so -1 is an option
            >>> parser.parse_args(['-1', 'X'])
            Namespace(foo=None, one='X')
            
            >>> # negative number options present, so -2 is an option
            >>> parser.parse_args(['-2'])
            usage: PROG [-h] [-1 ONE] [foo]
            PROG: error: unrecognized arguments: -2
            
            >>> # negative number options present, so both -1s are options
            >>> parser.parse_args(['-1', '-1'])
            usage: PROG [-h] [-1 ONE] [foo]
            PROG: error: argument -1: expected one argument
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The parse_args() method',
          'Arguments containing -',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 244,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(prog='PROG')
          >>> parser.add_argument('-x')
          >>> parser.add_argument('foo', nargs='?')
          
          >>> # no negative number options, so -1 is a positional argument
          >>> parser.parse_args(['-x', '-1'])
          Namespace(foo=None, x='-1')
          
          >>> # no negative number options, so -1 and -5 are positional arguments
          >>> parser.parse_args(['-x', '-1', '-5'])
          Namespace(foo='-5', x='-1')
          
          >>> parser = argparse.ArgumentParser(prog='PROG')
          >>> parser.add_argument('-1', dest='one')
          >>> parser.add_argument('foo', nargs='?')
          
          >>> # negative number options present, so -1 is an option
          >>> parser.parse_args(['-1', 'X'])
          Namespace(foo=None, one='X')
          
          >>> # negative number options present, so -2 is an option
          >>> parser.parse_args(['-2'])
          usage: PROG [-h] [-1 ONE] [foo]
          PROG: error: unrecognized arguments: -2
          
          >>> # negative number options present, so both -1s are options
          >>> parser.parse_args(['-1', '-1'])
          usage: PROG [-h] [-1 ONE] [foo]
          PROG: error: argument -1: expected one argument
  
        ''',
        'type': 'code',
      }),
