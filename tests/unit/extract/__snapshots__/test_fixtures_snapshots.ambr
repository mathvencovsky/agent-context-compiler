        }),
        'heading_path': list([
          'First Steps',
          'OpenAPI',
          '"Schema"',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 24,
        'page': None,
        'text': 'A "schema" is a definition or description of something. Not the code that implements it, but just an abstract description.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_8547b51e6fee',
        'data': dict({
        }),
        'heading_path': list([
          'First Steps',
