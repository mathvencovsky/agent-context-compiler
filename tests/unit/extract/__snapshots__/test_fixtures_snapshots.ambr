        'type': 'code',
      }),
      dict({
        'block_id': 'b_2502d241c252',
        'data': dict({
          'code': '''
            >>> '%#o' % 10, '%o' % 10
            ('0o12', '12')
            >>> format(10, '#o'), format(10, 'o')
            ('0o12', '12')
            >>> f'{10:#o}', f'{10:o}'
            ('0o12', '12')
  
          ''',
          'language': None,
