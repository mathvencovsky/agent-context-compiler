        'level': None,
        'links': list([
        ]),
        'order': 1,
        'page': None,
        'text': 'When you declare other function parameters that are not part of the path parameters, they are automatically interpreted as "query" parameters.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_a4be0faa5611',
        'data': dict({
        }),
        'heading_path': list([
          'Query Parameters',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 2,
        'page': None,
        'text': 'Python 3.10+',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_e6bf7a161de9',
        'data': dict({
          'code': '''
            from fastapi import FastAPI
            
            app = FastAPI()
            
            fake_items_db = [{"item_name": "Foo"}, {"item_name": "Bar"}, {"item_name": "Baz"}]
            
            
            @app.get("/items/")
            async def read_item(skip: int = 0, limit: int = 10):
                return fake_items_db[skip : skip + limit]
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'Query Parameters',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 3,
        'page': None,
        'text': '''
          from fastapi import FastAPI
          
          app = FastAPI()
          
          fake_items_db = [{"item_name": "Foo"}, {"item_name": "Bar"}, {"item_name": "Baz"}]
          
          
