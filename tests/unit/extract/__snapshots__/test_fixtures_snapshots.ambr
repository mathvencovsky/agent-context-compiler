      dict({
        'block_id': 'b_b64727e43768',
        'data': dict({
          'items': list([
            'The left-to-right evaluation order of the iterables is guaranteed. This makes possible an idiom for clustering a data series into n-length groups using zip(*[iter(s)]*n, strict=True). This repeats the same iterator n times so that each output tuple has the result of n calls to the iterator. This has the effect of dividing the input into n-length chunks.',
            'zip() in conjunction with the * operator can be used to unzip a list:',
          ]),
          'ordered': False,
        }),
        'heading_path': list([
          'Built-in functions',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 134,
        'page': None,
        'text': 'The left-to-right evaluation order of the iterables is guaranteed. This makes possible an idiom for clustering a data series into n-length groups using zip(*[iter(s)]*n, strict=True). This repeats the same iterator n times so that each output tuple has the result of n calls to the iterator. This has the effect of dividing the input into n-length chunks. zip() in conjunction with the * operator can be used to unzip a list:',
        'type': 'list',
      }),
      dict({
        'block_id': 'b_7df42d65f11c',
        'data': dict({
          'code': '''
            >>> x = [1, 2, 3]
            >>> y = [4, 5, 6]
            >>> list(zip(x, y))
            [(1, 4), (2, 5), (3, 6)]
            >>> x2, y2 = zip(*zip(x, y))
            >>> x == list(x2) and y == list(y2)
            True
  
          ''',
