      dict({
        'block_id': 'b_f7bc089c5a5e',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Default values',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/get-started/migration/#required-optional-and-nullable-fields',
            'text': 'In Pydantic V1',
          }),
          dict({
            'href': 'https://docs.python.org/3/library/typing.html#typing.Any',
            'text': 'Any',
          }),
          dict({
            'href': 'https://docs.python.org/3/library/typing.html#typing.Optional',
            'text': 'Optional',
          }),
        ]),
        'order': 29,
        'page': None,
        'text': 'In Pydantic V1, a type annotated as Any or wrapped by Optional would be given an implicit default of None even if no default was explicitly specified. This is no longer the case in Pydantic V2.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_9e8eed4d1c69',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Default values',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 30,
        'page': None,
        'text': 'You can also pass a callable to the default_factory argument that will be called to generate a default value:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_7592cfc9311f',
        'data': dict({
          'code': '''
            from uuid import uuid4
            
            from pydantic import BaseModel, Field
            
            
            class User(BaseModel):
                id: str = Field(default_factory=lambda: uuid4().hex)
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Fields',
          'Default values',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 31,
        'page': None,
        'text': '''
          from uuid import uuid4
          
          from pydantic import BaseModel, Field
          
          
          class User(BaseModel):
              id: str = Field(default_factory=lambda: uuid4().hex)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_0860063f8f78',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Default values',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 32,
        'page': None,
        'text': 'The default factory can also take a single required argument, in which case the already validated data will be passed as a dictionary.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_0e33c02d8955',
        'data': dict({
          'code': '''
            from pydantic import BaseModel, EmailStr, Field
            
            
            class User(BaseModel):
                email: EmailStr
                username: str = Field(default_factory=lambda data: data['email'])
            
            
            user = User(email='user@example.com')
            print(user.username)
            #> user@example.com
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Fields',
          'Default values',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 33,
        'page': None,
        'text': '''
          from pydantic import BaseModel, EmailStr, Field
          
          
          class User(BaseModel):
              email: EmailStr
              username: str = Field(default_factory=lambda data: data['email'])
          
          
          user = User(email='user@example.com')
          print(user.username)
          #> user@example.com
  
        ''',
        'type': 'code',
      }),
      dict({
