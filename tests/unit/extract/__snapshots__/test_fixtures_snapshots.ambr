            'text': 'conflict_handler',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#prefix-chars',
