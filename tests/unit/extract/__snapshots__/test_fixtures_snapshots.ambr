        'text': 'Security fixes',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_4d3e18788579',
        'data': dict({
          'items': list([
            '🔒 Check Content-Type request header before assuming JSON. Initial PR #2118 by @patrickkwang.',
          ]),
          'ordered': False,
        }),
        'heading_path': list([
          'Release Notes',
          '0.65.2 (2021-06-09)',
          'Security fixes',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://github.com/tiangolo/fastapi/pull/2118',
            'text': '#2118',
          }),
          dict({
            'href': 'https://github.com/patrickkwang',
            'text': '@patrickkwang',
          }),
        ]),
        'order': 1569,
        'page': None,
        'text': '🔒 Check Content-Type request header before assuming JSON. Initial PR #2118 by @patrickkwang.',
        'type': 'list',
      }),
      dict({
        'block_id': 'b_99b62ae02e36',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.65.2 (2021-06-09)',
          'Security fixes',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://en.wikipedia.org/wiki/Cross-site_request_forgery',
            'text': 'CSRF',
          }),
        ]),
        'order': 1570,
        'page': None,
        'text': 'This change fixes a CSRF security vulnerability when using cookies for authentication in path operations with JSON payloads sent by browsers.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_43892a6719a4',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.65.2 (2021-06-09)',
          'Security fixes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1571,
        'page': None,
        'text': 'In versions lower than 0.65.2, FastAPI would try to read the request payload as JSON even if the content-type header sent was not set to application/json or a compatible JSON media type (e.g. application/geo+json).',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_c740ab233f06',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.65.2 (2021-06-09)',
          'Security fixes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1572,
        'page': None,
        'text': 'So, a request with a content type of text/plain containing JSON data would be accepted and the JSON data would be extracted.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_2f29cfb4e850',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.65.2 (2021-06-09)',
          'Security fixes',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://developer.mozilla.org/en-US/docs/Web/HTTP/CORS',
            'text': 'CORS',
          }),
          dict({
            'href': 'https://developer.mozilla.org/en-US/docs/Web/HTTP/CORS#simple_requests',
            'text': 'Simple requests',
          }),
        ]),
        'order': 1573,
        'page': None,
        'text': 'But requests with content type text/plain are exempt from CORS preflights, for being considered Simple requests. So, the browser would execute them right away including cookies, and the text content could be a JSON string that would be parsed and accepted by the FastAPI application.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_b1f168459204',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.65.2 (2021-06-09)',
          'Security fixes',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://github.com/tiangolo/fastapi/security/advisories/GHSA-8h2j-cgx8-6xv7',
            'text': 'CVE-2021-32677',
          }),
        ]),
        'order': 1574,
        'page': None,
        'text': 'See CVE-2021-32677 for more details.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_63f3eb845ba4',
        'data': dict({
        }),
        'heading_path': list([
