            'text': 'globals()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/glossary.html#term-optimized-scope',
            'text': 'optimized scope',
          }),
          dict({
            'href': 'https://peps.python.org/pep-0709/',
            'text': 'PEP 709',
          }),
          dict({
            'href': 'https://peps.python.org/pep-0667/',
            'text': 'PEP 667',
          }),
          dict({
            'href': 'https://fixtures.nina.test/glossary.html#term-optimized-scope',
