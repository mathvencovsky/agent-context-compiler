      dict({
        'block_id': 'b_b80c762dd3cb',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Validate default values',
          'Mutable default values',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 45,
        'page': None,
        'text': 'A common source of bugs in Python is to use a mutable object as a default value for a function or method argument, as the same instance ends up being reused in each call.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_57374b3c7678',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Validate default values',
          'Mutable default values',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://docs.python.org/3/library/dataclasses.html#module-dataclasses',
            'text': 'dataclasses',
          }),
          dict({
            'href': 'https://docs.python.org/3/library/dataclasses.html#default-factory-functions',
            'text': 'default factory',
          }),
        ]),
        'order': 46,
        'page': None,
        'text': 'The dataclasses module actually raises an error in this case, indicating that you should use a default factory instead.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_0ecd9641e212',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Validate default values',
          'Mutable default values',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 47,
        'page': None,
        'text': 'While the same thing can be done in Pydantic, it is not required. In the event that the default value is not hashable, Pydantic will create a deep copy of the default value when creating each instance of the model:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_f3db26befa53',
        'data': dict({
          'code': '''
            from pydantic import BaseModel
            
            
            class Model(BaseModel):
                item_counts: list[dict[str, int]] = [{}]
            
            
            m1 = Model()
            m1.item_counts[0]['a'] = 1
            print(m1.item_counts)
            #> [{'a': 1}]
            
            m2 = Model()
            print(m2.item_counts)
            #> [{}]
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Fields',
          'Validate default values',
          'Mutable default values',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 48,
        'page': None,
        'text': '''
          from pydantic import BaseModel
          
          
          class Model(BaseModel):
              item_counts: list[dict[str, int]] = [{}]
          
          
          m1 = Model()
          m1.item_counts[0]['a'] = 1
          print(m1.item_counts)
          #> [{'a': 1}]
          
          m2 = Model()
          print(m2.item_counts)
          #> [{}]
  
        ''',
        'type': 'code',
      }),
