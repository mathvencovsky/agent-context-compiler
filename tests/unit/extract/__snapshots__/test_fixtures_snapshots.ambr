      dict({
        'block_id': 'b_63da71e99c6c',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Faux immutability',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic/config/#pydantic.config.ConfigDict.frozen',
            'text': 'API reference',
          }),
        ]),
        'order': 207,
        'page': None,
        'text': "Models can be configured to be immutable via model_config['frozen'] = True. When this is set, attempting to change the values of instance attributes will raise errors. See the API reference for more details.",
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_8dd2b5e3f807',
        'data': dict({
          'kind': 'note',
        }),
        'heading_path': list([
          'Models',
          'Faux immutability',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 208,
        'page': None,
        'text': 'Note This behavior was achieved in Pydantic V1 via the config setting allow_mutation = False. This config flag is deprecated in Pydantic V2, and has been replaced with frozen.',
        'type': 'admonition',
      }),
      dict({
        'block_id': 'b_b79184d73a18',
        'data': dict({
          'kind': 'warning',
        }),
        'heading_path': list([
          'Models',
          'Faux immutability',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 209,
        'page': None,
        'text': 'Caution In Python, immutability is not enforced. Developers have the ability to modify objects that are conventionally considered “immutable” if they choose to do so.',
        'type': 'admonition',
      }),
      dict({
        'block_id': 'b_da87dd0ecc3d',
        'data': dict({
          'code': '''
            from pydantic import BaseModel, ConfigDict, ValidationError
            
            
            class FooBarModel(BaseModel):
                model_config = ConfigDict(frozen=True)
            
                a: str
                b: dict
            
            
            foobar = FooBarModel(a='hello', b={'apple': 'pear'})
            
            try:
                foobar.a = 'different'
            except ValidationError as e:
                print(e)
                """
                1 validation error for FooBarModel
                a
                  Instance is frozen [type=frozen_instance, input_value='different', input_type=str]
                """
            
            print(foobar.a)
            #> hello
            print(foobar.b)
            #> {'apple': 'pear'}
            foobar.b['apple'] = 'grape'
            print(foobar.b)
            #> {'apple': 'grape'}
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Faux immutability',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 210,
        'page': None,
        'text': '''
          from pydantic import BaseModel, ConfigDict, ValidationError
          
          
          class FooBarModel(BaseModel):
              model_config = ConfigDict(frozen=True)
          
              a: str
              b: dict
          
          
          foobar = FooBarModel(a='hello', b={'apple': 'pear'})
          
          try:
              foobar.a = 'different'
          except ValidationError as e:
              print(e)
              """
              1 validation error for FooBarModel
              a
                Instance is frozen [type=frozen_instance, input_value='different', input_type=str]
              """
          
          print(foobar.a)
          #> hello
          print(foobar.b)
          #> {'apple': 'pear'}
          foobar.b['apple'] = 'grape'
          print(foobar.b)
          #> {'apple': 'grape'}
  
        ''',
        'type': 'code',
      }),
