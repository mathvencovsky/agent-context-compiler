        ]),
        'level': 4,
        'links': list([
        ]),
        'order': 25,
        'page': None,
        'text': 'API "schema"',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_0b4b7710a6f1',
        'data': dict({
        }),
        'heading_path': list([
          'First Steps',
          'OpenAPI',
          'API "schema"',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://github.com/OAI/OpenAPI-Specification',
            'text': 'OpenAPI',
          }),
        ]),
        'order': 26,
        'page': None,
        'text': 'In this case, OpenAPI is a specification that dictates how to define a schema of your API.',
        'type': 'paragraph',
      }),
      dict({
