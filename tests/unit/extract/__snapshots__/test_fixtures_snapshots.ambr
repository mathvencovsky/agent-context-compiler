      dict({
        'block_id': 'b_3d2452a0de9a',
        'data': dict({
          'items': list([
            'init: Whether the field should be included in the synthesized __init__() method of the dataclass.',
            'init_var: Whether the field should be init-only in the dataclass.',
            'kw_only: Whether the field should be a keyword-only argument in the constructor of the dataclass.',
          ]),
          'ordered': False,
        }),
        'heading_path': list([
          'Fields',
          'Dataclass fields',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://docs.python.org/3/library/dataclasses.html#dataclasses-init-only-variables',
            'text': 'init-only',
          }),
        ]),
        'order': 101,
        'page': None,
        'text': 'init: Whether the field should be included in the synthesized __init__() method of the dataclass. init_var: Whether the field should be init-only in the dataclass. kw_only: Whether the field should be a keyword-only argument in the constructor of the dataclass.',
        'type': 'list',
      }),
      dict({
        'block_id': 'b_a60252f71cb5',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Dataclass fields',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 102,
        'page': None,
        'text': 'Here is an example:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_7a4d75a8b58e',
        'data': dict({
          'code': '''
            from pydantic import BaseModel, Field
            from pydantic.dataclasses import dataclass
            
            
            @dataclass
            class Foo:
                bar: str
                baz: str = Field(init_var=True)
                qux: str = Field(kw_only=True)
            
            
            class Model(BaseModel):
                foo: Foo
            
            
            model = Model(foo=Foo('bar', baz='baz', qux='qux'))
            print(model.model_dump())  # (1)
            #> {'foo': {'bar': 'bar', 'qux': 'qux'}}
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Fields',
          'Dataclass fields',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 103,
        'page': None,
        'text': '''
          from pydantic import BaseModel, Field
          from pydantic.dataclasses import dataclass
          
          
          @dataclass
          class Foo:
              bar: str
              baz: str = Field(init_var=True)
              qux: str = Field(kw_only=True)
          
          
          class Model(BaseModel):
              foo: Foo
          
          
          model = Model(foo=Foo('bar', baz='baz', qux='qux'))
          print(model.model_dump())  # (1)
          #> {'foo': {'bar': 'bar', 'qux': 'qux'}}
        ''',
        'type': 'code',
      }),
