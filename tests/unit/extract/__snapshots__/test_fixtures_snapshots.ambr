        'level': None,
        'links': list([
        ]),
        'order': 1,
        'page': None,
        'text': 'Admonitions, also known as call-outs, are an excellent choice for including side content without significantly interrupting the document flow. Material for MkDocs provides several different types of admonitions and allows for the inclusion and nesting of arbitrary content.',
        'type': 'paragraph',
      }),
      dict({
