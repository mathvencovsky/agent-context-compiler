        'level': None,
        'links': list([
        ]),
        'order': 118,
        'page': None,
        'text': 'The parameter frozen is used to emulate the frozen dataclass behaviour. It is used to prevent the field from being assigned a new value after the model is created (immutability).',
        'type': 'paragraph',
      }),
