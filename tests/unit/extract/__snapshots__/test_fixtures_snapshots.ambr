          'Code blocks',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://pygments.org',
            'text': 'Pygments',
          }),
        ]),
        'order': 1,
        'page': None,
        'text': 'Code blocks and examples are an essential part of technical project documentation. Material for MkDocs provides different ways to set up syntax highlighting for code blocks, either during build time using Pygments or during runtime using a JavaScript syntax highlighter.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_0cf83115f3d7',
        'data': dict({
        }),
        'heading_path': list([
          'Code blocks',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 2,
        'page': None,
        'text': 'Configuration',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_f185b8a9d690',
        'data': dict({
        }),
        'heading_path': list([
          'Code blocks',
          'Configuration',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 3,
        'page': None,
        'text': 'This configuration enables syntax highlighting on code blocks and inline code blocks, and allows to include source code directly from other files. Add the following lines to mkdocs.yml:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_ee89816499dc',
        'data': dict({
          'code': '''
            markdown_extensions:
              - pymdownx.highlight:
                  anchor_linenums: true
                  line_spans: __span
                  pygments_lang_class: true
              - pymdownx.inlinehilite
              - pymdownx.snippets
              - pymdownx.superfences
  
          ''',
          'language': 'yaml',
        }),
        'heading_path': list([
          'Code blocks',
