            'text': 'ValueError',
          }),
          dict({
            'href': 'https://fixtures.nina.test/glossary.html#term-exhausted',
            'text': 'exhausted',
          }),
          dict({
            'href': 'https://fixtures.nina.test/library/itertools.html#itertools.zip_longest',
            'text': 'itertools.zip_longest()',
          }),
        ]),
        'order': 130,
        'page': None,
        'text': 'By default, zip() stops when the shortest iterable is exhausted. It will ignore the remaining items in the longer iterables, cutting off the result to the length of the shortest iterable: zip() is often used in cases where the iterables are assumed to be of equal length. In such cases, it’s recommended to use the strict=True option. Its output is the same as regular zip(): Unlike the default behavior, it raises a ValueError if one iterable is exhausted before the others: Without the strict=True argument, any bug that results in iterables of different lengths will be silenced, possibly manifesting as a hard-to-find bug in another part of the program. Shorter iterables can be padded with a constant value to make all the iterables have the same length. This is done by itertools.zip_longest().',
        'type': 'list',
      }),
      dict({
        'block_id': 'b_d1de781a4f45',
        'data': dict({
          'code': '''
            >>> list(zip(range(3), ['fee', 'fi', 'fo', 'fum']))
            [(0, 'fee'), (1, 'fi'), (2, 'fo')]
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'Built-in functions',
