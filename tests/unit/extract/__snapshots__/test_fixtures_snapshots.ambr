        'data': dict({
          'items': list([
            dict({
              'definition': 'Convert an integer number to a binary string prefixed with “0b”. The result is a valid Python expression. If integer is not a Python int object, it has to define an __index__() method that returns an integer. Some examples: If the prefix “0b” is desired or not, you can use either of the following ways. See also enum.bin() to represent negative values as twos-complement. See also format() for more information.',
              'term': 'bin(integer, /)',
            }),
          ]),
        }),
