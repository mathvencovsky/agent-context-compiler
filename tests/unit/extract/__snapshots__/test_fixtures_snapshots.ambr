        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.PurePath.full_match',
            'text': 'full_match()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.Path.glob',
            'text': 'glob()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.Path.rglob',
            'text': 'rglob()',
          }),
        ]),
        'order': 207,
        'page': None,
        'text': 'The following wildcards are supported in patterns for full_match(), glob() and rglob():',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_2626c2c320b6',
        'data': dict({
          'items': list([
            dict({
              'definition': 'Matches any number of file or directory segments, including zero.',
              'term': '** (entire segment)',
            }),
            dict({
              'definition': 'Matches one file or directory segment.',
              'term': '* (entire segment)',
            }),
            dict({
              'definition': 'Matches any number of non-separator characters, including zero.',
              'term': '* (part of a segment)',
            }),
            dict({
              'definition': 'Matches one non-separator character.',
              'term': '?',
            }),
            dict({
              'definition': 'Matches one character in seq, where seq is a sequence of characters. Range expressions are supported; for example, [a-z] matches any lowercase ASCII letter. Multiple ranges can be combined: [a-zA-Z0-9_] matches any ASCII letter, digit, or underscore.',
              'term': '[seq]',
            }),
            dict({
              'definition': 'Matches one character not in seq, where seq follows the same rules as above.',
              'term': '[!seq]',
            }),
          ]),
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Pattern language',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 208,
        'page': None,
        'text': '** (entire segment) Matches any number of file or directory segments, including zero. * (entire segment) Matches one file or directory segment. * (part of a segment) Matches any number of non-separator characters, including zero. ? Matches one non-separator character. [seq] Matches one character in seq, where seq is a sequence of characters. Range expressions are supported; for example, [a-z] matches any lowercase ASCII letter. Multiple ranges can be combined: [a-zA-Z0-9_] matches any ASCII letter, digit, or underscore. [!seq] Matches one character not in seq, where seq follows the same rules as above.',
        'type': 'definition_list',
      }),
      dict({
        'block_id': 'b_beb98ae3981f',
        'data': dict({
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Pattern language',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 209,
        'page': None,
        'text': 'For a literal match, wrap the meta-characters in brackets. For example, "[?]" matches the character "?".',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_d842bb317e62',
        'data': dict({
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Pattern language',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 210,
        'page': None,
        'text': 'The “**” wildcard enables recursive globbing. A few examples:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_70123b58a77d',
        'data': dict({
          'caption': None,
          'headers': list([
            'Pattern',
            'Meaning',
          ]),
          'notes': list([
          ]),
          'rows': list([
            list([
              '“**/*”',
              'Any path with at least one segment.',
            ]),
            list([
              '“**/*.py”',
              'Any path with a final segment ending “.py”.',
            ]),
            list([
              '“assets/**”',
              'Any path starting with “assets/”.',
            ]),
            list([
              '“assets/**/*”',
              'Any path starting with “assets/”, excluding “assets/” itself.',
            ]),
          ]),
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Pattern language',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 211,
        'page': None,
        'text': 'Pattern Meaning “**/*” Any path with at least one segment. “**/*.py” Any path with a final segment ending “.py”. “assets/**” Any path starting with “assets/”. “assets/**/*” Any path starting with “assets/”, excluding “assets/” itself.',
        'type': 'table',
      }),
      dict({
        'block_id': 'b_a7d86e41f284',
        'data': dict({
          'kind': 'note',
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Pattern language',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 212,
        'page': None,
        'text': 'Note Globbing with the “**” wildcard visits every directory in the tree. Large directory trees may take a long time to search.',
        'type': 'admonition',
      }),
      dict({
        'block_id': 'b_b641c2f8df3f',
        'data': dict({
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Pattern language',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 213,
        'page': None,
        'text': 'Changed in version 3.13: Globbing with a pattern that ends with “**” returns both files and directories. In previous versions, only directories were returned.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_c60a6064bd89',
        'data': dict({
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Pattern language',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.Path.glob',
            'text': 'Path.glob()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.Path.rglob',
            'text': 'rglob()',
          }),
        ]),
        'order': 214,
        'page': None,
        'text': 'In Path.glob() and rglob(), a trailing slash may be added to the pattern to match only directories.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_7207f7393adc',
        'data': dict({
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Pattern language',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/os.html#os.sep',
            'text': 'sep',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/os.html#os.altsep',
            'text': 'altsep',
          }),
        ]),
        'order': 215,
        'page': None,
        'text': 'Changed in version 3.11: Globbing with a pattern that ends with a pathname components separator (sep or altsep) returns only directories.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_dc97ec7a9e4a',
        'data': dict({
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
        ]),
        'level': 2,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/glob.html#module-glob',
            'text': 'glob',
          }),
        ]),
        'order': 216,
        'page': None,
        'text': 'Comparison to the glob module',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_001f237d65f4',
        'data': dict({
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Comparison to the glob module',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.Path.glob',
            'text': 'Path.glob()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.Path.rglob',
            'text': 'Path.rglob()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/glob.html#module-glob',
            'text': 'glob',
          }),
        ]),
        'order': 217,
        'page': None,
        'text': 'The patterns accepted and results generated by Path.glob() and Path.rglob() differ slightly from those by the glob module:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_5d2fb28d2d37',
        'data': dict({
          'items': list([
            'Files beginning with a dot are not special in pathlib. This is like passing include_hidden=True to glob.glob().',
            '“**” pattern components are always recursive in pathlib. This is like passing recursive=True to glob.glob().',
            '“**” pattern components do not follow symlinks by default in pathlib. This behaviour has no equivalent in glob.glob(), but you can pass recurse_symlinks=True to Path.glob() for compatible behaviour.',
            'Like all PurePath and Path objects, the values returned from Path.glob() and Path.rglob() don’t include trailing slashes.',
            'The values returned from pathlib’s path.glob() and path.rglob() include the path as a prefix, unlike the results of glob.glob(root_dir=path).',
            'The values returned from pathlib’s path.glob() and path.rglob() may include path itself, for example when globbing “**”, whereas the results of glob.glob(root_dir=path) never include an empty string that would correspond to path.',
          ]),
          'ordered': True,
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Comparison to the glob module',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/glob.html#glob.glob',
            'text': 'glob.glob()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/glob.html#glob.glob',
            'text': 'glob.glob()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/glob.html#glob.glob',
            'text': 'glob.glob()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.Path.glob',
            'text': 'Path.glob()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.PurePath',
            'text': 'PurePath',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.Path',
            'text': 'Path',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.Path.glob',
            'text': 'Path.glob()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.Path.rglob',
            'text': 'Path.rglob()',
          }),
        ]),
        'order': 218,
        'page': None,
        'text': 'Files beginning with a dot are not special in pathlib. This is like passing include_hidden=True to glob.glob(). “**” pattern components are always recursive in pathlib. This is like passing recursive=True to glob.glob(). “**” pattern components do not follow symlinks by default in pathlib. This behaviour has no equivalent in glob.glob(), but you can pass recurse_symlinks=True to Path.glob() for compatible behaviour. Like all PurePath and Path objects, the values returned from Path.glob() and Path.rglob() don’t include trailing slashes. The values returned from pathlib’s path.glob() and path.rglob() include the path as a prefix, unlike the results of glob.glob(root_dir=path). The values returned from pathlib’s path.glob() and path.rglob() may include path itself, for example when globbing “**”, whereas the results of glob.glob(root_dir=path) never include an empty string that would correspond to path.',
        'type': 'list',
      }),
      dict({
        'block_id': 'b_94b23b75f309',
        'data': dict({
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
        ]),
        'level': 2,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/os.html#module-os',
            'text': 'os',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/os.path.html#module-os.path',
            'text': 'os.path',
          }),
        ]),
        'order': 219,
        'page': None,
        'text': 'Comparison to the os and os.path modules',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_fb83c1720d33',
        'data': dict({
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Comparison to the os and os.path modules',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.PurePath',
            'text': 'PurePath',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.Path',
            'text': 'Path',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/os.html#module-os',
            'text': 'os',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/os.path.html#module-os.path',
            'text': 'os.path',
          }),
        ]),
        'order': 220,
        'page': None,
        'text': 'pathlib implements path operations using PurePath and Path objects, and so it’s said to be object-oriented. On the other hand, the os and os.path modules supply functions that work with low-level str and bytes objects, which is a more procedural approach. Some users consider the object-oriented style to be more readable.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_d79221e37592',
        'data': dict({
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Comparison to the os and os.path modules',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/os.html#module-os',
            'text': 'os',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/os.path.html#module-os.path',
            'text': 'os.path',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/os.html#dir-fd',
            'text': 'paths relative to directory descriptors',
          }),
        ]),
        'order': 221,
        'page': None,
        'text': 'Many functions in os and os.path support bytes paths and paths relative to directory descriptors. These features aren’t available in pathlib.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_aa73742c809d',
        'data': dict({
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Comparison to the os and os.path modules',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/os.html#module-os',
            'text': 'os',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/os.path.html#module-os.path',
            'text': 'os.path',
          }),
        ]),
        'order': 222,
        'page': None,
        'text': 'Python’s str and bytes types, and portions of the os and os.path modules, are written in C and are very speedy. pathlib is written in pure Python and is often slower, but rarely slow enough to matter.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_e4f2e440e04b',
        'data': dict({
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Comparison to the os and os.path modules',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/os.path.html#module-os.path',
            'text': 'os.path',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/os.path.html#os.path.abspath',
            'text': 'os.path.abspath()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.Path.absolute',
            'text': 'Path.absolute()',
          }),
        ]),
        'order': 223,
        'page': None,
        'text': 'pathlib’s path normalization is slightly more opinionated and consistent than os.path. For example, whereas os.path.abspath() eliminates “..” segments from a path, which may change its meaning if symlinks are involved, Path.absolute() preserves these segments for greater safety.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_f1f7fc946c4e',
        'data': dict({
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Comparison to the os and os.path modules',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 224,
        'page': None,
        'text': 'pathlib’s path normalization may render it unsuitable for some applications:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_9fcd9670dc33',
        'data': dict({
          'items': list([
            'pathlib normalizes Path("my_folder/") to Path("my_folder"), which changes a path’s meaning when supplied to various operating system APIs and command-line utilities. Specifically, the absence of a trailing separator may allow the path to be resolved as either a file or directory, rather than a directory only.',
            'pathlib normalizes Path("./my_program") to Path("my_program"), which changes a path’s meaning when used as an executable search path, such as in a shell or when spawning a child process. Specifically, the absence of a separator in the path may force it to be looked up in PATH rather than the current directory.',
          ]),
          'ordered': True,
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Comparison to the os and os.path modules',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 225,
        'page': None,
        'text': 'pathlib normalizes Path("my_folder/") to Path("my_folder"), which changes a path’s meaning when supplied to various operating system APIs and command-line utilities. Specifically, the absence of a trailing separator may allow the path to be resolved as either a file or directory, rather than a directory only. pathlib normalizes Path("./my_program") to Path("my_program"), which changes a path’s meaning when used as an executable search path, such as in a shell or when spawning a child process. Specifically, the absence of a separator in the path may force it to be looked up in PATH rather than the current directory.',
        'type': 'list',
      }),
      dict({
        'block_id': 'b_25a45b690921',
        'data': dict({
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Comparison to the os and os.path modules',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/os.path.html#module-os.path',
            'text': 'os.path',
          }),
        ]),
        'order': 226,
        'page': None,
        'text': 'As a consequence of these differences, pathlib is not a drop-in replacement for os.path.',
        'type': 'paragraph',
      }),
