# name: test_fixture_ir_snapshot[httpx_quickstart]
  dict({
    'blocks': list([
      dict({
        'block_id': 'b_156f2a1e379d',
        'data': dict({
        }),
        'heading_path': list([
        ]),
        'level': 1,
        'links': list([
        ]),
        'order': 0,
        'page': None,
        'text': 'QuickStart',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_136ccf16807d',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1,
        'page': None,
        'text': 'First, start by importing HTTPX:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_2372a61ac014',
        'data': dict({
          'code': '''
            >>> import httpx
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 2,
        'page': None,
        'text': '''
          >>> import httpx
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_f83624e2731b',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 3,
        'page': None,
        'text': 'Now, let’s try to get a webpage.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_789730c42651',
        'data': dict({
          'code': '''
            >>> r = httpx.get('https://httpbin.org/get')
            >>> r
            <Response [200 OK]>
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 4,
        'page': None,
        'text': '''
          >>> r = httpx.get('https://httpbin.org/get')
          >>> r
          <Response [200 OK]>
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_f059d79fa90a',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 5,
        'page': None,
        'text': 'Similarly, to make an HTTP POST request:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_567068f9f136',
        'data': dict({
          'code': '''
            >>> r = httpx.post('https://httpbin.org/post', data={'key': 'value'})
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 6,
        'page': None,
        'text': '''
          >>> r = httpx.post('https://httpbin.org/post', data={'key': 'value'})
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_d02f70e25dcc',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 7,
        'page': None,
        'text': 'The PUT, DELETE, HEAD, and OPTIONS requests all follow the same style:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_b9f027957862',
        'data': dict({
          'code': '''
            >>> r = httpx.put('https://httpbin.org/put', data={'key': 'value'})
            >>> r = httpx.delete('https://httpbin.org/delete')
            >>> r = httpx.head('https://httpbin.org/get')
            >>> r = httpx.options('https://httpbin.org/get')
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 8,
        'page': None,
        'text': '''
          >>> r = httpx.put('https://httpbin.org/put', data={'key': 'value'})
          >>> r = httpx.delete('https://httpbin.org/delete')
          >>> r = httpx.head('https://httpbin.org/get')
          >>> r = httpx.options('https://httpbin.org/get')
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_6c84259e21b5',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 9,
        'page': None,
        'text': 'Passing Parameters in URLs',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_486dff8f4823',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Passing Parameters in URLs',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 10,
        'page': None,
        'text': 'To include URL query parameters in the request, use the params keyword:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_6b7e30dfe4fb',
        'data': dict({
          'code': '''
            >>> params = {'key1': 'value1', 'key2': 'value2'}
            >>> r = httpx.get('https://httpbin.org/get', params=params)
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Passing Parameters in URLs',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 11,
        'page': None,
        'text': '''
          >>> params = {'key1': 'value1', 'key2': 'value2'}
          >>> r = httpx.get('https://httpbin.org/get', params=params)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_eb36ca8c1710',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Passing Parameters in URLs',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 12,
        'page': None,
        'text': 'To see how the values get encoding into the URL string, we can inspect the resulting URL that was used to make the request:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_2461222f927a',
        'data': dict({
          'code': '''
            >>> r.url
            URL('https://httpbin.org/get?key2=value2&key1=value1')
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Passing Parameters in URLs',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 13,
        'page': None,
        'text': '''
          >>> r.url
          URL('https://httpbin.org/get?key2=value2&key1=value1')
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_7d72f0b68a18',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Passing Parameters in URLs',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 14,
        'page': None,
        'text': 'You can also pass a list of items as a value:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_1c9f90d29e78',
        'data': dict({
          'code': '''
            >>> params = {'key1': 'value1', 'key2': ['value2', 'value3']}
            >>> r = httpx.get('https://httpbin.org/get', params=params)
            >>> r.url
            URL('https://httpbin.org/get?key1=value1&key2=value2&key2=value3')
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Passing Parameters in URLs',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 15,
        'page': None,
        'text': '''
          >>> params = {'key1': 'value1', 'key2': ['value2', 'value3']}
          >>> r = httpx.get('https://httpbin.org/get', params=params)
          >>> r.url
          URL('https://httpbin.org/get?key1=value1&key2=value2&key2=value3')
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_41fcd25d966b',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 16,
        'page': None,
        'text': 'Response Content',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_3dc73f6c6a56',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Response Content',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 17,
        'page': None,
        'text': 'HTTPX will automatically handle decoding the response content into Unicode text.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_320702b75763',
        'data': dict({
          'code': '''
            >>> r = httpx.get('https://www.example.org/')
            >>> r.text
            '<!doctype html>\n<html>\n<head>\n<title>Example Domain</title>...'
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Response Content',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 18,
        'page': None,
        'text': '''
          >>> r = httpx.get('https://www.example.org/')
          >>> r.text
          '<!doctype html>\n<html>\n<head>\n<title>Example Domain</title>...'
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_8c268b9d2780',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Response Content',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 19,
        'page': None,
        'text': 'You can inspect what encoding will be used to decode the response.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_b4d2463f5cd6',
        'data': dict({
          'code': '''
            >>> r.encoding
            'UTF-8'
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Response Content',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 20,
        'page': None,
        'text': '''
          >>> r.encoding
          'UTF-8'
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_610249e5fa00',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Response Content',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 21,
        'page': None,
        'text': 'In some cases the response may not contain an explicit encoding, in which case HTTPX will attempt to automatically determine an encoding to use.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_eddac1748e53',
        'data': dict({
          'code': '''
            >>> r.encoding
            None
            >>> r.text
            '<!doctype html>\n<html>\n<head>\n<title>Example Domain</title>...'
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Response Content',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 22,
        'page': None,
        'text': '''
          >>> r.encoding
          None
          >>> r.text
          '<!doctype html>\n<html>\n<head>\n<title>Example Domain</title>...'
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_2b229e1c0dc5',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Response Content',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 23,
        'page': None,
        'text': 'If you need to override the standard behaviour and explicitly set the encoding to use, then you can do that too.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_d2b295ede822',
        'data': dict({
          'code': '''
            >>> r.encoding = 'ISO-8859-1'
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Response Content',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 24,
        'page': None,
        'text': '''
          >>> r.encoding = 'ISO-8859-1'
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_d8e168396ac1',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 25,
        'page': None,
        'text': 'Binary Response Content',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_5d1abead8648',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Binary Response Content',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 26,
        'page': None,
        'text': 'The response content can also be accessed as bytes, for non-text responses:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_1ad822d1f6bb',
        'data': dict({
          'code': '''
            >>> r.content
            b'<!doctype html>\n<html>\n<head>\n<title>Example Domain</title>...'
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Binary Response Content',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 27,
        'page': None,
        'text': '''
          >>> r.content
          b'<!doctype html>\n<html>\n<head>\n<title>Example Domain</title>...'
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_6db54541c190',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Binary Response Content',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 28,
        'page': None,
        'text': 'Any gzip and deflate HTTP response encodings will automatically be decoded for you. If brotlipy is installed, then the brotli response encoding will be supported. If zstandard is installed, then zstd response encodings will also be supported.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_2f268424f26d',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Binary Response Content',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 29,
        'page': None,
        'text': 'For example, to create an image from binary data returned by a request, you can use the following code:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_59af44d31afc',
        'data': dict({
          'code': '''
            >>> from PIL import Image
            >>> from io import BytesIO
            >>> i = Image.open(BytesIO(r.content))
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Binary Response Content',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 30,
        'page': None,
        'text': '''
          >>> from PIL import Image
          >>> from io import BytesIO
          >>> i = Image.open(BytesIO(r.content))
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_3e16a738c38c',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 31,
        'page': None,
        'text': 'JSON Response Content',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_93f74a95547f',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'JSON Response Content',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 32,
        'page': None,
        'text': 'Often Web API responses will be encoded as JSON.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_ff70ba8dd897',
        'data': dict({
          'code': '''
            >>> r = httpx.get('https://api.github.com/events')
            >>> r.json()
            [{u'repository': {u'open_issues': 0, u'url': 'https://github.com/...' ...  }}]
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'JSON Response Content',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 33,
        'page': None,
        'text': '''
          >>> r = httpx.get('https://api.github.com/events')
          >>> r.json()
          [{u'repository': {u'open_issues': 0, u'url': 'https://github.com/...' ...  }}]
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_22a1212708c5',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 34,
        'page': None,
        'text': 'Custom Headers',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_823b0297373e',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Custom Headers',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 35,
        'page': None,
        'text': 'To include additional headers in the outgoing request, use the headers keyword argument:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_73bf0ac7a61e',
        'data': dict({
          'code': '''
            >>> url = 'https://httpbin.org/headers'
            >>> headers = {'user-agent': 'my-app/0.0.1'}
            >>> r = httpx.get(url, headers=headers)
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Custom Headers',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 36,
        'page': None,
        'text': '''
          >>> url = 'https://httpbin.org/headers'
          >>> headers = {'user-agent': 'my-app/0.0.1'}
          >>> r = httpx.get(url, headers=headers)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_dfbed02b7e42',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 37,
        'page': None,
        'text': 'Sending Form Encoded Data',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_5f72723e1dce',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Sending Form Encoded Data',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 38,
        'page': None,
        'text': 'Some types of HTTP requests, such as POST and PUT requests, can include data in the request body. One common way of including that is as form-encoded data, which is used for HTML forms.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_b51c0e864e2a',
        'data': dict({
          'code': '''
            >>> data = {'key1': 'value1', 'key2': 'value2'}
            >>> r = httpx.post("https://httpbin.org/post", data=data)
            >>> print(r.text)
            {
              ...
              "form": {
                "key2": "value2",
                "key1": "value1"
              },
              ...
            }
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Sending Form Encoded Data',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 39,
        'page': None,
        'text': '''
          >>> data = {'key1': 'value1', 'key2': 'value2'}
          >>> r = httpx.post("https://httpbin.org/post", data=data)
          >>> print(r.text)
          {
            ...
            "form": {
              "key2": "value2",
              "key1": "value1"
            },
            ...
          }
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_88fa897cd736',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Sending Form Encoded Data',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 40,
        'page': None,
        'text': 'Form encoded data can also include multiple values from a given key.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_1952308552ab',
        'data': dict({
          'code': '''
            >>> data = {'key1': ['value1', 'value2']}
            >>> r = httpx.post("https://httpbin.org/post", data=data)
            >>> print(r.text)
            {
              ...
              "form": {
                "key1": [
                  "value1",
                  "value2"
                ]
              },
              ...
            }
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Sending Form Encoded Data',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 41,
        'page': None,
        'text': '''
          >>> data = {'key1': ['value1', 'value2']}
          >>> r = httpx.post("https://httpbin.org/post", data=data)
          >>> print(r.text)
          {
            ...
            "form": {
              "key1": [
                "value1",
                "value2"
              ]
            },
            ...
          }
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_af065ad7570d',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 42,
        'page': None,
        'text': 'Sending Multipart File Uploads',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_c7ac41be7fa5',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Sending Multipart File Uploads',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 43,
        'page': None,
        'text': 'You can also upload files, using HTTP multipart encoding:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_68cb21e5d947',
        'data': dict({
          'code': '''
            >>> with open('report.xls', 'rb') as report_file:
            ...     files = {'upload-file': report_file}
            ...     r = httpx.post("https://httpbin.org/post", files=files)
            >>> print(r.text)
            {
              ...
              "files": {
                "upload-file": "<... binary content ...>"
              },
              ...
            }
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Sending Multipart File Uploads',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 44,
        'page': None,
        'text': '''
          >>> with open('report.xls', 'rb') as report_file:
          ...     files = {'upload-file': report_file}
          ...     r = httpx.post("https://httpbin.org/post", files=files)
          >>> print(r.text)
          {
            ...
            "files": {
              "upload-file": "<... binary content ...>"
            },
            ...
          }
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_379482a6328d',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Sending Multipart File Uploads',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 45,
        'page': None,
        'text': 'You can also explicitly set the filename and content type, by using a tuple of items for the file value:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_a886d555c6aa',
        'data': dict({
          'code': '''
            >>> with open('report.xls', 'rb') report_file:
            ...     files = {'upload-file': ('report.xls', report_file, 'application/vnd.ms-excel')}
            ...     r = httpx.post("https://httpbin.org/post", files=files)
            >>> print(r.text)
            {
              ...
              "files": {
                "upload-file": "<... binary content ...>"
              },
              ...
            }
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Sending Multipart File Uploads',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 46,
        'page': None,
        'text': '''
          >>> with open('report.xls', 'rb') report_file:
          ...     files = {'upload-file': ('report.xls', report_file, 'application/vnd.ms-excel')}
          ...     r = httpx.post("https://httpbin.org/post", files=files)
          >>> print(r.text)
          {
            ...
            "files": {
              "upload-file": "<... binary content ...>"
            },
            ...
          }
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_1e745dfdfe39',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Sending Multipart File Uploads',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 47,
        'page': None,
        'text': 'If you need to include non-file data fields in the multipart form, use the data=... parameter:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_76b846adee11',
        'data': dict({
          'code': '''
            >>> data = {'message': 'Hello, world!'}
            >>> with open('report.xls', 'rb') as report_file:
            ...     files = {'file': report_file}
            ...     r = httpx.post("https://httpbin.org/post", data=data, files=files)
            >>> print(r.text)
            {
              ...
              "files": {
                "file": "<... binary content ...>"
              },
              "form": {
                "message": "Hello, world!",
              },
              ...
            }
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Sending Multipart File Uploads',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 48,
        'page': None,
        'text': '''
          >>> data = {'message': 'Hello, world!'}
          >>> with open('report.xls', 'rb') as report_file:
          ...     files = {'file': report_file}
          ...     r = httpx.post("https://httpbin.org/post", data=data, files=files)
          >>> print(r.text)
          {
            ...
            "files": {
              "file": "<... binary content ...>"
            },
            "form": {
              "message": "Hello, world!",
            },
            ...
          }
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_d345aedf23f0',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 49,
        'page': None,
        'text': 'Sending JSON Encoded Data',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_5584ae21b3d3',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Sending JSON Encoded Data',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 50,
        'page': None,
        'text': "Form encoded data is okay if all you need is a simple key-value data structure. For more complicated data structures you'll often want to use JSON encoding instead.",
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_a56a5f8e5de9',
        'data': dict({
          'code': '''
            >>> data = {'integer': 123, 'boolean': True, 'list': ['a', 'b', 'c']}
            >>> r = httpx.post("https://httpbin.org/post", json=data)
            >>> print(r.text)
            {
              ...
              "json": {
                "boolean": true,
                "integer": 123,
                "list": [
                  "a",
                  "b",
                  "c"
                ]
              },
              ...
            }
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Sending JSON Encoded Data',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 51,
        'page': None,
        'text': '''
          >>> data = {'integer': 123, 'boolean': True, 'list': ['a', 'b', 'c']}
          >>> r = httpx.post("https://httpbin.org/post", json=data)
          >>> print(r.text)
          {
            ...
            "json": {
              "boolean": true,
              "integer": 123,
              "list": [
                "a",
                "b",
                "c"
              ]
            },
            ...
          }
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_a9bc237bd954',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 52,
        'page': None,
        'text': 'Sending Binary Request Data',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_8703b7b8f9e5',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Sending Binary Request Data',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 53,
        'page': None,
        'text': 'For other encodings, you should use the content=... parameter, passing either a bytes type or a generator that yields bytes.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_a1d2ae12c9f0',
        'data': dict({
          'code': '''
            >>> content = b'Hello, world'
            >>> r = httpx.post("https://httpbin.org/post", content=content)
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Sending Binary Request Data',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 54,
        'page': None,
        'text': '''
          >>> content = b'Hello, world'
          >>> r = httpx.post("https://httpbin.org/post", content=content)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_9ba5342f47db',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Sending Binary Request Data',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 55,
        'page': None,
        'text': 'You may also want to set a custom Content-Type header when uploading binary data.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_8d379416bd65',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 56,
        'page': None,
        'text': 'Response Status Codes',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_c7ad63b95784',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Response Status Codes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 57,
        'page': None,
        'text': 'We can inspect the HTTP status code of the response:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_f8987ba6447c',
        'data': dict({
          'code': '''
            >>> r = httpx.get('https://httpbin.org/get')
            >>> r.status_code
            200
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Response Status Codes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 58,
        'page': None,
        'text': '''
          >>> r = httpx.get('https://httpbin.org/get')
          >>> r.status_code
          200
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_c48b31f01787',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Response Status Codes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 59,
        'page': None,
        'text': 'HTTPX also includes an easy shortcut for accessing status codes by their text phrase.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_347cdd0e6af3',
        'data': dict({
          'code': '''
            >>> r.status_code == httpx.codes.OK
            True
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Response Status Codes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 60,
        'page': None,
        'text': '''
          >>> r.status_code == httpx.codes.OK
          True
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_2627e77665f4',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Response Status Codes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 61,
        'page': None,
        'text': 'We can raise an exception for any responses which are not a 2xx success code:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_0c07f288c050',
        'data': dict({
          'code': '''
            >>> not_found = httpx.get('https://httpbin.org/status/404')
            >>> not_found.status_code
            404
            >>> not_found.raise_for_status()
            Traceback (most recent call last):
              File "/Users/tomchristie/GitHub/encode/httpcore/httpx/models.py", line 837, in raise_for_status
                raise HTTPStatusError(message, response=self)
            httpx._exceptions.HTTPStatusError: 404 Client Error: Not Found for url: https://httpbin.org/status/404
            For more information check: https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/404
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Response Status Codes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 62,
        'page': None,
        'text': '''
          >>> not_found = httpx.get('https://httpbin.org/status/404')
          >>> not_found.status_code
          404
          >>> not_found.raise_for_status()
          Traceback (most recent call last):
            File "/Users/tomchristie/GitHub/encode/httpcore/httpx/models.py", line 837, in raise_for_status
              raise HTTPStatusError(message, response=self)
          httpx._exceptions.HTTPStatusError: 404 Client Error: Not Found for url: https://httpbin.org/status/404
          For more information check: https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/404
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_242a5bf762ff',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Response Status Codes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 63,
        'page': None,
        'text': 'Any successful response codes will return the Response instance rather than raising an exception.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_a68440257a9a',
        'data': dict({
          'code': '''
            >>> r.raise_for_status()
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Response Status Codes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 64,
        'page': None,
        'text': '''
          >>> r.raise_for_status()
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_7ad67ef1e1c2',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Response Status Codes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 65,
        'page': None,
        'text': 'The method returns the response instance, allowing you to use it inline. For example:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_9c4404e859c2',
        'data': dict({
          'code': '''
            >>> r = httpx.get('...').raise_for_status()
            >>> data = httpx.get('...').raise_for_status().json()
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Response Status Codes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 66,
        'page': None,
        'text': '''
          >>> r = httpx.get('...').raise_for_status()
          >>> data = httpx.get('...').raise_for_status().json()
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_1566f1da4f9b',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 67,
        'page': None,
        'text': 'Response Headers',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_b9fe6cb0fac8',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Response Headers',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 68,
        'page': None,
        'text': 'The response headers are available as a dictionary-like interface.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_4fea2c880fd2',
        'data': dict({
          'code': '''
            >>> r.headers
            Headers({
                'content-encoding': 'gzip',
                'transfer-encoding': 'chunked',
                'connection': 'close',
                'server': 'nginx/1.0.4',
                'x-runtime': '148ms',
                'etag': '"e1ca502697e5c9317743dc078f67693f"',
                'content-type': 'application/json'
            })
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Response Headers',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 69,
        'page': None,
        'text': '''
          >>> r.headers
          Headers({
              'content-encoding': 'gzip',
              'transfer-encoding': 'chunked',
              'connection': 'close',
              'server': 'nginx/1.0.4',
              'x-runtime': '148ms',
              'etag': '"e1ca502697e5c9317743dc078f67693f"',
              'content-type': 'application/json'
          })
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_86d116ed253c',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Response Headers',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 70,
        'page': None,
        'text': 'The Headers data type is case-insensitive, so you can use any capitalization.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_3a14bc5b2ec2',
        'data': dict({
          'code': '''
            >>> r.headers['Content-Type']
            'application/json'
            
            >>> r.headers.get('content-type')
            'application/json'
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Response Headers',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 71,
        'page': None,
        'text': '''
          >>> r.headers['Content-Type']
          'application/json'
          
          >>> r.headers.get('content-type')
          'application/json'
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_d40619d791fd',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Response Headers',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://tools.ietf.org/html/rfc7230#section-3.2',
            'text': 'RFC 7230',
          }),
        ]),
        'order': 72,
        'page': None,
        'text': 'Multiple values for a single response header are represented as a single comma-separated value, as per RFC 7230:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_c4bb5bd3b4bf',
        'data': dict({
          'text': 'A recipient MAY combine multiple header fields with the same field name into one “field-name: field-value” pair, without changing the semantics of the message, by appending each subsequent field-value to the combined field value in order, separated by a comma.',
        }),
        'heading_path': list([
          'QuickStart',
          'Response Headers',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 73,
        'page': None,
        'text': 'A recipient MAY combine multiple header fields with the same field name into one “field-name: field-value” pair, without changing the semantics of the message, by appending each subsequent field-value to the combined field value in order, separated by a comma.',
        'type': 'blockquote',
      }),
      dict({
        'block_id': 'b_ea7fe1deeddf',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 74,
        'page': None,
        'text': 'Streaming Responses',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_916064308bcf',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Streaming Responses',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 75,
        'page': None,
        'text': 'For large downloads you may want to use streaming responses that do not load the entire response body into memory at once.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_0f2adc8ebee7',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Streaming Responses',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 76,
        'page': None,
        'text': 'You can stream the binary content of the response...',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_35b9060ff3fc',
        'data': dict({
          'code': '''
            >>> with httpx.stream("GET", "https://www.example.com") as r:
            ...     for data in r.iter_bytes():
            ...         print(data)
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Streaming Responses',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 77,
        'page': None,
        'text': '''
          >>> with httpx.stream("GET", "https://www.example.com") as r:
          ...     for data in r.iter_bytes():
          ...         print(data)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_aaa2dc3d54db',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Streaming Responses',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 78,
        'page': None,
        'text': 'Or the text of the response...',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_f4a61d01f6b0',
        'data': dict({
          'code': '''
            >>> with httpx.stream("GET", "https://www.example.com") as r:
            ...     for text in r.iter_text():
            ...         print(text)
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Streaming Responses',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 79,
        'page': None,
        'text': '''
          >>> with httpx.stream("GET", "https://www.example.com") as r:
          ...     for text in r.iter_text():
          ...         print(text)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_c160bc382611',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Streaming Responses',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 80,
        'page': None,
        'text': 'Or stream the text, on a line-by-line basis...',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_c4678e91ccfc',
        'data': dict({
          'code': '''
            >>> with httpx.stream("GET", "https://www.example.com") as r:
            ...     for line in r.iter_lines():
            ...         print(line)
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Streaming Responses',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 81,
        'page': None,
        'text': '''
          >>> with httpx.stream("GET", "https://www.example.com") as r:
          ...     for line in r.iter_lines():
          ...         print(line)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_2f0f00da9055',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Streaming Responses',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 82,
        'page': None,
        'text': 'HTTPX will use universal line endings, normalising all cases to \\n.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_6e8dd975c054',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Streaming Responses',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 83,
        'page': None,
        'text': 'In some cases you might want to access the raw bytes on the response without applying any HTTP content decoding. In this case any content encoding that the web server has applied such as gzip, deflate, brotli, or zstd will not be automatically decoded.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_5d11b103ce0e',
        'data': dict({
          'code': '''
            >>> with httpx.stream("GET", "https://www.example.com") as r:
            ...     for chunk in r.iter_raw():
            ...         print(chunk)
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Streaming Responses',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 84,
        'page': None,
        'text': '''
          >>> with httpx.stream("GET", "https://www.example.com") as r:
          ...     for chunk in r.iter_raw():
          ...         print(chunk)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_48ba25d56db7',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Streaming Responses',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 85,
        'page': None,
        'text': "If you're using streaming responses in any of these ways then the response.content and response.text attributes will not be available, and will raise errors if accessed. However you can also use the response streaming functionality to conditionally load the response body:",
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_00ddc2720f2e',
        'data': dict({
          'code': '''
            >>> with httpx.stream("GET", "https://www.example.com") as r:
            ...     if int(r.headers['Content-Length']) < TOO_LONG:
            ...         r.read()
            ...         print(r.text)
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Streaming Responses',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 86,
        'page': None,
        'text': '''
          >>> with httpx.stream("GET", "https://www.example.com") as r:
          ...     if int(r.headers['Content-Length']) < TOO_LONG:
          ...         r.read()
          ...         print(r.text)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_3dee66926d01',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 87,
        'page': None,
        'text': 'Cookies',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_c8d1a243ff40',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Cookies',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 88,
        'page': None,
        'text': 'Any cookies that are set on the response can be easily accessed:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_7c45b1670711',
        'data': dict({
          'code': '''
            >>> r = httpx.get('https://httpbin.org/cookies/set?chocolate=chip')
            >>> r.cookies['chocolate']
            'chip'
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Cookies',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 89,
        'page': None,
        'text': '''
          >>> r = httpx.get('https://httpbin.org/cookies/set?chocolate=chip')
          >>> r.cookies['chocolate']
          'chip'
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_4a7209b4b88f',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Cookies',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 90,
        'page': None,
        'text': 'To include cookies in an outgoing request, use the cookies parameter:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_4b0422d7b5dc',
        'data': dict({
          'code': '''
            >>> cookies = {"peanut": "butter"}
            >>> r = httpx.get('https://httpbin.org/cookies', cookies=cookies)
            >>> r.json()
            {'cookies': {'peanut': 'butter'}}
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Cookies',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 91,
        'page': None,
        'text': '''
          >>> cookies = {"peanut": "butter"}
          >>> r = httpx.get('https://httpbin.org/cookies', cookies=cookies)
          >>> r.json()
          {'cookies': {'peanut': 'butter'}}
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_92be8694cbb6',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Cookies',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 92,
        'page': None,
        'text': 'Cookies are returned in a Cookies instance, which is a dict-like data structure with additional API for accessing cookies by their domain or path.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_cbde2846f49e',
        'data': dict({
          'code': '''
            >>> cookies = httpx.Cookies()
            >>> cookies.set('cookie_on_domain', 'hello, there!', domain='httpbin.org')
            >>> cookies.set('cookie_off_domain', 'nope.', domain='example.org')
            >>> r = httpx.get('http://httpbin.org/cookies', cookies=cookies)
            >>> r.json()
            {'cookies': {'cookie_on_domain': 'hello, there!'}}
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Cookies',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 93,
        'page': None,
        'text': '''
          >>> cookies = httpx.Cookies()
          >>> cookies.set('cookie_on_domain', 'hello, there!', domain='httpbin.org')
          >>> cookies.set('cookie_off_domain', 'nope.', domain='example.org')
          >>> r = httpx.get('http://httpbin.org/cookies', cookies=cookies)
          >>> r.json()
          {'cookies': {'cookie_on_domain': 'hello, there!'}}
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_f6b961ccfd1b',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 94,
        'page': None,
        'text': 'Redirection and History',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_afc01946fd2c',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Redirection and History',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 95,
        'page': None,
        'text': 'By default, HTTPX will not follow redirects for all HTTP methods, although this can be explicitly enabled.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_5619b6b5867e',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Redirection and History',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 96,
        'page': None,
        'text': 'For example, GitHub redirects all HTTP requests to HTTPS.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_7f922a77aa35',
        'data': dict({
          'code': '''
            >>> r = httpx.get('http://github.com/')
            >>> r.status_code
            301
            >>> r.history
            []
            >>> r.next_request
            <Request('GET', 'https://github.com/')>
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Redirection and History',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 97,
        'page': None,
        'text': '''
          >>> r = httpx.get('http://github.com/')
          >>> r.status_code
          301
          >>> r.history
          []
          >>> r.next_request
          <Request('GET', 'https://github.com/')>
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_674dc78a0f8b',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Redirection and History',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 98,
        'page': None,
        'text': 'You can modify the default redirection handling with the follow_redirects parameter:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_44b0edbffb93',
        'data': dict({
          'code': '''
            >>> r = httpx.get('http://github.com/', follow_redirects=True)
            >>> r.url
            URL('https://github.com/')
            >>> r.status_code
            200
            >>> r.history
            [<Response [301 Moved Permanently]>]
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Redirection and History',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 99,
        'page': None,
        'text': '''
          >>> r = httpx.get('http://github.com/', follow_redirects=True)
          >>> r.url
          URL('https://github.com/')
          >>> r.status_code
          200
          >>> r.history
          [<Response [301 Moved Permanently]>]
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_71d85c4630ee',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Redirection and History',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 100,
        'page': None,
        'text': 'The history property of the response can be used to inspect any followed redirects. It contains a list of any redirect responses that were followed, in the order in which they were made.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_9fce0b5e11fa',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 101,
        'page': None,
        'text': 'Timeouts',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_8fccd51a0683',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Timeouts',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 102,
        'page': None,
        'text': 'HTTPX defaults to including reasonable timeouts for all network operations, meaning that if a connection is not properly established then it should always raise an error rather than hanging indefinitely.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_62eed5b8734c',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Timeouts',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 103,
        'page': None,
        'text': 'The default timeout for network inactivity is five seconds. You can modify the value to be more or less strict:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_47eb0e288f52',
        'data': dict({
          'code': '''
            >>> httpx.get('https://github.com/', timeout=0.001)
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Timeouts',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 104,
        'page': None,
        'text': '''
          >>> httpx.get('https://github.com/', timeout=0.001)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_a00519daa380',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Timeouts',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 105,
        'page': None,
        'text': 'You can also disable the timeout behavior completely...',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_481e0ea1d387',
        'data': dict({
          'code': '''
            >>> httpx.get('https://github.com/', timeout=None)
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Timeouts',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 106,
        'page': None,
        'text': '''
          >>> httpx.get('https://github.com/', timeout=None)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_a54ce223be8b',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Timeouts',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/advanced/timeouts/#fine-tuning-the-configuration',
            'text': 'Timeout fine-tuning',
          }),
        ]),
        'order': 107,
        'page': None,
        'text': 'For advanced timeout management, see Timeout fine-tuning.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_05bc83fdc1a8',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 108,
        'page': None,
        'text': 'Authentication',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_5070bc1e48b1',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Authentication',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 109,
        'page': None,
        'text': 'HTTPX supports Basic and Digest HTTP authentication.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_bc14184e54a0',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Authentication',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 110,
        'page': None,
        'text': 'To provide Basic authentication credentials, pass a 2-tuple of plaintext str or bytes objects as the auth argument to the request functions:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_c9fe0f1b12e7',
        'data': dict({
          'code': '''
            >>> httpx.get("https://example.com", auth=("my_user", "password123"))
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Authentication',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 111,
        'page': None,
        'text': '''
          >>> httpx.get("https://example.com", auth=("my_user", "password123"))
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_be0841d3265f',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Authentication',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 112,
        'page': None,
        'text': "To provide credentials for Digest authentication you'll need to instantiate a DigestAuth object with the plaintext username and password as arguments. This object can be then passed as the auth argument to the request methods as above:",
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_45987e8389a7',
        'data': dict({
          'code': '''
            >>> auth = httpx.DigestAuth("my_user", "password123")
            >>> httpx.get("https://example.com", auth=auth)
            <Response [200 OK]>
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Authentication',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 113,
        'page': None,
        'text': '''
          >>> auth = httpx.DigestAuth("my_user", "password123")
          >>> httpx.get("https://example.com", auth=auth)
          <Response [200 OK]>
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_2d4f3906942f',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 114,
        'page': None,
        'text': 'Exceptions',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_3b74cf04b114',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Exceptions',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 115,
        'page': None,
        'text': 'HTTPX will raise exceptions if an error occurs.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_743e81e77ce8',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Exceptions',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 116,
        'page': None,
        'text': 'The most important exception classes in HTTPX are RequestError and HTTPStatusError.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_a95a5a062f1e',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Exceptions',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 117,
        'page': None,
        'text': 'The RequestError class is a superclass that encompasses any exception that occurs while issuing an HTTP request. These exceptions include a .request attribute.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_c8a7d725d0c3',
        'data': dict({
          'code': '''
            try:
                response = httpx.get("https://www.example.com/")
            except httpx.RequestError as exc:
                print(f"An error occurred while requesting {exc.request.url!r}.")
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Exceptions',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 118,
        'page': None,
        'text': '''
          try:
              response = httpx.get("https://www.example.com/")
          except httpx.RequestError as exc:
              print(f"An error occurred while requesting {exc.request.url!r}.")
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_4f92466e691a',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Exceptions',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 119,
        'page': None,
        'text': 'The HTTPStatusError class is raised by response.raise_for_status() on responses which are not a 2xx success code. These exceptions include both a .request and a .response attribute.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_cd307d4d0771',
        'data': dict({
          'code': '''
            response = httpx.get("https://www.example.com/")
            try:
                response.raise_for_status()
            except httpx.HTTPStatusError as exc:
                print(f"Error response {exc.response.status_code} while requesting {exc.request.url!r}.")
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'QuickStart',
          'Exceptions',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 120,
        'page': None,
        'text': '''
          response = httpx.get("https://www.example.com/")
          try:
              response.raise_for_status()
          except httpx.HTTPStatusError as exc:
              print(f"Error response {exc.response.status_code} while requesting {exc.request.url!r}.")
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_a975a2e47b29',
        'data': dict({
        }),
        'heading_path': list([
          'QuickStart',
          'Exceptions',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 121,
        'page': None,
        'text': 'There is also a base class HTTPError that includes both of these categories, and can be used to catch either failed requests, or 4xx and 5xx responses.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_6351be26e94f',
