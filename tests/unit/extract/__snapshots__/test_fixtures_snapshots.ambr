      dict({
        'block_id': 'b_a255ea25aa6e',
        'data': dict({
          'code': '''
            class Hello(View):
                init_every_request = False
            
                def dispatch_request(self, name):
                    return f"Hello, {name}!"
            
            app.add_url_rule(
                "/hello/<name>", view_func=Hello.as_view("hello")
            )
  
          ''',
          'language': 'python',
        }),
