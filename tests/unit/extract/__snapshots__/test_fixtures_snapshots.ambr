      dict({
        'block_id': 'b_2b91ec99689b',
        'data': dict({
          'items': list([
            dict({
              'definition': 'To access incoming request data, you can use the global request object. Flask parses incoming request data for you and gives you access to it through that global object. Internally Flask makes sure that you always get the correct data for the active thread if you are in a multithreaded environment. This is a proxy. See Notes On Proxies for more information. The request object is an instance of a Request.',
              'term': 'flask.request',
            }),
          ]),
        }),
        'heading_path': list([
          'API',
          'Incoming Request Data',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/reqcontext/#notes-on-proxies',
            'text': 'Notes On Proxies',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/flask_api_reference.html#flask.Request',
            'text': 'Request',
          }),
        ]),
        'order': 449,
        'page': None,
        'text': 'flask.request To access incoming request data, you can use the global request object. Flask parses incoming request data for you and gives you access to it through that global object. Internally Flask makes sure that you always get the correct data for the active thread if you are in a multithreaded environment. This is a proxy. See Notes On Proxies for more information. The request object is an instance of a Request.',
        'type': 'definition_list',
      }),
