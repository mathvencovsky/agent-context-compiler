          # so mark it as modified yourself
          session.modified = True
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_d41b22e7692e',
        'data': dict({
          'items': list([
            dict({
              'definition': 'If set to True the session lives for permanent_session_lifetime seconds. The default is 31 days. If set to False (which is the default) the session will be deleted when the user closes the browser.',
              'term': 'permanent',
            }),
          ]),
        }),
