          }),
        ]),
        'order': 108,
        'page': None,
        'text': 'When using the model_validate() method, Pydantic can also validate arbitrary objects, by getting attributes on the object corresponding the field names. One common application of this functionality is integration with object-relational mappings (ORMs).',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_3ffc07fc1e51',
        'data': dict({
        }),
