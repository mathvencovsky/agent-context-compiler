      }),
      dict({
        'block_id': 'b_cdf7c301a7dc',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic/fields/#pydantic.fields.Field',
            'text': 'Field()',
          }),
          dict({
            'href': 'https://docs.python.org/3/library/dataclasses.html#dataclasses.field',
            'text': 'field()',
          }),
        ]),
        'order': 4,
        'page': None,
        'text': 'To do so, the Field() function is used a lot, and behaves the same way as the standard library field() function for dataclasses – by assigning to the annotated attribute:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_00654f8bced9',
        'data': dict({
          'code': '''
            from pydantic import BaseModel, Field
            
            
            class Model(BaseModel):
                name: str = Field(frozen=True)
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Fields',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 5,
        'page': None,
        'text': '''
          from pydantic import BaseModel, Field
          
          
          class Model(BaseModel):
              name: str = Field(frozen=True)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_405e9ebd4f1e',
        'data': dict({
          'kind': 'note',
        }),
        'heading_path': list([
          'Fields',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://docs.python.org/3/builtins/constants.html#Ellipsis',
            'text': 'ellipsis',
          }),
        ]),
        'order': 6,
        'page': None,
        'text': 'Note Even though name is assigned a value, it is still required and has no default value. If you want to emphasize on the fact that a value must be provided, you can use the ellipsis: However, its usage is discouraged as it doesn’t play well with static type checkers.',
        'type': 'admonition',
      }),
      dict({
        'block_id': 'b_2d639dc8487d',
        'data': dict({
          'code': '''
            class Model(BaseModel):
                name: str = Field(..., frozen=True)
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
