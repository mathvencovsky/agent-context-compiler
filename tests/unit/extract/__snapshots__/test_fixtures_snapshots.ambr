        'links': list([
        ]),
        'order': 38,
        'page': None,
        'text': 'Data conversion',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_98051fb5b9d7',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Data conversion',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 39,
        'page': None,
        'text': 'Pydantic may cast input data to force it to conform to model field types, and in some cases this may result in a loss of information. For example:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_bd79f35915cd',
        'data': dict({
          'code': '''
            from pydantic import BaseModel
            
            
            class Model(BaseModel):
                a: int
                b: float
                c: str
            
            
            print(Model(a=3.000, b='2.72', c=b'binary data').model_dump())
            #> {'a': 3, 'b': 2.72, 'c': 'binary data'}
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Data conversion',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 40,
        'page': None,
        'text': '''
          from pydantic import BaseModel
          
          
          class Model(BaseModel):
              a: int
              b: float
              c: str
          
          
          print(Model(a=3.000, b='2.72', c=b'binary data').model_dump())
          #> {'a': 3, 'b': 2.72, 'c': 'binary data'}
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_1463fd352343',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Data conversion',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://github.com/pydantic/pydantic/issues/578',
            'text': 'this issue',
          }),
        ]),
        'order': 41,
        'page': None,
        'text': 'This is a deliberate decision of Pydantic, and is frequently the most useful approach. See this issue for a longer discussion on the subject.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_b400a5dfbc07',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Data conversion',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/concepts/strict_mode/',
            'text': 'strict mode',
          }),
        ]),
        'order': 42,
        'page': None,
        'text': 'Nevertheless, Pydantic provides a strict mode, where no data conversion is performed. Values must be of the same type as the declared field type.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_10435938fc48',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Data conversion',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://docs.python.org/3/glossary.html#term-list',
            'text': 'list',
          }),
        ]),
        'order': 43,
        'page': None,
        'text': 'This is also the case for collections. In most cases, you shouldn’t make use of abstract container classes and just use a concrete type, such as list:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_ba1e7f458426',
        'data': dict({
          'code': '''
            from pydantic import BaseModel
            
            
            class Model(BaseModel):
                items: list[int]  # (1)
            
            
            print(Model(items=(1, 2, 3)))
            #> items=[1, 2, 3]
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Data conversion',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 44,
        'page': None,
        'text': '''
          from pydantic import BaseModel
          
          
          class Model(BaseModel):
              items: list[int]  # (1)
          
          
          print(Model(items=(1, 2, 3)))
          #> items=[1, 2, 3]
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_89914cda94af',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Data conversion',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://docs.python.org/3/library/collections.abc.html#collections.abc.Sequence',
            'text': 'Sequence',
          }),
        ]),
        'order': 45,
        'page': None,
        'text': "In this case, you might be tempted to use the abstract Sequence type to allow both lists and tuples. But Pydantic takes care of converting the tuple input to a list, so in most cases this isn't necessary.",
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_f1b32cd7d5c5',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Data conversion',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/concepts/performance/#sequence-vs-list-or-tuple-with-mapping-vs-dict',
            'text': 'poor validation performance',
          }),
        ]),
        'order': 46,
        'page': None,
        'text': 'Besides, using these abstract types can also lead to poor validation performance, and in general using concrete container types will avoid unnecessary checks.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_c0c8a2da1f20',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 47,
        'page': None,
        'text': 'Extra data',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_ed302a9bfaef',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Extra data',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 48,
        'page': None,
        'text': 'By default, Pydantic models won’t error when you provide extra data, and these values will simply be ignored:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_29212acce731',
        'data': dict({
          'code': '''
            from pydantic import BaseModel
            
            
            class Model(BaseModel):
                x: int
            
            
            m = Model(x=1, y='a')
            assert m.model_dump() == {'x': 1}
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Extra data',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 49,
        'page': None,
        'text': '''
          from pydantic import BaseModel
          
          
          class Model(BaseModel):
              x: int
          
          
          m = Model(x=1, y='a')
          assert m.model_dump() == {'x': 1}
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_235e7af4a843',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Extra data',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic/config/#pydantic.config.ConfigDict.extra',
            'text': 'extra',
          }),
        ]),
        'order': 50,
        'page': None,
        'text': 'The extra configuration value can be used to control this behavior:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_c2ba5fa8b0bd',
        'data': dict({
          'code': '''
            from pydantic import BaseModel, ConfigDict
            
            
            class Model(BaseModel):
                x: int
            
                model_config = ConfigDict(extra='allow')
            
            
            m = Model(x=1, y='a')  # (1)
            assert m.model_dump() == {'x': 1, 'y': 'a'}
            assert m.__pydantic_extra__ == {'y': 'a'}
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Extra data',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 51,
        'page': None,
        'text': '''
          from pydantic import BaseModel, ConfigDict
          
          
          class Model(BaseModel):
              x: int
          
              model_config = ConfigDict(extra='allow')
          
          
          m = Model(x=1, y='a')  # (1)
          assert m.model_dump() == {'x': 1, 'y': 'a'}
          assert m.__pydantic_extra__ == {'y': 'a'}
        ''',
