          'Breaking Changes - Fixes',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://github.com/tiangolo/fastapi/pull/2725',
            'text': '#2725',
          }),
          dict({
            'href': 'https://github.com/hukkin',
            'text': '@hukkin',
          }),
        ]),
        'order': 1352,
        'page': None,
        'text': '🐛 Fix response_model not invalidating None. PR #2725 by @hukkin.',
        'type': 'list',
      }),
      dict({
        'block_id': 'b_8b4f60f67459',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.80.0 (2022-08-23)',
          'Breaking Changes - Fixes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1353,
        'page': None,
        'text': "If you are using response_model with some type that doesn't include None but the function is returning None, it will now raise an internal server error, because you are returning invalid data that violates the contract in response_model. Before this release it would allow breaking that contract returning None.",
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_fcc765a342eb',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.80.0 (2022-08-23)',
          'Breaking Changes - Fixes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1354,
        'page': None,
        'text': 'For example, if you have an app like this:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_f0aa73a4ae1b',
        'data': dict({
          'code': '''
            from fastapi import FastAPI
            from pydantic import BaseModel
            
            class Item(BaseModel):
                name: str
                price: Optional[float] = None
                owner_ids: Optional[List[int]] = None
            
            app = FastAPI()
            
            @app.get("/items/invalidnone", response_model=Item)
            def get_invalid_none():
                return None
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'Release Notes',
          '0.80.0 (2022-08-23)',
          'Breaking Changes - Fixes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1355,
        'page': None,
        'text': '''
          from fastapi import FastAPI
          from pydantic import BaseModel
          
          class Item(BaseModel):
              name: str
              price: Optional[float] = None
              owner_ids: Optional[List[int]] = None
          
          app = FastAPI()
          
          @app.get("/items/invalidnone", response_model=Item)
          def get_invalid_none():
              return None
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_866336e0f058',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.80.0 (2022-08-23)',
          'Breaking Changes - Fixes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1356,
        'page': None,
        'text': '...calling the path /items/invalidnone will raise an error, because None is not a valid type for the response_model declared with Item.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_28e69996d22d',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.80.0 (2022-08-23)',
          'Breaking Changes - Fixes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1357,
        'page': None,
        'text': 'You could also be implicitly returning None without realizing, for example:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_1a184867e6bf',
        'data': dict({
          'code': '''
            from fastapi import FastAPI
            from pydantic import BaseModel
            
            class Item(BaseModel):
                name: str
                price: Optional[float] = None
                owner_ids: Optional[List[int]] = None
            
            app = FastAPI()
            
            @app.get("/items/invalidnone", response_model=Item)
            def get_invalid_none():
                if flag:
                    return {"name": "foo"}
                # if flag is False, at this point the function will implicitly return None
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'Release Notes',
          '0.80.0 (2022-08-23)',
          'Breaking Changes - Fixes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1358,
        'page': None,
        'text': '''
          from fastapi import FastAPI
          from pydantic import BaseModel
          
          class Item(BaseModel):
              name: str
              price: Optional[float] = None
              owner_ids: Optional[List[int]] = None
          
          app = FastAPI()
          
          @app.get("/items/invalidnone", response_model=Item)
          def get_invalid_none():
              if flag:
                  return {"name": "foo"}
              # if flag is False, at this point the function will implicitly return None
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_8366bd09289f',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.80.0 (2022-08-23)',
          'Breaking Changes - Fixes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1359,
        'page': None,
        'text': 'If you have path operations using response_model that need to be allowed to return None, make it explicit in response_model using Union[Something, None]:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_538744d5a26f',
        'data': dict({
          'code': '''
            from typing import Union
            
            from fastapi import FastAPI
            from pydantic import BaseModel
            
            class Item(BaseModel):
                name: str
                price: Optional[float] = None
                owner_ids: Optional[List[int]] = None
            
            app = FastAPI()
            
            @app.get("/items/invalidnone", response_model=Union[Item, None])
            def get_invalid_none():
                return None
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'Release Notes',
          '0.80.0 (2022-08-23)',
          'Breaking Changes - Fixes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 1360,
        'page': None,
        'text': '''
          from typing import Union
          
          from fastapi import FastAPI
          from pydantic import BaseModel
          
          class Item(BaseModel):
              name: str
              price: Optional[float] = None
              owner_ids: Optional[List[int]] = None
          
          app = FastAPI()
          
          @app.get("/items/invalidnone", response_model=Union[Item, None])
          def get_invalid_none():
              return None
  
        ''',
        'type': 'code',
      }),
