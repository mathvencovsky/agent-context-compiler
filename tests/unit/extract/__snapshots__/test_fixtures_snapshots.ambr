      }),
      dict({
        'block_id': 'b_c24cdcfcbd4e',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(prog='PROG')
            >>> parser.add_argument('foo', nargs='+')
            >>> parser.parse_args(['a', 'b'])
            Namespace(foo=['a', 'b'])
