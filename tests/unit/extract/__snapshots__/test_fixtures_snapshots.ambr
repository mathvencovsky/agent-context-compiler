      dict({
        'block_id': 'b_338d74b313c1',
        'data': dict({
          'code': '''
            >>> sorted(Path('.').glob('*.py'))
            [PosixPath('pathlib.py'), PosixPath('setup.py'), PosixPath('test_pathlib.py')]
