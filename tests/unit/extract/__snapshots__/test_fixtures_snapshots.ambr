        ]),
        'order': 83,
        'page': None,
        'text': 'Even though Pydantic treats alias and validation_alias the same when creating model instances, type checkers only understand the alias field parameter. As a workaround, you can instead specify both an alias and serialization_alias (identical to the field name), as the serialization_alias will override the alias during serialization:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_efbfa4d8fa53',
        'data': dict({
          'code': '''
            from pydantic import BaseModel, Field
            
            
            class MyModel(BaseModel):
                my_field: int = Field(validation_alias='myValidationAlias')
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Fields',
          'Field aliases',
          'Validation Alias',
        ]),
        'level': None,
        'links': list([
        ]),
