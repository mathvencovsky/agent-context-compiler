      dict({
        'block_id': 'b_c30d65d5b24a',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Dynamic model creation',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic/base_model/#pydantic.create_model',
            'text': 'create_model()',
          }),
        ]),
        'order': 176,
        'page': None,
        'text': 'There are some occasions where it is desirable to create a model using runtime information to specify the fields. Pydantic provides the create_model() function to allow models to be created dynamically:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_802cd91c2520',
        'data': dict({
          'code': '''
            from pydantic import BaseModel, create_model
            
            DynamicFoobarModel = create_model('DynamicFoobarModel', foo=str, bar=(int, 123))
            
            # Equivalent to:
            
            
            class StaticFoobarModel(BaseModel):
                foo: str
                bar: int = 123
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
