        'order': 233,
        'page': None,
        'text': 'Model signature',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_dcc07a5fabe3',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Model signature',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 234,
        'page': None,
        'text': 'All Pydantic models will have their signature generated based on their fields:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_bac6343e94b0',
        'data': dict({
          'code': '''
            import inspect
            
            from pydantic import BaseModel, Field
            
            
            class FooModel(BaseModel):
                id: int
                name: str = None
                description: str = 'Foo'
                apple: int = Field(alias='pear')
            
            
            print(inspect.signature(FooModel))
            #> (*, id: int, name: str = None, description: str = 'Foo', pear: int) -> None
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Model signature',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 235,
        'page': None,
        'text': '''
          import inspect
          
          from pydantic import BaseModel, Field
          
          
          class FooModel(BaseModel):
              id: int
              name: str = None
              description: str = 'Foo'
              apple: int = Field(alias='pear')
          
          
          print(inspect.signature(FooModel))
          #> (*, id: int, name: str = None, description: str = 'Foo', pear: int) -> None
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_d120a79f653c',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Model signature',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 236,
        'page': None,
        'text': 'An accurate signature is useful for introspection purposes and libraries like FastAPI or hypothesis.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_4ca616a8ce31',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Model signature',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 237,
        'page': None,
        'text': 'The generated signature will also respect custom __init__ functions:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_dc88919fa095',
        'data': dict({
          'code': '''
            import inspect
            
            from pydantic import BaseModel
            
            
            class MyModel(BaseModel):
                id: int
                info: str = 'Foo'
            
                def __init__(self, id: int = 1, *, bar: str, **data) -> None:
                    """My custom init!"""
                    super().__init__(id=id, bar=bar, **data)
            
            
            print(inspect.signature(MyModel))
            #> (id: int = 1, *, bar: str, info: str = 'Foo') -> None
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Model signature',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 238,
        'page': None,
        'text': '''
          import inspect
          
          from pydantic import BaseModel
          
          
          class MyModel(BaseModel):
              id: int
              info: str = 'Foo'
          
              def __init__(self, id: int = 1, *, bar: str, **data) -> None:
                  """My custom init!"""
                  super().__init__(id=id, bar=bar, **data)
          
          
          print(inspect.signature(MyModel))
          #> (id: int = 1, *, bar: str, info: str = 'Foo') -> None
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_f066b20175d4',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Model signature',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 239,
        'page': None,
        'text': 'To be included in the signature, a field’s alias or name must be a valid Python identifier. Pydantic will prioritize a field’s alias over its name when generating the signature, but may use the field name if the alias is not a valid Python identifier.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_9245b88b7bb5',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Model signature',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 240,
        'page': None,
        'text': "If a field’s alias and name are both not valid identifiers (which may be possible through exotic use of create_model), a **data argument will be added. In addition, the **data argument will always be present in the signature if model_config['extra'] == 'allow'.",
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_d3e372fc7589',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 241,
        'page': None,
        'text': 'Structural pattern matching',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_298a6db804e9',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Structural pattern matching',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://peps.python.org/pep-0636/',
            'text': 'PEP 636',
          }),
        ]),
        'order': 242,
        'page': None,
        'text': 'Pydantic supports structural pattern matching for models, as introduced by PEP 636 in Python 3.10.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_a528c2357460',
        'data': dict({
          'code': '''
            from pydantic import BaseModel
            
            
            class Pet(BaseModel):
                name: str
                species: str
            
            
            a = Pet(name='Bones', species='dog')
            
            match a:
                # match `species` to 'dog', declare and initialize `dog_name`
                case Pet(species='dog', name=dog_name):
                    print(f'{dog_name} is a dog')
            #> Bones is a dog
                # default case
                case _:
                    print('No dog matched')
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Structural pattern matching',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 243,
        'page': None,
        'text': '''
          from pydantic import BaseModel
          
          
          class Pet(BaseModel):
              name: str
              species: str
          
          
          a = Pet(name='Bones', species='dog')
          
          match a:
              # match `species` to 'dog', declare and initialize `dog_name`
              case Pet(species='dog', name=dog_name):
                  print(f'{dog_name} is a dog')
          #> Bones is a dog
              # default case
              case _:
                  print('No dog matched')
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_744742882c34',
        'data': dict({
          'kind': 'note',
        }),
        'heading_path': list([
          'Models',
          'Structural pattern matching',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 244,
        'page': None,
        'text': 'Note A match-case statement may seem as if it creates a new model, but don’t be fooled; it is just syntactic sugar for getting an attribute and either comparing it or declaring and initializing it.',
        'type': 'admonition',
      }),
      dict({
        'block_id': 'b_90e650b98a46',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 245,
        'page': None,
        'text': 'Attribute copies',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_2f05f888f28b',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Attribute copies',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 246,
        'page': None,
        'text': 'In many cases, arguments passed to the constructor will be copied in order to perform validation and, where necessary, coercion.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_aff695c8f64d',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Attribute copies',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 247,
        'page': None,
        'text': 'In this example, note that the ID of the list changes after the class is constructed because it has been copied during validation:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_48891bebabdd',
        'data': dict({
          'code': '''
            from pydantic import BaseModel
            
            
            class C1:
                arr = []
            
                def __init__(self, in_arr):
                    self.arr = in_arr
            
            
            class C2(BaseModel):
                arr: list[int]
            
            
            arr_orig = [1, 9, 10, 3]
            
            
            c1 = C1(arr_orig)
            c2 = C2(arr=arr_orig)
            print(f'{id(c1.arr) == id(c2.arr)=}')
            #> id(c1.arr) == id(c2.arr)=False
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Attribute copies',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 248,
        'page': None,
        'text': '''
          from pydantic import BaseModel
          
          
          class C1:
              arr = []
          
              def __init__(self, in_arr):
                  self.arr = in_arr
          
          
          class C2(BaseModel):
              arr: list[int]
          
          
          arr_orig = [1, 9, 10, 3]
          
          
          c1 = C1(arr_orig)
          c2 = C2(arr=arr_orig)
          print(f'{id(c1.arr) == id(c2.arr)=}')
          #> id(c1.arr) == id(c2.arr)=False
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_f3c97d456467',
        'data': dict({
          'kind': 'note',
        }),
        'heading_path': list([
          'Models',
          'Attribute copies',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic/config/#pydantic.config.ConfigDict.revalidate_instances',
            'text': "model_config['revalidate_instances'] = 'always'",
          }),
        ]),
        'order': 249,
        'page': None,
        'text': "Note There are some situations where Pydantic does not copy attributes, such as when passing models — we use the model as is. You can override this behaviour by setting model_config['revalidate_instances'] = 'always'.",
        'type': 'admonition',
      }),
    ]),
