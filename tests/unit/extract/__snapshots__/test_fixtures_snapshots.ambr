        'block_id': 'b_a45bc42b5786',
        'data': dict({
          'items': list([
            dict({
              'definition': 'Return True if the object argument appears callable, False if not. If this returns True, it is still possible that a call fails, but if it is False, calling object will never succeed. Note that classes are callable (calling a class returns a new instance); instances are callable if their class has a __call__() method. Added in version 3.2: This function was first removed in Python 3.0 and then brought back in Python 3.2.',
              'term': 'callable(object, /)',
            }),
          ]),
        }),
