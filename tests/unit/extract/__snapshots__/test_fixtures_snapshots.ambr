        'level': None,
        'links': list([
        ]),
        'order': 260,
        'page': None,
        'text': 'Compared with the 1.0 release, there were relatively few backwards incompatible changes, but there are still a few issues to be aware of with this major release.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_881fc8ab999c',
        'data': dict({
        }),
        'heading_path': list([
          'Developer Interface',
          'Migrating to 2.x',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://lukasa.co.uk/2013/09/Requests_20/',
            'text': 'blog',
          }),
        ]),
        'order': 261,
        'page': None,
        'text': 'For more details on the changes in this release including new APIs, links to the relevant GitHub issues and some of the bug fixes, read Cory’s blog on the subject.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_ef8a34709171',
        'data': dict({
        }),
        'heading_path': list([
          'Developer Interface',
          'Migrating to 2.x',
