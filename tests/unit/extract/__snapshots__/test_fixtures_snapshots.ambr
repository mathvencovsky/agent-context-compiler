          'items': list([
            dict({
              'definition': 'Return zero-based index of the first occurrence of value in the list. Raises a ValueError if there is no such item. The optional arguments start and end are interpreted as in the slice notation and are used to limit the search to a particular subsequence of the list. The returned index is computed relative to the beginning of the full sequence rather than the start argument.',
              'term': 'list.index(value[, start[, stop]])',
            }),
          ]),
        }),
