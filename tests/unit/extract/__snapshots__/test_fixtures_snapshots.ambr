        'text': 'format_usage() Action subclasses can define a format_usage() method that takes no argument and return a string which will be used when printing the usage of the program. If such method is not provided, a sensible default will be used.',
        'type': 'definition_list',
      }),
      dict({
        'block_id': 'b_36fcfd15c4fa',
        'data': dict({
          'items': list([
            dict({
              'definition': 'A subclass of Action for handling boolean flags with positive and negative options. Adding a single argument such as --foo automatically creates both --foo and --no-foo options, storing True and False respectively: Single-dash long options are also supported. For example, negative option -nofoo is automatically added for positive option -foo. But no additional options are added for short options such as -f. Added in version 3.9. Changed in version 3.15: Added support for single-dash options. Added support for alternate prefix_chars.',
              'term': 'class argparse.BooleanOptionalAction',
            }),
          ]),
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'Action classes',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.Action',
            'text': 'Action',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#prefix-chars',
            'text': 'prefix_chars',
          }),
        ]),
        'order': 225,
        'page': None,
        'text': 'class argparse.BooleanOptionalAction A subclass of Action for handling boolean flags with positive and negative options. Adding a single argument such as --foo automatically creates both --foo and --no-foo options, storing True and False respectively: Single-dash long options are also supported. For example, negative option -nofoo is automatically added for positive option -foo. But no additional options are added for short options such as -f. Added in version 3.9. Changed in version 3.15: Added support for single-dash options. Added support for alternate prefix_chars.',
        'type': 'definition_list',
      }),
      dict({
        'block_id': 'b_ac920e9b76e3',
        'data': dict({
          'code': '''
            >>> import argparse
            >>> parser = argparse.ArgumentParser()
            >>> parser.add_argument('--foo', action=argparse.BooleanOptionalAction)
            >>> parser.parse_args(['--no-foo'])
            Namespace(foo=False)
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'Action classes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 226,
