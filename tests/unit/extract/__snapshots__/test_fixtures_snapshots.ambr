            'text': 'extra data',
          }),
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic/base_model/#pydantic.BaseModel.model_construct',
            'text': 'model_construct()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic/config/#pydantic.config.ConfigDict.extra',
            'text': 'extra',
