        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic/config/#pydantic.config.ConfigDict.alias_generator',
            'text': 'alias_generator',
          }),
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/concepts/alias/#alias-precedence',
            'text': 'here',
          }),
        ]),
        'order': 70,
        'page': None,
        'text': 'Alias precedence and priority In case you use alias together with validation_alias or serialization_alias at the same time, the validation_alias will have priority over alias for validation, and serialization_alias will have priority over alias for serialization. If you provide a value for the alias_generator model setting, you can control the order of precedence for field alias and generated aliases via the alias_priority field parameter. You can read more about alias precedence here.',
        'type': 'admonition',
      }),
      dict({
        'block_id': 'b_1be0e29bd398',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Field aliases',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 71,
        'page': None,
        'text': 'Static type checking/IDE support',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_70e7410b7ba3',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Field aliases',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 72,
        'page': None,
        'text': 'If you provide a value for the alias field parameter, static type checkers will use this alias instead of the actual field name to synthesize the __init__ method:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_5d2214890d85',
        'data': dict({
          'code': '''
            from pydantic import BaseModel, Field
            
            
            class User(BaseModel):
                name: str = Field(alias='username')
            
            
            user = User(username='johndoe')  # (1)
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Fields',
          'Field aliases',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 73,
        'page': None,
        'text': '''
          from pydantic import BaseModel, Field
          
          
          class User(BaseModel):
              name: str = Field(alias='username')
          
          
          user = User(username='johndoe')  # (1)
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_ca4a1b2e7ee1',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Field aliases',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 74,
        'page': None,
        'text': 'Accepted by type checkers.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_02bce7c7b214',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Field aliases',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic/config/#pydantic.config.ConfigDict.validate_by_name',
            'text': 'validate_by_name',
          }),
        ]),
        'order': 75,
        'page': None,
        'text': 'This means that when using the validate_by_name model setting (which allows both the field name and alias to be used during model validation), type checkers will error when the actual field name is used:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_80eb72e0d915',
        'data': dict({
          'code': '''
            from pydantic import BaseModel, ConfigDict, Field
            
            
            class User(BaseModel):
                model_config = ConfigDict(validate_by_name=True)
            
                name: str = Field(alias='username')
            
            
            user = User(name='johndoe')  # (1)
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Fields',
          'Field aliases',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 76,
        'page': None,
        'text': '''
          from pydantic import BaseModel, ConfigDict, Field
          
          
          class User(BaseModel):
              model_config = ConfigDict(validate_by_name=True)
          
              name: str = Field(alias='username')
          
          
          user = User(name='johndoe')  # (1)
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_51c8f2aaa8dc',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Field aliases',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 77,
        'page': None,
        'text': 'Not accepted by type checkers.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_81f94950bba0',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Field aliases',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/pydantic_fields.html#the-annotated-pattern',
            'text': 'annotated pattern',
          }),
        ]),
        'order': 78,
        'page': None,
        'text': 'If you still want type checkers to use the field name and not the alias, the annotated pattern can be used (which is only understood by Pydantic):',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_0883a03ba171',
        'data': dict({
          'code': '''
            from typing import Annotated
            
            from pydantic import BaseModel, ConfigDict, Field
            
            
            class User(BaseModel):
                model_config = ConfigDict(validate_by_name=True, validate_by_alias=True)
            
                name: Annotated[str, Field(alias='username')]
            
            
            user = User(name='johndoe')  # (1)
            user = User(username='johndoe')  # (2)
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Fields',
          'Field aliases',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 79,
        'page': None,
        'text': '''
          from typing import Annotated
          
          from pydantic import BaseModel, ConfigDict, Field
          
          
          class User(BaseModel):
              model_config = ConfigDict(validate_by_name=True, validate_by_alias=True)
          
              name: Annotated[str, Field(alias='username')]
          
          
          user = User(name='johndoe')  # (1)
          user = User(username='johndoe')  # (2)
        ''',
        'type': 'code',
