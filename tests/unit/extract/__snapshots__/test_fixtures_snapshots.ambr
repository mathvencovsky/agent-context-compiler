        'order': 922,
        'page': None,
        'text': 'class flask.views.MethodView Dispatches request methods to the corresponding instance methods. For example, if you implement a get method, it will be used to handle GET requests. This can be useful for defining a REST API. methods is automatically set based on the methods defined on the class. See Class-based Views for a detailed guide.',
        'type': 'definition_list',
      }),
      dict({
        'block_id': 'b_b2e326c01a89',
        'data': dict({
          'code': '''
            class CounterAPI(MethodView):
                def get(self):
                    return str(session.get("counter", 0))
            
                def post(self):
                    session["counter"] = session.get("counter", 0) + 1
                    return redirect(url_for("counter"))
            
            app.add_url_rule(
                "/counter", view_func=CounterAPI.as_view("counter")
            )
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'API',
          'Class-Based Views',
        ]),
