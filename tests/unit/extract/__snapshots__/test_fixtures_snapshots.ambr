        'text': 'The parse_args() method',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_2851ab1e71fb',
        'data': dict({
          'items': list([
            dict({
              'definition': 'Convert argument strings to objects and assign them as attributes of the namespace. Return the populated namespace. Previous calls to add_argument() determine exactly what objects are created and how they are assigned. See the documentation for add_argument() for details.',
              'term': 'ArgumentParser.parse_args(args=None, namespace=None)',
            }),
          ]),
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
