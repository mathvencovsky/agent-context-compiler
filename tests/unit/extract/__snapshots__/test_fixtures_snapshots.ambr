      dict({
        'block_id': 'b_d670c21f644f',
        'data': dict({
          'items': list([
            dict({
              'definition': 'Load any environment variables that start with FLASK_, dropping the prefix from the env key for the config key. Values are passed through a loading function to attempt to convert them to more specific types than strings. Keys are loaded in sorted() order. The default loading function attempts to parse values as any valid JSON type, including dicts and lists. Specific items in nested dicts can be set by separating the keys with double underscores (__). If an intermediate key doesn’t exist, it will be initialized to an empty dict. Changelog Added in version 2.1.',
              'term': "from_prefixed_env(prefix='FLASK', *, loads=json.loads)",
            }),
          ]),
        }),
        'heading_path': list([
          'API',
          'Configuration',
        ]),
        'level': None,
        'links': list([
