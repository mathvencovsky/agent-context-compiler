          dict({
            'href': 'https://docs.python.org/3/builtins/functions.html#property',
            'text': '@property',
          }),
        ]),
        'order': 164,
        'page': None,
        'text': 'If not specified, @computed_field will implicitly convert the method to a @property. However, it is preferable to explicitly use the @property decorator for type checking purposes.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_8ae4077a2c10',
        'data': dict({
        }),
        'heading_path': list([
