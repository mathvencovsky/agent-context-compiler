        'type': 'code',
      }),
      dict({
        'block_id': 'b_e2822df9307e',
        'data': dict({
          'items': list([
            dict({
              'definition': 'A PathInfo object that supports querying file type information. The object exposes methods that cache their results, which can help reduce the number of system calls needed when switching on file type. For example: If the path was generated from Path.iterdir() then this attribute is initialized with some information about the file type gleaned from scanning the parent directory. Merely accessing Path.info does not perform any filesystem queries. To fetch up-to-date information, it’s best to call Path.is_dir(), is_file() and is_symlink() rather than methods of this attribute. There is no way to reset the cache; instead you can create a new path object with an empty info cache via p = Path(p). Added in version 3.14.',
              'term': 'Path.info',
            }),
          ]),
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Concrete paths',
          'Querying file type and status',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.types.PathInfo',
            'text': 'PathInfo',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.Path.iterdir',
            'text': 'Path.iterdir()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.Path.is_dir',
            'text': 'Path.is_dir()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.Path.is_file',
            'text': 'is_file()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_pathlib.html#pathlib.Path.is_symlink',
            'text': 'is_symlink()',
          }),
        ]),
        'order': 162,
        'page': None,
        'text': 'Path.info A PathInfo object that supports querying file type information. The object exposes methods that cache their results, which can help reduce the number of system calls needed when switching on file type. For example: If the path was generated from Path.iterdir() then this attribute is initialized with some information about the file type gleaned from scanning the parent directory. Merely accessing Path.info does not perform any filesystem queries. To fetch up-to-date information, it’s best to call Path.is_dir(), is_file() and is_symlink() rather than methods of this attribute. There is no way to reset the cache; instead you can create a new path object with an empty info cache via p = Path(p). Added in version 3.14.',
        'type': 'definition_list',
      }),
      dict({
        'block_id': 'b_4aa03d706a3d',
        'data': dict({
          'code': '''
            >>> p = Path('src')
            >>> if p.info.is_symlink():
            ...     print('symlink')
            ... elif p.info.is_dir():
            ...     print('directory')
            ... elif p.info.exists():
            ...     print('something else')
            ... else:
            ...     print('not found')
            ...
            directory
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
