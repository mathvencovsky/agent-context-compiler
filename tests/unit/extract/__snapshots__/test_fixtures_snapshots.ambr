      dict({
        'block_id': 'b_d4d0324de629',
        'data': dict({
        }),
        'heading_path': list([
          'Fields',
          'Default values',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 25,
        'page': None,
        'text': 'Default values for fields can be provided using the normal assignment syntax or by providing a value to the default argument:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_2e677fe26765',
        'data': dict({
          'code': '''
            from pydantic import BaseModel, Field
            
            
            class User(BaseModel):
                # Both fields aren't required:
                name: str = 'John Doe'
                age: int = Field(default=20)
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Fields',
          'Default values',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 26,
        'page': None,
        'text': '''
          from pydantic import BaseModel, Field
          
          
          class User(BaseModel):
              # Both fields aren't required:
              name: str = 'John Doe'
              age: int = Field(default=20)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_551df564465b',
        'data': dict({
        }),
