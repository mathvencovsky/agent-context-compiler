      dict({
        'block_id': 'b_a7e8c2027702',
        'data': dict({
          'items': list([
            dict({
              'definition': 'The actual WSGI application. This is not implemented in __call__() so that middlewares can be applied without losing a reference to the app object. Instead of doing this: It’s a better idea to do this instead: Then you still have the original application object around and can continue to call methods on it. Changelog Changed in version 0.7: Teardown events for the request and app contexts are called even if an unhandled error occurs. Other events may not be called depending on when an error occurs during dispatch. See Callbacks and Errors.',
              'term': 'wsgi_app(environ, start_response)',
            }),
          ]),
        }),
        'heading_path': list([
          'API',
          'Application Object',
        ]),
        'level': None,
