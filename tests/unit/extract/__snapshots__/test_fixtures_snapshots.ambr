        'page': None,
        'text': 'For example, an optional argument could be created like:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_c57ca5dac8fb',
        'data': dict({
          'code': '''
            >>> parser.add_argument('-f', '--foo')
  
