        'links': list([
        ]),
        'order': 926,
        'page': None,
        'text': 'URL Route Registrations',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_f8a3017a6ef8',
        'data': dict({
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 927,
        'page': None,
        'text': 'Generally there are three ways to define rules for the routing system:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_d616987eed6f',
        'data': dict({
          'items': list([
            'You can use the flask.Flask.route() decorator.',
            'You can use the flask.Flask.add_url_rule() function.',
            'You can directly access the underlying Werkzeug routing system which is exposed as flask.Flask.url_map.',
          ]),
          'ordered': True,
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/flask_api_reference.html#flask.Flask.route',
            'text': 'flask.Flask.route()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/flask_api_reference.html#flask.Flask.add_url_rule',
            'text': 'flask.Flask.add_url_rule()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/flask_api_reference.html#flask.Flask.url_map',
            'text': 'flask.Flask.url_map',
          }),
        ]),
        'order': 928,
        'page': None,
        'text': 'You can use the flask.Flask.route() decorator. You can use the flask.Flask.add_url_rule() function. You can directly access the underlying Werkzeug routing system which is exposed as flask.Flask.url_map.',
        'type': 'list',
      }),
      dict({
        'block_id': 'b_64db42be117b',
        'data': dict({
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 929,
        'page': None,
        'text': 'Variable parts in the route can be specified with angular brackets (/user/<username>). By default a variable part in the URL accepts any string without a slash however a different converter can be specified as well by using <converter:name>.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_02c04d935f9b',
        'data': dict({
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 930,
        'page': None,
        'text': 'Variable parts are passed to the view function as keyword arguments.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_84f8db4f9700',
        'data': dict({
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 931,
        'page': None,
        'text': 'The following converters are available:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_c092156aca33',
        'data': dict({
          'caption': None,
          'headers': list([
          ]),
          'notes': list([
          ]),
          'rows': list([
            list([
              'string',
              'accepts any text without a slash (the default)',
            ]),
            list([
              'int',
              'accepts integers',
            ]),
            list([
              'float',
              'like int but for floating point values',
            ]),
            list([
              'path',
              'like the default but also accepts slashes',
            ]),
            list([
              'any',
              'matches one of the items provided',
            ]),
            list([
              'uuid',
              'accepts UUID strings',
            ]),
          ]),
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 932,
        'page': None,
        'text': 'string accepts any text without a slash (the default) int accepts integers float like int but for floating point values path like the default but also accepts slashes any matches one of the items provided uuid accepts UUID strings',
        'type': 'table',
      }),
      dict({
        'block_id': 'b_81ec11681d0b',
        'data': dict({
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/flask_api_reference.html#flask.Flask.url_map',
            'text': 'flask.Flask.url_map',
          }),
        ]),
        'order': 933,
        'page': None,
        'text': 'Custom converters can be defined using flask.Flask.url_map.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_e9eb65440859',
        'data': dict({
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 934,
        'page': None,
        'text': 'Here are some examples:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_76faa6e41e6e',
        'data': dict({
          'code': '''
            @app.route('/')
            def index():
                pass
            
            @app.route('/<username>')
            def show_user(username):
                pass
            
            @app.route('/post/<int:post_id>')
            def show_post(post_id):
                pass
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 935,
        'page': None,
        'text': '''
          @app.route('/')
          def index():
              pass
          
          @app.route('/<username>')
          def show_user(username):
              pass
          
          @app.route('/post/<int:post_id>')
          def show_post(post_id):
              pass
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_9488f5ae8806',
        'data': dict({
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 936,
        'page': None,
        'text': 'An important detail to keep in mind is how Flask deals with trailing slashes. The idea is to keep each URL unique so the following rules apply:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_e0b7dccf8c6c',
        'data': dict({
          'items': list([
            'If a rule ends with a slash and is requested without a slash by the user, the user is automatically redirected to the same page with a trailing slash attached.',
            'If a rule does not end with a trailing slash and the user requests the page with a trailing slash, a 404 not found is raised.',
          ]),
          'ordered': True,
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 937,
        'page': None,
        'text': 'If a rule ends with a slash and is requested without a slash by the user, the user is automatically redirected to the same page with a trailing slash attached. If a rule does not end with a trailing slash and the user requests the page with a trailing slash, a 404 not found is raised.',
        'type': 'list',
      }),
      dict({
        'block_id': 'b_282edbf55d47',
        'data': dict({
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 938,
        'page': None,
        'text': 'This is consistent with how web servers deal with static files. This also makes it possible to use relative link targets safely.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_fae84d009463',
        'data': dict({
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 939,
        'page': None,
        'text': 'You can also define multiple rules for the same function. They have to be unique however. Defaults can also be specified. Here for example is a definition for a URL that accepts an optional page:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_ad535b973345',
        'data': dict({
          'code': '''
            @app.route('/users/', defaults={'page': 1})
            @app.route('/users/page/<int:page>')
            def show_users(page):
                pass
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 940,
        'page': None,
        'text': '''
          @app.route('/users/', defaults={'page': 1})
          @app.route('/users/page/<int:page>')
          def show_users(page):
              pass
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_60425f5368b9',
        'data': dict({
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 941,
        'page': None,
        'text': 'This specifies that /users/ will be the URL for page one and /users/page/N will be the URL for page N.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_4f32f4986737',
        'data': dict({
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 942,
        'page': None,
        'text': 'If a URL contains a default value, it will be redirected to its simpler form with a 301 redirect. In the above example, /users/page/1 will be redirected to /users/. If your route handles GET and POST requests, make sure the default route only handles GET, as redirects can’t preserve form data.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_58fc3dd267bf',
        'data': dict({
          'code': '''
            @app.route('/region/', defaults={'id': 1})
            @app.route('/region/<int:id>', methods=['GET', 'POST'])
            def region(id):
               pass
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 943,
        'page': None,
        'text': '''
          @app.route('/region/', defaults={'id': 1})
          @app.route('/region/<int:id>', methods=['GET', 'POST'])
          def region(id):
             pass
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_b5c6e5931608',
        'data': dict({
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/flask_api_reference.html#flask.Flask.route',
            'text': 'route()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/flask_api_reference.html#flask.Flask.add_url_rule',
            'text': 'add_url_rule()',
          }),
        ]),
        'order': 944,
        'page': None,
        'text': 'Here are the parameters that route() and add_url_rule() accept. The only difference is that with the route parameter the view function is defined with the decorator instead of the view_func parameter.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_0c32efb7b574',
        'data': dict({
          'caption': None,
          'headers': list([
          ]),
          'notes': list([
          ]),
          'rows': list([
            list([
              'rule',
              'the URL rule as string',
            ]),
            list([
              'endpoint',
              'the endpoint for the registered URL rule. Flask itself assumes that the name of the view function is the name of the endpoint if not explicitly stated.',
            ]),
            list([
              'view_func',
              'the function to call when serving a request to the provided endpoint. If this is not provided one can specify the function later by storing it in the view_functions dictionary with the endpoint as key.',
            ]),
            list([
              'defaults',
              'A dictionary with defaults for this rule. See the example above for how defaults work.',
            ]),
            list([
              'subdomain',
              'specifies the rule for the subdomain in case subdomain matching is in use. If not specified the default subdomain is assumed.',
            ]),
            list([
              '**options',
              'the options to be forwarded to the underlying Rule object. A change to Werkzeug is handling of method options. methods is a list of methods this rule should be limited to (GET, POST etc.). By default a rule just listens for GET (and implicitly HEAD). Starting with Flask 0.6, OPTIONS is implicitly added and handled by the standard request handling. They have to be specified as keyword arguments.',
            ]),
          ]),
        }),
        'heading_path': list([
          'API',
          'URL Route Registrations',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/flask_api_reference.html#flask.Flask.view_functions',
            'text': 'view_functions',
          }),
          dict({
            'href': 'https://werkzeug.palletsprojects.com/en/stable/routing/#werkzeug.routing.Rule',
            'text': 'Rule',
          }),
        ]),
        'order': 945,
        'page': None,
        'text': 'rule the URL rule as string endpoint the endpoint for the registered URL rule. Flask itself assumes that the name of the view function is the name of the endpoint if not explicitly stated. view_func the function to call when serving a request to the provided endpoint. If this is not provided one can specify the function later by storing it in the view_functions dictionary with the endpoint as key. defaults A dictionary with defaults for this rule. See the example above for how defaults work. subdomain specifies the rule for the subdomain in case subdomain matching is in use. If not specified the default subdomain is assumed. **options the options to be forwarded to the underlying Rule object. A change to Werkzeug is handling of method options. methods is a list of methods this rule should be limited to (GET, POST etc.). By default a rule just listens for GET (and implicitly HEAD). Starting with Flask 0.6, OPTIONS is implicitly added and handled by the standard request handling. They have to be specified as keyword arguments.',
        'type': 'table',
      }),
      dict({
        'block_id': 'b_f7860d7bc098',
        'data': dict({
        }),
        'heading_path': list([
          'API',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 946,
        'page': None,
        'text': 'View Function Options',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_1d29b681d8cf',
        'data': dict({
        }),
        'heading_path': list([
          'API',
          'View Function Options',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/flask_api_reference.html#flask.Flask.add_url_rule',
            'text': 'add_url_rule()',
          }),
        ]),
        'order': 947,
        'page': None,
        'text': 'For internal usage the view functions can have some attributes attached to customize behavior the view function would normally not have control over. The following attributes can be provided optionally to either override some defaults to add_url_rule() or general behavior:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_e5a21998043e',
        'data': dict({
          'items': list([
            '__name__: The name of a function is by default used as endpoint. If endpoint is provided explicitly this value is used. Additionally this will be prefixed with the name of the blueprint by default which cannot be customized from the function itself.',
            'methods: If methods are not provided when the URL rule is added, Flask will look on the view function object itself if a methods attribute exists. If it does, it will pull the information for the methods from there.',
            'provide_automatic_options: if this attribute is set Flask will either force enable or disable the automatic implementation of the HTTP OPTIONS response. This can be useful when working with decorators that want to customize the OPTIONS response on a per-view basis.',
            'required_methods: if this attribute is set, Flask will always add these methods when registering a URL rule even if the methods were explicitly overridden in the route() call.',
          ]),
          'ordered': False,
        }),
        'heading_path': list([
          'API',
          'View Function Options',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 948,
        'page': None,
        'text': '__name__: The name of a function is by default used as endpoint. If endpoint is provided explicitly this value is used. Additionally this will be prefixed with the name of the blueprint by default which cannot be customized from the function itself. methods: If methods are not provided when the URL rule is added, Flask will look on the view function object itself if a methods attribute exists. If it does, it will pull the information for the methods from there. provide_automatic_options: if this attribute is set Flask will either force enable or disable the automatic implementation of the HTTP OPTIONS response. This can be useful when working with decorators that want to customize the OPTIONS response on a per-view basis. required_methods: if this attribute is set, Flask will always add these methods when registering a URL rule even if the methods were explicitly overridden in the route() call.',
        'type': 'list',
      }),
      dict({
        'block_id': 'b_36d25da8f607',
        'data': dict({
        }),
        'heading_path': list([
          'API',
          'View Function Options',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 949,
        'page': None,
        'text': 'Full example:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_78668df3b16e',
        'data': dict({
          'code': '''
            def index():
                if request.method == 'OPTIONS':
                    # custom options handling here
                    ...
                return 'Hello World!'
            index.provide_automatic_options = False
            index.methods = ['GET', 'OPTIONS']
            
            app.add_url_rule('/', index)
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'API',
          'View Function Options',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 950,
        'page': None,
        'text': '''
          def index():
              if request.method == 'OPTIONS':
                  # custom options handling here
                  ...
              return 'Hello World!'
          index.provide_automatic_options = False
          index.methods = ['GET', 'OPTIONS']
          
          app.add_url_rule('/', index)
  
        ''',
        'type': 'code',
      }),
      dict({
