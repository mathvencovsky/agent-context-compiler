            dict({
              'definition': 'Wraps a callback so that it’s guaranteed to be executed with the script’s application context. Custom commands (and their options) registered under app.cli or blueprint.cli will always have an app context available, this decorator is not required in that case. Changelog Changed in version 2.2: The app context is active for subcommands as well as the decorated callback. The app context is always available to app.cli command and parameter callbacks.',
              'term': 'flask.cli.with_appcontext(f)',
            }),
          ]),
        }),
