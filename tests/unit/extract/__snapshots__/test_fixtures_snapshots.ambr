        'type': 'definition_list',
      }),
      dict({
        'block_id': 'b_0bdbf4083570',
        'data': dict({
          'items': list([
            dict({
              'definition': 'True if the session object detected a modification. Be advised that modifications on mutable structures are not picked up automatically, in that situation you have to explicitly set the attribute to True yourself. Here an example:',
              'term': 'modified',
            }),
          ]),
        }),
        'heading_path': list([
          'API',
          'Sessions',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 556,
        'page': None,
        'text': 'modified True if the session object detected a modification. Be advised that modifications on mutable structures are not picked up automatically, in that situation you have to explicitly set the attribute to True yourself. Here an example:',
        'type': 'definition_list',
      }),
      dict({
        'block_id': 'b_bf04fbe985ea',
        'data': dict({
          'code': '''
            # this change is not picked up because a mutable object (here
            # a list) is changed.
            session['objects'].append(42)
            # so mark it as modified yourself
            session.modified = True
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'API',
          'Sessions',
        ]),
        'level': None,
        'links': list([
