          >>> sorted(tel)
          ['guido', 'irv', 'jack']
          >>> 'guido' in tel
          True
          >>> 'jack' not in tel
          False
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_d8e386c86d26',
        'data': dict({
        }),
        'heading_path': list([
          '5. Data Structures',
          '5.5. Dictionaries',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/builtins/stdtypes.html#dict',
            'text': 'dict()',
          }),
        ]),
        'order': 100,
        'page': None,
        'text': 'The dict() constructor builds dictionaries directly from sequences of key-value pairs:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_86d2166516b5',
        'data': dict({
          'code': '''
            >>> dict([('sape', 4139), ('guido', 4127), ('jack', 4098)])
            {'sape': 4139, 'guido': 4127, 'jack': 4098}
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          '5. Data Structures',
          '5.5. Dictionaries',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 101,
        'page': None,
        'text': '''
          >>> dict([('sape', 4139), ('guido', 4127), ('jack', 4098)])
          {'sape': 4139, 'guido': 4127, 'jack': 4098}
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_557a90644ce5',
        'data': dict({
        }),
        'heading_path': list([
          '5. Data Structures',
          '5.5. Dictionaries',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 102,
        'page': None,
        'text': 'In addition, dict comprehensions can be used to create dictionaries from arbitrary key and value expressions:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_2571f63edc22',
        'data': dict({
          'code': '''
            >>> {x: x**2 for x in (2, 4, 6)}
            {2: 4, 4: 16, 6: 36}
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          '5. Data Structures',
          '5.5. Dictionaries',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 103,
        'page': None,
        'text': '''
          >>> {x: x**2 for x in (2, 4, 6)}
          {2: 4, 4: 16, 6: 36}
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_fc72dc30672f',
        'data': dict({
        }),
        'heading_path': list([
          '5. Data Structures',
          '5.5. Dictionaries',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 104,
        'page': None,
        'text': 'And dictionary unpacking (via **) can be used to merge multiple dictionaries:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_28ca9d353837',
        'data': dict({
          'code': '''
            >>> odds = {i: i**2 for i in (1, 3, 5)}
            >>> evens = {i: i**2 for i in (2, 4, 6)}
            >>> {**odds, **evens}
            {1: 1, 3: 9, 5: 25, 2: 4, 4: 16, 6: 36}
            
            >>> all_values = [odds, evens, {0: 0}]
            >>> {**i for i in all_values}
            {1: 1, 3: 9, 5: 25, 2: 4, 4: 16, 6: 36, 0: 0}
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          '5. Data Structures',
          '5.5. Dictionaries',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 105,
        'page': None,
        'text': '''
          >>> odds = {i: i**2 for i in (1, 3, 5)}
          >>> evens = {i: i**2 for i in (2, 4, 6)}
          >>> {**odds, **evens}
          {1: 1, 3: 9, 5: 25, 2: 4, 4: 16, 6: 36}
          
          >>> all_values = [odds, evens, {0: 0}]
          >>> {**i for i in all_values}
          {1: 1, 3: 9, 5: 25, 2: 4, 4: 16, 6: 36, 0: 0}
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_a5b7adbf5482',
        'data': dict({
        }),
        'heading_path': list([
          '5. Data Structures',
          '5.5. Dictionaries',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 106,
        'page': None,
        'text': 'When the keys are simple strings, it is sometimes easier to specify pairs using keyword arguments:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_1024bd26ec32',
        'data': dict({
          'code': '''
            >>> dict(sape=4139, guido=4127, jack=4098)
            {'sape': 4139, 'guido': 4127, 'jack': 4098}
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          '5. Data Structures',
          '5.5. Dictionaries',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 107,
        'page': None,
        'text': '''
          >>> dict(sape=4139, guido=4127, jack=4098)
          {'sape': 4139, 'guido': 4127, 'jack': 4098}
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_eba8f996f4c6',
        'data': dict({
        }),
        'heading_path': list([
          '5. Data Structures',
        ]),
        'level': 2,
        'links': list([
        ]),
        'order': 108,
        'page': None,
        'text': '5.6. Looping Techniques',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_fe400c36b88d',
        'data': dict({
        }),
        'heading_path': list([
          '5. Data Structures',
          '5.6. Looping Techniques',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/builtins/stdtypes.html#dict.items',
            'text': 'items()',
          }),
        ]),
        'order': 109,
        'page': None,
        'text': 'When looping through dictionaries, the key and corresponding value can be retrieved at the same time using the items() method.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_285a697eff6d',
        'data': dict({
          'code': '''
            >>> knights = {'gallahad': 'the pure', 'robin': 'the brave'}
            >>> for k, v in knights.items():
            ...     print(k, v)
            ...
            gallahad the pure
            robin the brave
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          '5. Data Structures',
          '5.6. Looping Techniques',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 110,
        'page': None,
        'text': '''
          >>> knights = {'gallahad': 'the pure', 'robin': 'the brave'}
          >>> for k, v in knights.items():
          ...     print(k, v)
          ...
          gallahad the pure
          robin the brave
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_cd71e02e642a',
        'data': dict({
        }),
        'heading_path': list([
          '5. Data Structures',
          '5.6. Looping Techniques',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/builtins/functions.html#enumerate',
            'text': 'enumerate()',
          }),
        ]),
        'order': 111,
        'page': None,
        'text': 'When looping through a sequence, the position index and corresponding value can be retrieved at the same time using the enumerate() function.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_70a978078634',
        'data': dict({
          'code': '''
            >>> for i, v in enumerate(['tic', 'tac', 'toe']):
            ...     print(i, v)
            ...
            0 tic
            1 tac
            2 toe
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          '5. Data Structures',
          '5.6. Looping Techniques',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 112,
        'page': None,
        'text': '''
          >>> for i, v in enumerate(['tic', 'tac', 'toe']):
          ...     print(i, v)
          ...
          0 tic
          1 tac
          2 toe
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_fd00fccf5b6e',
        'data': dict({
        }),
        'heading_path': list([
          '5. Data Structures',
          '5.6. Looping Techniques',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/builtins/functions.html#zip',
            'text': 'zip()',
          }),
        ]),
        'order': 113,
        'page': None,
        'text': 'To loop over two or more sequences at the same time, the entries can be paired with the zip() function.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_f891edd0e719',
        'data': dict({
          'code': '''
            >>> questions = ['name', 'quest', 'favorite color']
            >>> answers = ['lancelot', 'the holy grail', 'blue']
            >>> for q, a in zip(questions, answers):
            ...     print('What is your {0}?  It is {1}.'.format(q, a))
            ...
            What is your name?  It is lancelot.
            What is your quest?  It is the holy grail.
            What is your favorite color?  It is blue.
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          '5. Data Structures',
          '5.6. Looping Techniques',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 114,
        'page': None,
        'text': '''
          >>> questions = ['name', 'quest', 'favorite color']
          >>> answers = ['lancelot', 'the holy grail', 'blue']
          >>> for q, a in zip(questions, answers):
