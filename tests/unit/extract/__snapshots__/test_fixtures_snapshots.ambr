        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'color',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 101,
        'page': None,
        'text': 'To highlight inline code in your description, epilog, or argument help text, you can use single or double backticks:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_e3869a1d79f5',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(
            ...     formatter_class=argparse.RawDescriptionHelpFormatter,
            ...     description='Run ``python -m myapp`` to start.',
            ...     epilog='''Examples:
            ...   `python -m myapp --verbose`
            ...   ``python -m myapp --config settings.json``
            ... ''')
            >>> parser.add_argument('--foo', help='set the `foo` value')
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
