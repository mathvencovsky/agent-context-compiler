      dict({
        'block_id': 'b_fc900a4378ae',
        'data': dict({
          'items': list([
            "'*'. All command-line arguments present are gathered into a list. Note that it generally doesn’t make much sense to have more than one positional argument with nargs='*', but multiple optional arguments with nargs='*' is possible. For example:",
          ]),
          'ordered': False,
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'nargs',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 141,
        'page': None,
        'text': "'*'. All command-line arguments present are gathered into a list. Note that it generally doesn’t make much sense to have more than one positional argument with nargs='*', but multiple optional arguments with nargs='*' is possible. For example:",
        'type': 'list',
      }),
      dict({
        'block_id': 'b_7d638d7255bc',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser()
