        'data': dict({
          'items': list([
            dict({
              'definition': 'Rename this file or directory to the given target, and return a new Path instance pointing to target. If target points to an existing file or empty directory, it will be unconditionally replaced. The target path may be absolute or relative. Relative paths are interpreted relative to the current working directory, not the directory of the Path object. Changed in version 3.8: Added return value, return the new Path instance.',
              'term': 'Path.replace(target)',
            }),
          ]),
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Concrete paths',
          'Copying, moving and deleting',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 195,
        'page': None,
        'text': 'Path.replace(target) Rename this file or directory to the given target, and return a new Path instance pointing to target. If target points to an existing file or empty directory, it will be unconditionally replaced. The target path may be absolute or relative. Relative paths are interpreted relative to the current working directory, not the directory of the Path object. Changed in version 3.8: Added return value, return the new Path instance.',
        'type': 'definition_list',
      }),
      dict({
        'block_id': 'b_95b201067980',
        'data': dict({
          'items': list([
            dict({
              'definition': 'Move this file or directory tree to the given target, and return a new Path instance pointing to target. If the target doesn’t exist it will be created. If both this path and the target are existing files, then the target is overwritten. If both paths point to the same file or directory, or the target is a non-empty directory, then OSError is raised. If both paths are on the same filesystem, the move is performed with os.replace(). Otherwise, this path is copied (preserving metadata and symlinks) and then deleted. Added in version 3.14.',
              'term': 'Path.move(target)',
            }),
          ]),
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Concrete paths',
          'Copying, moving and deleting',
        ]),
        'level': None,
        'links': list([
