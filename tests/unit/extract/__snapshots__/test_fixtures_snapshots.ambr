        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic/base_model/#pydantic.BaseModel.model_dump',
            'text': 'model_dump()',
          }),
        ]),
        'order': 165,
        'page': None,
        'text': 'Here’s an example using the model_dump() method with a computed field:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_1182434b9f1d',
        'data': dict({
          'code': '''
            from pydantic import BaseModel, computed_field
            
            
            class Box(BaseModel):
                width: float
                height: float
                depth: float
            
                @computed_field
                @property
                def volume(self) -> float:
                    return self.width * self.height * self.depth
            
            
            b = Box(width=1, height=2, depth=3)
            print(b.model_dump())
            #> {'width': 1.0, 'height': 2.0, 'depth': 3.0, 'volume': 6.0}
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Fields',
