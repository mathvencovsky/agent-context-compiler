        'type': 'definition_list',
      }),
      dict({
        'block_id': 'b_e39c0831d84b',
        'data': dict({
          'items': list([
            dict({
              'definition': 'The WWW-Authenticate header parsed into a WWWAuthenticate object. Modifying the object will modify the header value. This header is not set by default. To set this header, assign an instance of WWWAuthenticate to this attribute. Multiple values for this header can be sent to give the client multiple options. Assign a list to set multiple headers. However, modifying the items in the list will not automatically update the header values, and accessing this attribute will only ever return the first value. To unset this header, assign None or use del. Changelog Changed in version 2.3: This attribute can be assigned to set the header. A list can be assigned to set multiple header values. Use del to unset the header. Changed in version 2.3: WWWAuthenticate is no longer a dict. The token attribute was added for auth challenges that use a token instead of parameters.',
              'term': 'property www_authenticate: WWWAuthenticate',
            }),
          ]),
        }),
        'heading_path': list([
          'API',
          'Response Objects',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://werkzeug.palletsprojects.com/en/stable/datastructures/#werkzeug.datastructures.WWWAuthenticate',
            'text': 'WWWAuthenticate',
          }),
        ]),
        'order': 545,
        'page': None,
        'text': 'property www_authenticate: WWWAuthenticate The WWW-Authenticate header parsed into a WWWAuthenticate object. Modifying the object will modify the header value. This header is not set by default. To set this header, assign an instance of WWWAuthenticate to this attribute. Multiple values for this header can be sent to give the client multiple options. Assign a list to set multiple headers. However, modifying the items in the list will not automatically update the header values, and accessing this attribute will only ever return the first value. To unset this header, assign None or use del. Changelog Changed in version 2.3: This attribute can be assigned to set the header. A list can be assigned to set multiple header values. Use del to unset the header. Changed in version 2.3: WWWAuthenticate is no longer a dict. The token attribute was added for auth challenges that use a token instead of parameters.',
        'type': 'definition_list',
      }),
      dict({
        'block_id': 'b_7ab189e75cc8',
        'data': dict({
          'code': '''
            response.www_authenticate = WWWAuthenticate(
                "basic", {"realm": "Authentication Required"}
            )
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'API',
          'Response Objects',
        ]),
        'level': None,
        'links': list([
