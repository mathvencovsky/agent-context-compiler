        'type': 'heading',
      }),
      dict({
        'block_id': 'b_725900ae5efa',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Rebuilding model schema',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/internals/architecture/',
            'text': 'Architecture',
          }),
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic/base_model/#pydantic.BaseModel.model_rebuild',
            'text': 'model_rebuild()',
          }),
        ]),
        'order': 70,
        'page': None,
        'text': 'When you define a model class in your code, Pydantic will analyze the body of the class to collect a variety of information required to perform validation and serialization, gathered in a core schema. Notably, the model’s type annotations are evaluated to understand the valid types for each field (more information can be found in the Architecture documentation). However, it might be the case that annotations refer to symbols not defined when the model class is being created. To circumvent this issue, the model_rebuild() method can be used:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_f4ce2845ff14',
        'data': dict({
          'code': '''
            from pydantic import BaseModel, PydanticUserError
            
            
            class Foo(BaseModel):
                x: 'Bar'  # (1)
            
            
            try:
                Foo.model_json_schema()
            except PydanticUserError as e:
                print(e)
                """
                `Foo` is not fully defined; you should define `Bar`, then call `Foo.model_rebuild()`.
            
                For further information visit https://errors.pydantic.dev/2/u/class-not-fully-defined
                """
            
            
            class Bar(BaseModel):
                pass
            
            
            Foo.model_rebuild()
            print(Foo.model_json_schema())
            """
            {
                '$defs': {'Bar': {'properties': {}, 'title': 'Bar', 'type': 'object'}},
                'properties': {'x': {'$ref': '#/$defs/Bar'}},
                'required': ['x'],
                'title': 'Foo',
                'type': 'object',
            }
            """
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Rebuilding model schema',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 71,
        'page': None,
        'text': '''
          from pydantic import BaseModel, PydanticUserError
          
          
          class Foo(BaseModel):
              x: 'Bar'  # (1)
          
          
          try:
              Foo.model_json_schema()
          except PydanticUserError as e:
              print(e)
              """
              `Foo` is not fully defined; you should define `Bar`, then call `Foo.model_rebuild()`.
          
              For further information visit https://errors.pydantic.dev/2/u/class-not-fully-defined
              """
          
          
          class Bar(BaseModel):
              pass
          
          
          Foo.model_rebuild()
          print(Foo.model_json_schema())
          """
          {
              '$defs': {'Bar': {'properties': {}, 'title': 'Bar', 'type': 'object'}},
              'properties': {'x': {'$ref': '#/$defs/Bar'}},
              'required': ['x'],
              'title': 'Foo',
              'type': 'object',
          }
          """
        ''',
        'type': 'code',
      }),
