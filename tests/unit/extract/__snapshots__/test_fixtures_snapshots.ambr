        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser.parse_args',
            'text': 'parse_args()',
          }),
        ]),
        'order': 115,
        'page': None,
        'text': 'When parse_args() is called, optional arguments will be identified by the - prefix, and the remaining arguments will be assumed to be positional:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_0718a5c5f149',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(prog='PROG')
            >>> parser.add_argument('-f', '--foo')
            >>> parser.add_argument('bar')
            >>> parser.parse_args(['BAR'])
            Namespace(bar='BAR', foo=None)
            >>> parser.parse_args(['BAR', '--foo', 'FOO'])
            Namespace(bar='BAR', foo='FOO')
            >>> parser.parse_args(['--foo', 'FOO'])
            usage: PROG [-h] [-f FOO] bar
            PROG: error: the following arguments are required: bar
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
