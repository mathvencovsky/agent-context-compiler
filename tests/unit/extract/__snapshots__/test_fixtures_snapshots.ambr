            'href': 'https://github.com/tiangolo/fastapi/pull/4575',
            'text': '#4575',
          }),
        ]),
        'order': 1457,
        'page': None,
        'text': 'Technical Details: If you want to know more of the technical details you can check out the PR description #4575.',
