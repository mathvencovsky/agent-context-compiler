        'heading_path': list([
          'Models',
          'Dynamic model creation',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://docs.python.org/3/library/typing.html#typing.Annotated',
            'text': 'Annotated',
          }),
        ]),
        'order': 182,
        'page': None,
        'text': 'When providing a single element for field definitions, any type can be used (previously, only an Annotated form could be provided).',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_2d00471f719c',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Dynamic model creation',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 183,
        'page': None,
        'text': 'Here is a more advanced example:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_8a355dae4e95',
        'data': dict({
          'code': '''
            from typing import Annotated
            
            from pydantic import BaseModel, Field, PrivateAttr, create_model
            
            DynamicModel = create_model(
                'DynamicModel',
                foo=(str, Field(alias='FOO')),
                bar=Annotated[str, Field(description='Bar field')],
                _private=(int, PrivateAttr(default=1)),
            )
            
            
            class StaticModel(BaseModel):
                foo: str = Field(alias='FOO')
                bar: Annotated[str, Field(description='Bar field')]
                _private: int = PrivateAttr(default=1)
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Dynamic model creation',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 184,
        'page': None,
        'text': '''
          from typing import Annotated
          
          from pydantic import BaseModel, Field, PrivateAttr, create_model
          
          DynamicModel = create_model(
              'DynamicModel',
              foo=(str, Field(alias='FOO')),
              bar=Annotated[str, Field(description='Bar field')],
              _private=(int, PrivateAttr(default=1)),
          )
          
          
          class StaticModel(BaseModel):
              foo: str = Field(alias='FOO')
              bar: Annotated[str, Field(description='Bar field')]
              _private: int = PrivateAttr(default=1)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_498b53055fad',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Dynamic model creation',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 185,
        'page': None,
        'text': 'The special keyword arguments __config__ and __base__ can be used to customize the new model. This includes extending a base model with extra fields.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_01081fe6b0df',
        'data': dict({
          'code': '''
            from pydantic import BaseModel, create_model
            
            
            class FooModel(BaseModel):
                foo: str
                bar: int = 123
            
            
            BarModel = create_model(
                'BarModel',
                apple=(str, 'russet'),
                banana=(str, 'yellow'),
                __base__=FooModel,
            )
            print(BarModel)
            #> <class '__main__.BarModel'>
            print(BarModel.model_fields.keys())
            #> dict_keys(['foo', 'bar', 'apple', 'banana'])
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Dynamic model creation',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 186,
        'page': None,
        'text': '''
          from pydantic import BaseModel, create_model
          
          
          class FooModel(BaseModel):
              foo: str
              bar: int = 123
          
          
          BarModel = create_model(
              'BarModel',
              apple=(str, 'russet'),
              banana=(str, 'yellow'),
              __base__=FooModel,
          )
          print(BarModel)
          #> <class '__main__.BarModel'>
          print(BarModel.model_fields.keys())
          #> dict_keys(['foo', 'bar', 'apple', 'banana'])
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_40053e971f6a',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Dynamic model creation',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/concepts/validators/',
            'text': 'validators',
          }),
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/concepts/fields/#the-computed_field-decorator',
            'text': 'computed fields',
          }),
        ]),
        'order': 187,
        'page': None,
        'text': 'Attributes such as validators, methods or computed fields can be added to the class namespace using the __namespace__ argument:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_306c03ea4ca2',
        'data': dict({
          'code': '''
            from pydantic import (
                ValidationError,
                computed_field,
                create_model,
                field_validator,
            )
            
            
            def alphanum(cls, v: str) -> str:
                assert v.isalnum(), 'must be alphanumeric'
                return v
            
            
            def full_name(self) -> str:
                return f'{self.first_name} {self.last_name}'
            
            
            UserModel = create_model(
                'UserModel',
                first_name=str,
                last_name=str,
                __namespace__={  # (1)
                    'check_alphanum': field_validator('first_name', 'last_name')(alphanum),
                    'full_name': computed_field(property(full_name)),
                },
            )
            
            user = UserModel(first_name='John', last_name='Doe')
            print(user.model_dump())
            #> {'first_name': 'John', 'last_name': 'Doe', 'full_name': 'John Doe'}
            
            try:
                UserModel(first_name='J%hn', last_name='Doe')
            except ValidationError as e:
                print(e)
                """
                1 validation error for UserModel
                first_name
                  Assertion failed, must be alphanumeric [type=assertion_error, input_value='J%hn', input_type=str]
                """
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Dynamic model creation',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 188,
        'page': None,
        'text': '''
          from pydantic import (
              ValidationError,
              computed_field,
              create_model,
              field_validator,
          )
          
          
          def alphanum(cls, v: str) -> str:
              assert v.isalnum(), 'must be alphanumeric'
              return v
          
          
          def full_name(self) -> str:
              return f'{self.first_name} {self.last_name}'
          
          
          UserModel = create_model(
              'UserModel',
              first_name=str,
              last_name=str,
              __namespace__={  # (1)
                  'check_alphanum': field_validator('first_name', 'last_name')(alphanum),
                  'full_name': computed_field(property(full_name)),
              },
          )
          
          user = UserModel(first_name='John', last_name='Doe')
          print(user.model_dump())
          #> {'first_name': 'John', 'last_name': 'Doe', 'full_name': 'John Doe'}
          
          try:
              UserModel(first_name='J%hn', last_name='Doe')
          except ValidationError as e:
              print(e)
              """
              1 validation error for UserModel
              first_name
                Assertion failed, must be alphanumeric [type=assertion_error, input_value='J%hn', input_type=str]
              """
        ''',
        'type': 'code',
      }),
