        'order': 258,
        'page': None,
        'text': 'One key difference that has nothing to do with the API is a change in the license from the ISC license to the Apache 2.0 license. The Apache 2.0 license ensures that contributions to Requests are also covered by the Apache 2.0 license.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_3ef81cd88f9f',
        'data': dict({
        }),
        'heading_path': list([
