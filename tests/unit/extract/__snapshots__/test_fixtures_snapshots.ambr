            'text': 'concrete path',
          }),
        ]),
        'order': 4,
        'page': None,
        'text': 'If you’ve never used this module before or just aren’t sure which class is right for your task, Path is most likely what you need. It instantiates a concrete path for the platform the code is running on.',
        'type': 'paragraph',
      }),
      dict({
