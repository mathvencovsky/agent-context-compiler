          'color',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 99,
        'page': None,
        'text': 'Note that when color=True, colored output depends on both environment variables and terminal capabilities. However, if color=False, colored output is always disabled, even if environment variables like FORCE_COLOR are set.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_d04edea10075',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
