      dict({
        'block_id': 'b_76375824e21b',
        'data': dict({
          'items': list([
            '🔒️ Add strict_content_type checking for JSON requests. PR #14978 by @tiangolo.',
            "  Now FastAPI checks, by default, that JSON requests have a Content-Type header with a valid JSON value, like application/json, and rejects requests that don't.",
            "  If the clients for your app don't send a valid Content-Type header you can disable this with strict_content_type=False.",
            '  Check the new docs: Strict Content-Type Checking.',
          ]),
          'ordered': False,
        }),
        'heading_path': list([
          'Release Notes',
          '0.132.0 (2026-02-23)',
          'Breaking Changes',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://github.com/fastapi/fastapi/pull/14978',
            'text': '#14978',
          }),
          dict({
            'href': 'https://github.com/tiangolo',
            'text': '@tiangolo',
          }),
          dict({
            'href': 'https://fastapi.tiangolo.com/advanced/strict-content-type/',
            'text': 'Strict Content-Type Checking',
          }),
        ]),
        'order': 250,
        'page': None,
        'text': "🔒️ Add strict_content_type checking for JSON requests. PR #14978 by @tiangolo. Now FastAPI checks, by default, that JSON requests have a Content-Type header with a valid JSON value, like application/json, and rejects requests that don't. If the clients for your app don't send a valid Content-Type header you can disable this with strict_content_type=False. Check the new docs: Strict Content-Type Checking.",
        'type': 'list',
      }),
