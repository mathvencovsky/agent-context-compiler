        'text': 'This release provides proper support for Python 3.13, with (Cythonized) wheels published for this version. As a consequence, Cython was updated from 0.29.x to 3.0.x.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_d0d63e1633cb',
        'data': dict({
          'items': list([
