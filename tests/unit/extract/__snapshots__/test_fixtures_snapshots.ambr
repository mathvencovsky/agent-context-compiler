            'text': 'permanent_session_lifetime',
          }),
        ]),
        'order': 554,
        'page': None,
        'text': 'class flask.session The session object works pretty much like an ordinary dict, with the difference that it keeps track of modifications. This is a proxy. See Notes On Proxies for more information. The following attributes are interesting:',
        'type': 'definition_list',
      }),
      dict({
        'block_id': 'b_6bf6749781f6',
        'data': dict({
          'items': list([
