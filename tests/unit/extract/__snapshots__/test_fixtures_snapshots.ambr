      dict({
        'block_id': 'b_adb1e6886a21',
        'data': dict({
          'code': '''
            import abc
            
            from pydantic import BaseModel
            
            
            class FooBarModel(BaseModel, abc.ABC):
                a: str
                b: int
            
                @abc.abstractmethod
                def my_abstract_method(self):
                    pass
  
          ''',
