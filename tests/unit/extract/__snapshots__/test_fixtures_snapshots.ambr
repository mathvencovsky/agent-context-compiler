      dict({
        'block_id': 'b_359d5023ee30',
        'data': dict({
          'code': '''
            class Person:
               def __init__(self, name, age):
                  self.name = name
                  self.age = age
            
               def __repr__(self):
                  return f"Person({self.name!r}, {self.age!r})"
  
          ''',
          'language': 'python3',
        }),
