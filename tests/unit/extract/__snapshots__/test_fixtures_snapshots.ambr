          'Validating data',
          'Defining a custom __init__()',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 95,
        'page': None,
        'text': 'Pydantic provides a default __init__() implementation for Pydantic models, that is called only when using the model constructor (and not with the model_validate_*() methods). This implementation delegates validation to pydantic-core.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_06a636b62ac0',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Validating data',
          'Defining a custom __init__()',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/pydantic_models.html#validating-data',
            'text': 'validation methods',
          }),
        ]),
        'order': 96,
        'page': None,
        'text': 'However, it is possible to define a custom __init__() on your models. In this case, it will be called unconditionally from all the validation methods, without performing validation (and so you should call super().__init__(**kwargs) in your implementation).',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_a0273a1c899d',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'Validating data',
          'Defining a custom __init__()',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/concepts/strict_mode/',
            'text': 'strictness',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/pydantic_models.html#extra-data',
            'text': 'extra data behavior',
          }),
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/concepts/validators/#validation-context',
            'text': 'validation context',
          }),
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/concepts/validators/#field-after-validator',
            'text': 'field',
          }),
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/concepts/validators/#model-after-validator',
            'text': 'model',
          }),
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic/base_model/#pydantic.BaseModel.model_post_init',
            'text': 'model_post_init()',
          }),
        ]),
        'order': 97,
        'page': None,
        'text': 'Defining a custom __init__() is not recommended, as all the validation parameters (strictness, extra data behavior, validation context) will be lost. If you need to perform actions after the model was initialized, you can make use of after field or model validators, or define a model_post_init() implementation:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_e5d6167c7e09',
        'data': dict({
          'code': '''
            import logging
            from typing import Any
            
            from pydantic import BaseModel
            
            
            class MyModel(BaseModel):
                id: int
            
                def model_post_init(self, context: Any) -> None:
                    logging.info("Model initialized with id %d", self.id)
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Validating data',
          'Defining a custom __init__()',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 98,
        'page': None,
        'text': '''
          import logging
          from typing import Any
          
          from pydantic import BaseModel
          
          
          class MyModel(BaseModel):
              id: int
          
              def model_post_init(self, context: Any) -> None:
                  logging.info("Model initialized with id %d", self.id)
  
        ''',
        'type': 'code',
      }),
