        'order': 216,
        'page': None,
        'text': 'Field order affects models in the following ways:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_13be82ce984d',
        'data': dict({
          'items': list([
            'field order is preserved in the model JSON Schema',
            'field order is preserved in validation errors',
            'field order is preserved when serializing data',
          ]),
          'ordered': False,
        }),
        'heading_path': list([
          'Models',
          'Field ordering',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/concepts/json_schema/',
            'text': 'JSON Schema',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/pydantic_models.html#error-handling',
            'text': 'validation errors',
          }),
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/concepts/serialization/#serializing-data',
            'text': 'serializing data',
          }),
        ]),
        'order': 217,
        'page': None,
        'text': 'field order is preserved in the model JSON Schema field order is preserved in validation errors field order is preserved when serializing data',
        'type': 'list',
      }),
      dict({
        'block_id': 'b_fe4d6e4c8074',
        'data': dict({
          'code': '''
            from pydantic import BaseModel, ValidationError
            
            
            class Model(BaseModel):
                a: int
                b: int = 2
                c: int = 1
                d: int = 0
                e: float
            
            
            print(Model.model_fields.keys())
            #> dict_keys(['a', 'b', 'c', 'd', 'e'])
            m = Model(e=2, a=1)
            print(m.model_dump())
            #> {'a': 1, 'b': 2, 'c': 1, 'd': 0, 'e': 2.0}
            try:
                Model(a='x', b='x', c='x', d='x', e='x')
            except ValidationError as err:
                error_locations = [e['loc'] for e in err.errors()]
            
            print(error_locations)
            #> [('a',), ('b',), ('c',), ('d',), ('e',)]
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Field ordering',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 218,
        'page': None,
        'text': '''
          from pydantic import BaseModel, ValidationError
          
          
          class Model(BaseModel):
              a: int
              b: int = 2
              c: int = 1
              d: int = 0
              e: float
          
          
          print(Model.model_fields.keys())
          #> dict_keys(['a', 'b', 'c', 'd', 'e'])
          m = Model(e=2, a=1)
          print(m.model_dump())
          #> {'a': 1, 'b': 2, 'c': 1, 'd': 0, 'e': 2.0}
          try:
              Model(a='x', b='x', c='x', d='x', e='x')
          except ValidationError as err:
              error_locations = [e['loc'] for e in err.errors()]
          
          print(error_locations)
          #> [('a',), ('b',), ('c',), ('d',), ('e',)]
  
        ''',
        'type': 'code',
      }),
