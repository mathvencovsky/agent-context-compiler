      dict({
        'block_id': 'b_9ff24224edd3',
        'data': dict({
          'items': list([
            dict({
              'definition': 'This signal is sent when an unhandled exception happens during request processing, including when debugging. The exception is passed to the subscriber as exception. This signal is not sent for HTTPException, or other exceptions that have error handlers registered, unless the exception was raised from an error handler. This example shows how to do some extra logging if a theoretical SecurityException was raised:',
              'term': 'flask.got_request_exception',
            }),
          ]),
        }),
        'heading_path': list([
          'API',
          'Signals',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://werkzeug.palletsprojects.com/en/stable/exceptions/#werkzeug.exceptions.HTTPException',
            'text': 'HTTPException',
          }),
        ]),
        'order': 896,
        'page': None,
        'text': 'flask.got_request_exception This signal is sent when an unhandled exception happens during request processing, including when debugging. The exception is passed to the subscriber as exception. This signal is not sent for HTTPException, or other exceptions that have error handlers registered, unless the exception was raised from an error handler. This example shows how to do some extra logging if a theoretical SecurityException was raised:',
        'type': 'definition_list',
      }),
      dict({
        'block_id': 'b_3c93d81a7726',
        'data': dict({
          'code': '''
            from flask import got_request_exception
            
            def log_security_exception(sender, exception, **extra):
                if not isinstance(exception, SecurityException):
                    return
            
                security_logger.exception(
                    f"SecurityException at {request.url!r}",
                    exc_info=exception,
                )
            
            got_request_exception.connect(log_security_exception, app)
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'API',
          'Signals',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 897,
        'page': None,
        'text': '''
          from flask import got_request_exception
          
          def log_security_exception(sender, exception, **extra):
              if not isinstance(exception, SecurityException):
                  return
          
              security_logger.exception(
                  f"SecurityException at {request.url!r}",
                  exc_info=exception,
              )
          
          got_request_exception.connect(log_security_exception, app)
  
        ''',
        'type': 'code',
      }),
