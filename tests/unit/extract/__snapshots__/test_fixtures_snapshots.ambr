        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
        ]),
        'order': 17,
        'page': None,
        'text': 'By default, ArgumentParser calculates the name of the program to display in help messages depending on the way the Python interpreter was run:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_66efa09fd650',
        'data': dict({
          'items': list([
            'The base name of sys.argv[0] if a file was passed as argument.',
            'The Python interpreter name followed by sys.argv[0] if a directory or a zipfile was passed as argument.',
            'The Python interpreter name followed by -m followed by the module or package name if the -m option was used.',
          ]),
          'ordered': False,
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'prog',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/os.path.html#os.path.basename',
            'text': 'base name',
          }),
          dict({
            'href': 'https://fixtures.nina.test/using/cmdline.html#cmdoption-m',
            'text': '-m',
          }),
        ]),
        'order': 18,
        'page': None,
        'text': 'The base name of sys.argv[0] if a file was passed as argument. The Python interpreter name followed by sys.argv[0] if a directory or a zipfile was passed as argument. The Python interpreter name followed by -m followed by the module or package name if the -m option was used.',
        'type': 'list',
      }),
      dict({
        'block_id': 'b_7be65ab6a7f1',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'prog',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
        ]),
        'order': 19,
        'page': None,
        'text': 'This default is almost always desirable because it will make the help messages match the string that was used to invoke the program on the command line. However, to change this default behavior, another value can be supplied using the prog= argument to ArgumentParser:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_6cddaf8145a1',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(prog='myprogram')
            >>> parser.print_help()
            usage: myprogram [-h]
            
            options:
             -h, --help  show this help message and exit
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'prog',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 20,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(prog='myprogram')
          >>> parser.print_help()
          usage: myprogram [-h]
          
          options:
           -h, --help  show this help message and exit
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_766d7d22bdcc',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'prog',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 21,
        'page': None,
        'text': 'Note that the program name, whether determined from sys.argv[0], from the __main__ module attributes or from the prog= argument, is available to help messages using the %(prog)s format specifier.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_2bd2e0a67d20',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(prog='myprogram')
            >>> parser.add_argument('--foo', help='foo of the %(prog)s program')
            >>> parser.print_help()
            usage: myprogram [-h] [--foo FOO]
            
            options:
             -h, --help  show this help message and exit
             --foo FOO   foo of the myprogram program
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'prog',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 22,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(prog='myprogram')
          >>> parser.add_argument('--foo', help='foo of the %(prog)s program')
          >>> parser.print_help()
          usage: myprogram [-h] [--foo FOO]
          
          options:
           -h, --help  show this help message and exit
           --foo FOO   foo of the myprogram program
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_9b46f92eb095',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'prog',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 23,
        'page': None,
        'text': 'Changed in version 3.14: The default prog value now reflects how __main__ was actually executed, rather than always being os.path.basename(sys.argv[0]).',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_7f4f1f014928',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
        ]),
        'level': 3,
        'links': list([
        ]),
        'order': 24,
        'page': None,
        'text': 'usage',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_3281ce27dd8b',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'usage',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
        ]),
        'order': 25,
        'page': None,
        'text': 'By default, ArgumentParser calculates the usage message from the arguments it contains. The default message can be overridden with the usage= keyword argument:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_5e80f222e98d',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(prog='PROG', usage='%(prog)s [options]')
            >>> parser.add_argument('--foo', nargs='?', help='foo help')
            >>> parser.add_argument('bar', nargs='+', help='bar help')
            >>> parser.print_help()
            usage: PROG [options]
            
            positional arguments:
             bar          bar help
            
            options:
             -h, --help   show this help message and exit
             --foo [FOO]  foo help
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'usage',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 26,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(prog='PROG', usage='%(prog)s [options]')
          >>> parser.add_argument('--foo', nargs='?', help='foo help')
          >>> parser.add_argument('bar', nargs='+', help='bar help')
          >>> parser.print_help()
          usage: PROG [options]
          
          positional arguments:
           bar          bar help
          
          options:
           -h, --help   show this help message and exit
           --foo [FOO]  foo help
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_9fdad17540a7',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'usage',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 27,
        'page': None,
        'text': 'The %(prog)s format specifier is available to fill in the program name in your usage messages.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_81b359b3ebc3',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'usage',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser.add_subparsers',
            'text': 'add_subparsers()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse._SubParsersAction.add_parser',
            'text': 'add_parser()',
          }),
        ]),
        'order': 28,
        'page': None,
        'text': 'When a custom usage message is specified for the main parser, you may also want to consider passing the prog argument to add_subparsers() or the prog and the usage arguments to add_parser(), to ensure consistent command prefixes and usage information across subparsers.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_f87862080a54',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
        ]),
        'level': 3,
        'links': list([
        ]),
        'order': 29,
        'page': None,
        'text': 'description',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_95e18e196f9b',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'description',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
        ]),
        'order': 30,
        'page': None,
        'text': 'Most calls to the ArgumentParser constructor will use the description= keyword argument. This argument gives a brief description of what the program does and how it works. In help messages, the description is displayed between the command-line usage string and the help messages for the various arguments.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_ff0d791bbe3e',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'description',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#formatter-class',
            'text': 'formatter_class',
          }),
        ]),
        'order': 31,
        'page': None,
        'text': 'By default, the description will be line-wrapped so that it fits within the given space. To change this behavior, see the formatter_class argument.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_a2e0201f5356',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
        ]),
        'level': 3,
        'links': list([
        ]),
        'order': 32,
        'page': None,
        'text': 'epilog',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_2c7f4fc57b28',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'epilog',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
        ]),
        'order': 33,
        'page': None,
        'text': 'Some programs like to display additional description of the program after the description of the arguments. Such text can be specified using the epilog= argument to ArgumentParser:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_5590b691da7a',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(
            ...     description='A foo that bars',
            ...     epilog="And that's how you'd foo a bar")
            >>> parser.print_help()
            usage: argparse.py [-h]
            
            A foo that bars
            
            options:
             -h, --help  show this help message and exit
            
            And that's how you'd foo a bar
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'epilog',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 34,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(
          ...     description='A foo that bars',
          ...     epilog="And that's how you'd foo a bar")
          >>> parser.print_help()
          usage: argparse.py [-h]
          
          A foo that bars
          
          options:
           -h, --help  show this help message and exit
          
          And that's how you'd foo a bar
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_92bc95b4d3aa',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'epilog',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#description',
            'text': 'description',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#formatter-class',
            'text': 'formatter_class',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
        ]),
        'order': 35,
        'page': None,
        'text': 'As with the description argument, the epilog= text is by default line-wrapped, but this behavior can be adjusted with the formatter_class argument to ArgumentParser.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_1c6880961271',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
        ]),
        'level': 3,
        'links': list([
        ]),
        'order': 36,
        'page': None,
        'text': 'parents',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_ebea74389e9c',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'parents',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
        ]),
        'order': 37,
        'page': None,
        'text': 'Sometimes, several parsers share a common set of arguments. Rather than repeating the definitions of these arguments, a single parser with all the shared arguments and passed to parents= argument to ArgumentParser can be used. The parents= argument takes a list of ArgumentParser objects, collects all the positional and optional actions from them, and adds these actions to the ArgumentParser object being constructed:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_133949adb3d5',
        'data': dict({
          'code': '''
            >>> parent_parser = argparse.ArgumentParser(add_help=False)
            >>> parent_parser.add_argument('--parent', type=int)
            
            >>> foo_parser = argparse.ArgumentParser(parents=[parent_parser])
            >>> foo_parser.add_argument('foo')
            >>> foo_parser.parse_args(['--parent', '2', 'XXX'])
            Namespace(foo='XXX', parent=2)
            
            >>> bar_parser = argparse.ArgumentParser(parents=[parent_parser])
            >>> bar_parser.add_argument('--bar')
            >>> bar_parser.parse_args(['--bar', 'YYY'])
            Namespace(bar='YYY', parent=None)
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'parents',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 38,
        'page': None,
        'text': '''
          >>> parent_parser = argparse.ArgumentParser(add_help=False)
          >>> parent_parser.add_argument('--parent', type=int)
          
          >>> foo_parser = argparse.ArgumentParser(parents=[parent_parser])
          >>> foo_parser.add_argument('foo')
          >>> foo_parser.parse_args(['--parent', '2', 'XXX'])
          Namespace(foo='XXX', parent=2)
          
          >>> bar_parser = argparse.ArgumentParser(parents=[parent_parser])
          >>> bar_parser.add_argument('--bar')
          >>> bar_parser.parse_args(['--bar', 'YYY'])
          Namespace(bar='YYY', parent=None)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_9a8be8fadd70',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'parents',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
        ]),
        'order': 39,
        'page': None,
        'text': 'Note that most parent parsers will specify add_help=False. Otherwise, the ArgumentParser will see two -h/--help options (one in the parent and one in the child) and raise an error.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_21c66a1861df',
        'data': dict({
          'kind': 'note',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'parents',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 40,
        'page': None,
        'text': 'Note You must fully initialize the parsers before passing them via parents=. If you change the parent parsers after the child parser, those changes will not be reflected in the child.',
        'type': 'admonition',
      }),
      dict({
        'block_id': 'b_03b749e0809a',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
        ]),
        'level': 3,
        'links': list([
        ]),
        'order': 41,
        'page': None,
        'text': 'formatter_class',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_c9b91643ccfb',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'formatter_class',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
        ]),
        'order': 42,
        'page': None,
        'text': 'ArgumentParser objects allow the help formatting to be customized by specifying an alternate formatting class. Currently, there are four such classes:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_d1cd0b992359',
        'data': dict({
          'items': list([
            dict({
              'definition': '',
              'term': 'class argparse.MetavarTypeHelpFormatter',
            }),
          ]),
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'formatter_class',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 43,
        'page': None,
        'text': 'class argparse.RawDescriptionHelpFormatter class argparse.RawTextHelpFormatter class argparse.ArgumentDefaultsHelpFormatter class argparse.MetavarTypeHelpFormatter',
        'type': 'definition_list',
      }),
      dict({
        'block_id': 'b_a395e9b963c7',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'formatter_class',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.RawDescriptionHelpFormatter',
            'text': 'RawDescriptionHelpFormatter',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.RawTextHelpFormatter',
            'text': 'RawTextHelpFormatter',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#description',
            'text': 'description',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#epilog',
            'text': 'epilog',
          }),
        ]),
        'order': 44,
        'page': None,
        'text': 'RawDescriptionHelpFormatter and RawTextHelpFormatter give more control over how textual descriptions are displayed. By default, ArgumentParser objects line-wrap the description and epilog texts in command-line help messages:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_c65ae8d3416a',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(
            ...     prog='PROG',
            ...     description='''this description
            ...         was indented weird
            ...             but that is okay''',
            ...     epilog='''
            ...             likewise for this epilog whose whitespace will
            ...         be cleaned up and whose words will be wrapped
            ...         across a couple lines''')
            >>> parser.print_help()
            usage: PROG [-h]
            
            this description was indented weird but that is okay
            
            options:
             -h, --help  show this help message and exit
            
            likewise for this epilog whose whitespace will be cleaned up and whose words
            will be wrapped across a couple lines
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'formatter_class',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 45,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(
          ...     prog='PROG',
          ...     description='''this description
          ...         was indented weird
          ...             but that is okay''',
          ...     epilog='''
          ...             likewise for this epilog whose whitespace will
          ...         be cleaned up and whose words will be wrapped
          ...         across a couple lines''')
          >>> parser.print_help()
          usage: PROG [-h]
          
          this description was indented weird but that is okay
          
          options:
           -h, --help  show this help message and exit
          
          likewise for this epilog whose whitespace will be cleaned up and whose words
          will be wrapped across a couple lines
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_9686b3e574de',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'formatter_class',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.RawDescriptionHelpFormatter',
            'text': 'RawDescriptionHelpFormatter',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#description',
            'text': 'description',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#epilog',
            'text': 'epilog',
          }),
        ]),
        'order': 46,
        'page': None,
        'text': 'Passing RawDescriptionHelpFormatter as formatter_class= indicates that description and epilog are already correctly formatted and should not be line-wrapped:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_2fa050091390',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(
            ...     prog='PROG',
            ...     formatter_class=argparse.RawDescriptionHelpFormatter,
            ...     description=textwrap.dedent('''\
            ...         Please do not mess up this text!
            ...         --------------------------------
            ...             I have indented it
            ...             exactly the way
            ...             I want it
            ...         '''))
            >>> parser.print_help()
            usage: PROG [-h]
            
            Please do not mess up this text!
            --------------------------------
               I have indented it
               exactly the way
               I want it
            
            options:
             -h, --help  show this help message and exit
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'formatter_class',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 47,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(
          ...     prog='PROG',
          ...     formatter_class=argparse.RawDescriptionHelpFormatter,
          ...     description=textwrap.dedent('''\
          ...         Please do not mess up this text!
          ...         --------------------------------
          ...             I have indented it
          ...             exactly the way
          ...             I want it
          ...         '''))
          >>> parser.print_help()
          usage: PROG [-h]
          
          Please do not mess up this text!
          --------------------------------
             I have indented it
             exactly the way
             I want it
          
          options:
           -h, --help  show this help message and exit
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_db9269243315',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'formatter_class',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.RawTextHelpFormatter',
            'text': 'RawTextHelpFormatter',
          }),
        ]),
        'order': 48,
        'page': None,
        'text': 'RawTextHelpFormatter maintains whitespace for all sorts of help text, including argument descriptions. However, multiple newlines are replaced with one. If you wish to preserve multiple blank lines, add spaces between the newlines.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_07d385e9b92f',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'formatter_class',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentDefaultsHelpFormatter',
            'text': 'ArgumentDefaultsHelpFormatter',
          }),
        ]),
        'order': 49,
        'page': None,
        'text': 'ArgumentDefaultsHelpFormatter automatically adds information about default values to each of the argument help messages:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_55beff121466',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(
            ...     prog='PROG',
            ...     formatter_class=argparse.ArgumentDefaultsHelpFormatter)
            >>> parser.add_argument('--foo', type=int, default=42, help='FOO!')
            >>> parser.add_argument('bar', nargs='*', default=[1, 2, 3], help='BAR!')
            >>> parser.print_help()
            usage: PROG [-h] [--foo FOO] [bar ...]
            
            positional arguments:
             bar         BAR! (default: [1, 2, 3])
            
            options:
             -h, --help  show this help message and exit
             --foo FOO   FOO! (default: 42)
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'formatter_class',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 50,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(
          ...     prog='PROG',
          ...     formatter_class=argparse.ArgumentDefaultsHelpFormatter)
          >>> parser.add_argument('--foo', type=int, default=42, help='FOO!')
          >>> parser.add_argument('bar', nargs='*', default=[1, 2, 3], help='BAR!')
          >>> parser.print_help()
          usage: PROG [-h] [--foo FOO] [bar ...]
          
          positional arguments:
           bar         BAR! (default: [1, 2, 3])
          
          options:
           -h, --help  show this help message and exit
           --foo FOO   FOO! (default: 42)
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_caea0b47af52',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'formatter_class',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.MetavarTypeHelpFormatter',
            'text': 'MetavarTypeHelpFormatter',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#type',
            'text': 'type',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#dest',
            'text': 'dest',
          }),
        ]),
        'order': 51,
        'page': None,
        'text': 'MetavarTypeHelpFormatter uses the name of the type argument for each argument as the display name for its values (rather than using the dest as the regular formatter does):',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_f5a9976b0446',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(
            ...     prog='PROG',
            ...     formatter_class=argparse.MetavarTypeHelpFormatter)
            >>> parser.add_argument('--foo', type=int)
            >>> parser.add_argument('bar', type=float)
            >>> parser.print_help()
            usage: PROG [-h] [--foo int] float
            
            positional arguments:
              float
            
            options:
              -h, --help  show this help message and exit
              --foo int
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'formatter_class',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 52,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(
          ...     prog='PROG',
          ...     formatter_class=argparse.MetavarTypeHelpFormatter)
          >>> parser.add_argument('--foo', type=int)
          >>> parser.add_argument('bar', type=float)
          >>> parser.print_help()
          usage: PROG [-h] [--foo int] float
          
          positional arguments:
            float
          
          options:
            -h, --help  show this help message and exit
            --foo int
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_3c89ac3016d1',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
        ]),
        'level': 3,
        'links': list([
        ]),
        'order': 53,
        'page': None,
        'text': 'prefix_chars',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_a92c04cd7b27',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'prefix_chars',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
        ]),
        'order': 54,
        'page': None,
        'text': 'Most command-line options will use - as the prefix, e.g. -f/--foo. Parsers that need to support different or additional prefix characters, e.g. for options like +f or /foo, may specify them using the prefix_chars= argument to the ArgumentParser constructor:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_5057530497f1',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(prog='PROG', prefix_chars='-+')
            >>> parser.add_argument('+f')
            >>> parser.add_argument('++bar')
            >>> parser.parse_args('+f X ++bar Y'.split())
            Namespace(bar='Y', f='X')
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'prefix_chars',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 55,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(prog='PROG', prefix_chars='-+')
          >>> parser.add_argument('+f')
          >>> parser.add_argument('++bar')
          >>> parser.parse_args('+f X ++bar Y'.split())
          Namespace(bar='Y', f='X')
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_48263daf2b8d',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'prefix_chars',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 56,
        'page': None,
        'text': "The prefix_chars= argument defaults to '-'. Supplying a set of characters that does not include - will cause -f/--foo options to be disallowed.",
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_430d3287a9ff',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
        ]),
        'level': 3,
        'links': list([
        ]),
        'order': 57,
        'page': None,
        'text': 'fromfile_prefix_chars',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_5538531fd17b',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'fromfile_prefix_chars',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
        ]),
        'order': 58,
        'page': None,
        'text': 'Sometimes, when dealing with a particularly long argument list, it may make sense to keep the list of arguments in a file rather than typing it out at the command line. If the fromfile_prefix_chars= argument is given to the ArgumentParser constructor, then arguments that start with any of the specified characters will be treated as files, and will be replaced by the arguments they contain. For example:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_9ac27a9714d9',
        'data': dict({
          'code': '''
            >>> with open('args.txt', 'w', encoding=sys.getfilesystemencoding()) as fp:
            ...     fp.write('-f\nbar')
            ...
            >>> parser = argparse.ArgumentParser(fromfile_prefix_chars='@')
            >>> parser.add_argument('-f')
            >>> parser.parse_args(['-f', 'foo', '@args.txt'])
            Namespace(f='bar')
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'fromfile_prefix_chars',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 59,
        'page': None,
        'text': '''
          >>> with open('args.txt', 'w', encoding=sys.getfilesystemencoding()) as fp:
          ...     fp.write('-f\nbar')
          ...
          >>> parser = argparse.ArgumentParser(fromfile_prefix_chars='@')
          >>> parser.add_argument('-f')
          >>> parser.parse_args(['-f', 'foo', '@args.txt'])
          Namespace(f='bar')
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_85668d20d164',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'fromfile_prefix_chars',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser.convert_arg_line_to_args',
            'text': 'convert_arg_line_to_args()',
          }),
        ]),
        'order': 60,
        'page': None,
        'text': "Arguments read from a file must be one per line by default (but see also convert_arg_line_to_args()) and are treated as if they were in the same place as the original file referencing argument on the command line. So in the example above, the expression ['-f', 'foo', '@args.txt'] is considered equivalent to the expression ['-f', 'foo', '-f', 'bar'].",
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_b18c64e6b3e0',
        'data': dict({
          'kind': 'note',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'fromfile_prefix_chars',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 61,
        'page': None,
        'text': "Note Each line is treated as a single argument, so an empty line is read as an empty string ('').",
        'type': 'admonition',
      }),
      dict({
        'block_id': 'b_6b2a3810e062',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'fromfile_prefix_chars',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
          dict({
            'href': 'https://fixtures.nina.test/glossary.html#term-filesystem-encoding-and-error-handler',
            'text': 'filesystem encoding and error handler',
          }),
        ]),
        'order': 62,
        'page': None,
        'text': 'ArgumentParser uses filesystem encoding and error handler to read the file containing arguments.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_5cf9cf3e5213',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'fromfile_prefix_chars',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 63,
        'page': None,
        'text': 'The fromfile_prefix_chars= argument defaults to None, meaning that arguments will never be treated as file references.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_8c8678303528',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'fromfile_prefix_chars',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/locale.html#locale.getpreferredencoding',
            'text': 'locale.getpreferredencoding(False)',
          }),
          dict({
            'href': 'https://fixtures.nina.test/glossary.html#term-filesystem-encoding-and-error-handler',
            'text': 'filesystem encoding and error handler',
          }),
        ]),
        'order': 64,
        'page': None,
        'text': 'Changed in version 3.12: ArgumentParser changed encoding and errors to read arguments files from default (e.g. locale.getpreferredencoding(False) and "strict") to the filesystem encoding and error handler. Arguments file should be encoded in UTF-8 instead of ANSI Codepage on Windows.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_01b9d6c9ac2f',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
        ]),
        'level': 3,
        'links': list([
        ]),
        'order': 65,
        'page': None,
        'text': 'argument_default',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_5e8e78bca876',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'argument_default',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser.add_argument',
            'text': 'add_argument()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser.set_defaults',
            'text': 'set_defaults()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser.parse_args',
            'text': 'parse_args()',
          }),
        ]),
        'order': 66,
        'page': None,
        'text': 'Generally, argument defaults are specified either by passing a default to add_argument() or by calling the set_defaults() methods with a specific set of name-value pairs. Sometimes however, it may be useful to specify a single parser-wide default for arguments. This can be accomplished by passing the argument_default= keyword argument to ArgumentParser. For example, to globally suppress attribute creation on parse_args() calls, we supply argument_default=SUPPRESS:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_029fafd2bbc3',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(argument_default=argparse.SUPPRESS)
            >>> parser.add_argument('--foo')
            >>> parser.add_argument('bar', nargs='?')
            >>> parser.parse_args(['--foo', '1', 'BAR'])
            Namespace(bar='BAR', foo='1')
            >>> parser.parse_args([])
            Namespace()
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'argument_default',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 67,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(argument_default=argparse.SUPPRESS)
          >>> parser.add_argument('--foo')
          >>> parser.add_argument('bar', nargs='?')
          >>> parser.parse_args(['--foo', '1', 'BAR'])
          Namespace(bar='BAR', foo='1')
          >>> parser.parse_args([])
          Namespace()
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_61021ac9d8fc',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
        ]),
        'level': 3,
        'links': list([
        ]),
        'order': 68,
        'page': None,
        'text': 'allow_abbrev',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_7889fd3da9d7',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'allow_abbrev',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser.parse_args',
            'text': 'parse_args()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#prefix-matching',
            'text': 'recognizes abbreviations',
          }),
        ]),
        'order': 69,
        'page': None,
        'text': 'Normally, when you pass an argument list to the parse_args() method of an ArgumentParser, it recognizes abbreviations of long options.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_74ef014f4019',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'allow_abbrev',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 70,
        'page': None,
        'text': 'This feature can be disabled by setting allow_abbrev to False:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_c2249785ad95',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(prog='PROG', allow_abbrev=False)
            >>> parser.add_argument('--foobar', action='store_true')
            >>> parser.add_argument('--foonley', action='store_false')
            >>> parser.parse_args(['--foon'])
            usage: PROG [-h] [--foobar] [--foonley]
            PROG: error: unrecognized arguments: --foon
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'allow_abbrev',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 71,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(prog='PROG', allow_abbrev=False)
          >>> parser.add_argument('--foobar', action='store_true')
          >>> parser.add_argument('--foonley', action='store_false')
          >>> parser.parse_args(['--foon'])
          usage: PROG [-h] [--foobar] [--foonley]
          PROG: error: unrecognized arguments: --foon
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_4f9681c27ff3',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'allow_abbrev',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 72,
        'page': None,
        'text': 'Added in version 3.5.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_20f95ee03e0b',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
        ]),
        'level': 3,
        'links': list([
        ]),
        'order': 73,
        'page': None,
        'text': 'conflict_handler',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_59704db73497',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'conflict_handler',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
        ]),
        'order': 74,
        'page': None,
        'text': 'ArgumentParser objects do not allow two actions with the same option string. By default, ArgumentParser objects raise an exception if an attempt is made to create an argument with an option string that is already in use:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_a98cfd83f223',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(prog='PROG')
            >>> parser.add_argument('-f', '--foo', help='old foo help')
            >>> parser.add_argument('--foo', help='new foo help')
            Traceback (most recent call last):
             ..
            ArgumentError: argument --foo: conflicting option string(s): --foo
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'conflict_handler',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 75,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(prog='PROG')
          >>> parser.add_argument('-f', '--foo', help='old foo help')
          >>> parser.add_argument('--foo', help='new foo help')
          Traceback (most recent call last):
           ..
          ArgumentError: argument --foo: conflicting option string(s): --foo
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_c90605c0c222',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'conflict_handler',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#parents',
            'text': 'parents',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
        ]),
        'order': 76,
        'page': None,
        'text': "Sometimes (e.g. when using parents) it may be useful to simply override any older arguments with the same option string. To get this behavior, the value 'resolve' can be supplied to the conflict_handler= argument of ArgumentParser:",
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_e0e7cb60ec61',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(prog='PROG', conflict_handler='resolve')
            >>> parser.add_argument('-f', '--foo', help='old foo help')
            >>> parser.add_argument('--foo', help='new foo help')
            >>> parser.print_help()
            usage: PROG [-h] [-f FOO] [--foo FOO]
            
            options:
             -h, --help  show this help message and exit
             -f FOO      old foo help
             --foo FOO   new foo help
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'conflict_handler',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 77,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(prog='PROG', conflict_handler='resolve')
          >>> parser.add_argument('-f', '--foo', help='old foo help')
          >>> parser.add_argument('--foo', help='new foo help')
          >>> parser.print_help()
          usage: PROG [-h] [-f FOO] [--foo FOO]
          
          options:
           -h, --help  show this help message and exit
           -f FOO      old foo help
           --foo FOO   new foo help
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_af8ed63ab4fe',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'conflict_handler',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
        ]),
        'order': 78,
        'page': None,
        'text': 'Note that ArgumentParser objects only remove an action if all of its option strings are overridden. So, in the example above, the old -f/--foo action is retained as the -f action, because only the --foo option string was overridden.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_55a04e4a33e7',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
        ]),
        'level': 3,
        'links': list([
        ]),
        'order': 79,
        'page': None,
        'text': 'add_help',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_2a31a44c711f',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'add_help',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
        ]),
        'order': 80,
        'page': None,
        'text': 'By default, ArgumentParser objects add an option which simply displays the parser’s help message. If -h or --help is supplied at the command line, the ArgumentParser help will be printed.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_bb211564e7b8',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'add_help',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
        ]),
        'order': 81,
        'page': None,
        'text': 'Occasionally, it may be useful to disable the addition of this help option. This can be achieved by passing False as the add_help= argument to ArgumentParser:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_30efd1302c50',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(prog='PROG', add_help=False)
            >>> parser.add_argument('--foo', help='foo help')
            >>> parser.print_help()
            usage: PROG [--foo FOO]
            
            options:
             --foo FOO  foo help
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'add_help',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 82,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(prog='PROG', add_help=False)
          >>> parser.add_argument('--foo', help='foo help')
          >>> parser.print_help()
          usage: PROG [--foo FOO]
          
          options:
           --foo FOO  foo help
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_9fe6be2ddc00',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'add_help',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 83,
        'page': None,
        'text': 'The help option is typically -h/--help. The exception to this is if the prefix_chars= is specified and does not include -, in which case -h and --help are not valid options. In this case, the first character in prefix_chars is used to prefix the help options:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_b3c1a1838e8e',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(prog='PROG', prefix_chars='+/')
            >>> parser.print_help()
            usage: PROG [+h]
            
            options:
              +h, ++help  show this help message and exit
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'add_help',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 84,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(prog='PROG', prefix_chars='+/')
          >>> parser.print_help()
          usage: PROG [+h]
          
          options:
            +h, ++help  show this help message and exit
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_59252ebe06fb',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
        ]),
        'level': 3,
        'links': list([
        ]),
        'order': 85,
        'page': None,
        'text': 'exit_on_error',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_f2affc1b246e',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'exit_on_error',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser.parse_args',
            'text': 'parse_args()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/sys.html#sys.stderr',
            'text': 'sys.stderr',
          }),
        ]),
        'order': 86,
        'page': None,
        'text': 'Normally, when you pass an invalid argument list to the parse_args() method of an ArgumentParser, it will print a message to sys.stderr and exit with a status code of 2.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_c74721f435c0',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'exit_on_error',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 87,
        'page': None,
        'text': 'If the user would like to catch errors manually, the feature can be enabled by setting exit_on_error to False:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_777f9c11a28f',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser(exit_on_error=False)
            >>> parser.add_argument('--integers', type=int)
            _StoreAction(option_strings=['--integers'], dest='integers', nargs=None, const=None, default=None, type=<class 'int'>, choices=None, help=None, metavar=None)
            >>> try:
            ...     parser.parse_args('--integers a'.split())
            ... except argparse.ArgumentError:
            ...     print('Catching an argumentError')
            ...
            Catching an argumentError
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'ArgumentParser objects',
          'exit_on_error',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 88,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser(exit_on_error=False)
