        'text': 'dest',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_08dd9dad60b0',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'dest',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser.parse_args',
            'text': 'parse_args()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser.add_argument',
            'text': 'add_argument()',
          }),
        ]),
        'order': 207,
        'page': None,
        'text': 'Most ArgumentParser actions add some value as an attribute of the object returned by parse_args(). The name of this attribute is determined by the dest keyword argument of add_argument(). For positional argument actions, dest is normally supplied as the first argument to add_argument():',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_30c66cf87266',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser()
            >>> parser.add_argument('bar')
            >>> parser.parse_args(['XXX'])
            Namespace(bar='XXX')
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'dest',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 208,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser()
          >>> parser.add_argument('bar')
          >>> parser.parse_args(['XXX'])
          Namespace(bar='XXX')
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_414c4f053a49',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'dest',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser',
            'text': 'ArgumentParser',
          }),
        ]),
        'order': 209,
        'page': None,
        'text': 'For optional argument actions, the value of dest is normally inferred from the option strings. ArgumentParser generates the value of dest by taking the first double-dash long option string and stripping away the initial - characters. If no double-dash long option strings were supplied, dest will be derived from the first single-dash long option string by stripping the initial - character. If no long option strings were supplied, dest will be derived from the first short option string by stripping the initial - character. Any internal - characters will be converted to _ characters to make sure the string is a valid attribute name. The examples below illustrate this behavior:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_fbb323d8169c',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser()
            >>> parser.add_argument('-f', '--foo-bar', '--foo')
            >>> parser.add_argument('-q', '-quz')
            >>> parser.add_argument('-x', '-y')
            >>> parser.parse_args('-f 1 -q 2 -x 3'.split())
            Namespace(foo_bar='1', quz='2', x='3')
            >>> parser.parse_args('--foo 1 -quz 2 -y 3'.split())
            Namespace(foo_bar='1', quz='2', x='2')
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'dest',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 210,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser()
          >>> parser.add_argument('-f', '--foo-bar', '--foo')
          >>> parser.add_argument('-q', '-quz')
          >>> parser.add_argument('-x', '-y')
          >>> parser.parse_args('-f 1 -q 2 -x 3'.split())
          Namespace(foo_bar='1', quz='2', x='3')
          >>> parser.parse_args('--foo 1 -quz 2 -y 3'.split())
          Namespace(foo_bar='1', quz='2', x='2')
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_58e02ce94752',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'dest',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 211,
        'page': None,
        'text': 'dest allows a custom attribute name to be provided:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_cf317cde3f12',
        'data': dict({
          'code': '''
            >>> parser = argparse.ArgumentParser()
            >>> parser.add_argument('--foo', dest='bar')
            >>> parser.parse_args('--foo XXX'.split())
            Namespace(bar='XXX')
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'dest',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 212,
        'page': None,
        'text': '''
          >>> parser = argparse.ArgumentParser()
          >>> parser.add_argument('--foo', dest='bar')
          >>> parser.parse_args('--foo XXX'.split())
          Namespace(bar='XXX')
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_7899f17173a0',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'dest',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#conflict-handler',
            'text': 'conflict_handler',
          }),
        ]),
        'order': 213,
        'page': None,
        'text': "Multiple arguments may share the same dest. By default, the value from the last such argument given on the command line wins. Use action='append' to collect values from all of them into a list instead. For conflicting option strings rather than dest names, see conflict_handler.",
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_fcf444c79531',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'dest',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 214,
        'page': None,
        'text': 'Changed in version 3.15: Single-dash long option now takes precedence over short options.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_1cc83d363349',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
        ]),
        'level': 3,
        'links': list([
        ]),
        'order': 215,
        'page': None,
        'text': 'deprecated',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_f1f42be34bc2',
        'data': dict({
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'deprecated',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser.add_argument',
            'text': 'add_argument()',
          }),
          dict({
            'href': 'https://fixtures.nina.test/html/sys.html#sys.stderr',
            'text': 'sys.stderr',
          }),
        ]),
        'order': 216,
        'page': None,
        'text': 'During a project’s lifetime, some arguments may need to be removed from the command line. Before removing them, you should inform your users that the arguments are deprecated and will be removed. The deprecated keyword argument of add_argument(), which defaults to False, specifies if the argument is deprecated and will be removed in the future. For arguments, if deprecated is True, then a warning will be printed to sys.stderr when the argument is used:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_b4c3a63d1160',
        'data': dict({
          'code': '''
            >>> import argparse
            >>> parser = argparse.ArgumentParser(prog='snake.py')
            >>> parser.add_argument('--legs', default=0, type=int, deprecated=True)
            >>> parser.parse_args([])
            Namespace(legs=0)
            >>> parser.parse_args(['--legs', '4'])
            snake.py: warning: option '--legs' is deprecated
            Namespace(legs=4)
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
          'The add_argument() method',
          'deprecated',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 217,
        'page': None,
        'text': '''
          >>> import argparse
          >>> parser = argparse.ArgumentParser(prog='snake.py')
          >>> parser.add_argument('--legs', default=0, type=int, deprecated=True)
          >>> parser.parse_args([])
          Namespace(legs=0)
          >>> parser.parse_args(['--legs', '4'])
          snake.py: warning: option '--legs' is deprecated
          Namespace(legs=4)
  
        ''',
        'type': 'code',
      }),
      dict({
