            'text': 'pydantic.RootModel',
          }),
        ]),
        'order': 200,
        'page': None,
        'text': 'Pydantic models can be defined with a “custom root type” by subclassing pydantic.RootModel.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_c879b52862b2',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'RootModel and custom root types',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic/base_model/#pydantic.BaseModel.model_validate',
            'text': 'model_validate',
          }),
        ]),
        'order': 201,
        'page': None,
        'text': 'The root type can be any type supported by Pydantic, and is specified by the generic parameter to RootModel. The root value can be passed to the model __init__ or model_validate via the first and only argument.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_845d1c0f2289',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'RootModel and custom root types',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 202,
        'page': None,
        'text': 'Here’s an example of how this works:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_b31a7b887d4e',
        'data': dict({
          'code': '''
            from pydantic import RootModel
            
            Pets = RootModel[list[str]]
            PetsByName = RootModel[dict[str, str]]
            
            
            print(Pets(['dog', 'cat']))
            #> root=['dog', 'cat']
            print(Pets(['dog', 'cat']).model_dump_json())
            #> ["dog","cat"]
            print(Pets.model_validate(['dog', 'cat']))
            #> root=['dog', 'cat']
            print(Pets.model_json_schema())
            """
            {'items': {'type': 'string'}, 'title': 'RootModel[list[str]]', 'type': 'array'}
            """
            
            print(PetsByName({'Otis': 'dog', 'Milo': 'cat'}))
            #> root={'Otis': 'dog', 'Milo': 'cat'}
            print(PetsByName({'Otis': 'dog', 'Milo': 'cat'}).model_dump_json())
            #> {"Otis":"dog","Milo":"cat"}
            print(PetsByName.model_validate({'Otis': 'dog', 'Milo': 'cat'}))
            #> root={'Otis': 'dog', 'Milo': 'cat'}
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'RootModel and custom root types',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 203,
        'page': None,
        'text': '''
          from pydantic import RootModel
          
          Pets = RootModel[list[str]]
          PetsByName = RootModel[dict[str, str]]
          
          
          print(Pets(['dog', 'cat']))
          #> root=['dog', 'cat']
          print(Pets(['dog', 'cat']).model_dump_json())
          #> ["dog","cat"]
          print(Pets.model_validate(['dog', 'cat']))
          #> root=['dog', 'cat']
          print(Pets.model_json_schema())
          """
          {'items': {'type': 'string'}, 'title': 'RootModel[list[str]]', 'type': 'array'}
          """
          
          print(PetsByName({'Otis': 'dog', 'Milo': 'cat'}))
          #> root={'Otis': 'dog', 'Milo': 'cat'}
          print(PetsByName({'Otis': 'dog', 'Milo': 'cat'}).model_dump_json())
          #> {"Otis":"dog","Milo":"cat"}
          print(PetsByName.model_validate({'Otis': 'dog', 'Milo': 'cat'}))
          #> root={'Otis': 'dog', 'Milo': 'cat'}
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_1c1746c217d5',
        'data': dict({
        }),
        'heading_path': list([
          'Models',
          'RootModel and custom root types',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 204,
        'page': None,
        'text': 'You can also create subclasses of the parametrized root model directly:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_16d0a01f7324',
        'data': dict({
          'code': '''
            from pydantic import RootModel
            
            
            class Pets(RootModel[list[str]]):
                def describe(self) -> str:
                    return f'Pets: {", ".join(self.root)}'
            
            
            my_pets = Pets.model_validate(['dog', 'cat'])
            
            print(my_pets.describe())
            #> Pets: dog, cat
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'RootModel and custom root types',
        ]),
