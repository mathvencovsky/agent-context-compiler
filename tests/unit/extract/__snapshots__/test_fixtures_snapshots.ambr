        'level': None,
        'links': list([
          dict({
            'href': 'https://docs.python.org/3/library/typing.html#typing.ClassVar',
            'text': 'ClassVar',
          }),
        ]),
        'order': 221,
        'page': None,
        'text': 'Attributes annotated with ClassVar are properly treated by Pydantic as class variables, and will not become fields on model instances:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_2d20cb6336fa',
        'data': dict({
          'code': '''
            from typing import ClassVar
            
            from pydantic import BaseModel
            
            
            class Model(BaseModel):
                x: ClassVar[int] = 1
            
                y: int = 2
            
            
            m = Model()
            print(m)
            #> y=2
            print(Model.x)
            #> 1
  
          ''',
          'language': 'python',
        }),
        'heading_path': list([
          'Models',
          'Automatically excluded attributes',
          'Class variables',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 222,
        'page': None,
        'text': '''
          from typing import ClassVar
          
          from pydantic import BaseModel
          
          
          class Model(BaseModel):
              x: ClassVar[int] = 1
          
              y: int = 2
          
          
          m = Model()
          print(m)
          #> y=2
          print(Model.x)
          #> 1
  
        ''',
        'type': 'code',
      }),
      dict({
