        'order': 903,
        'page': None,
        'text': '''
          from contextlib import contextmanager
          from flask import appcontext_pushed
          
          @contextmanager
          def user_set(app, user):
              def handler(sender, **kwargs):
                  g.user = user
              with appcontext_pushed.connected_to(handler, app):
                  yield
  
        ''',
        'type': 'code',
      }),
      dict({
