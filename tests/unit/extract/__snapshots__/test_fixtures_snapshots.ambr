        'level': None,
        'links': list([
          dict({
            'href': 'https://docs.python.org/3/builtins/exceptions.html#RecursionError',
            'text': 'RecursionError',
          }),
          dict({
            'href': 'https://fixtures.nina.test/docs/validation/latest/api/pydantic-core/pydantic_core/#pydantic_core.ValidationError',
            'text': 'ValidationError',
          }),
        ]),
        'order': 63,
        'page': None,
        'text': 'Rather than raising a RecursionError while attempting to validate data with cyclic references, Pydantic is able to detect the cyclic reference and raise an appropriate ValidationError:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_91bc97544168',
        'data': dict({
          'items': list([
            'Python 3.10 and above',
            'Python 3.14 and above',
          ]),
          'ordered': False,
        }),
        'heading_path': list([
          'Models',
          'Nested models',
          'Cyclic references',
