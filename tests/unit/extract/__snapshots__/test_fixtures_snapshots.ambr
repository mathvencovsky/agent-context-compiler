        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/html/python_stdlib_argparse.html#argparse.ArgumentParser.add_argument',
            'text': 'ArgumentParser.add_argument()',
          }),
        ]),
        'order': 7,
        'page': None,
        'text': 'The ArgumentParser.add_argument() method attaches individual argument specifications to the parser. It supports positional arguments, options that accept values, and on/off flags:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_d8e59053b68a',
        'data': dict({
          'code': '''
            parser.add_argument('filename')           # positional argument
            parser.add_argument('-c', '--count')      # option that takes a value
            parser.add_argument('-v', '--verbose',
                                action='store_true')  # on/off flag
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'argparse — Parser for command-line options, arguments and subcommands',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 8,
        'page': None,
        'text': '''
