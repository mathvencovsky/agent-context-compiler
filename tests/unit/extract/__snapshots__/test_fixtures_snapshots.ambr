        'links': list([
          dict({
            'href': 'https://fixtures.nina.test/glossary.html#term-hashable',
            'text': 'hashable',
          }),
        ]),
        'order': 39,
        'page': None,
        'text': 'Paths are immutable and hashable. Paths of a same flavour are comparable and orderable. These properties respect the flavour’s case-folding semantics:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_300d3594fd70',
        'data': dict({
          'code': '''
            >>> PurePosixPath('foo') == PurePosixPath('FOO')
            False
            >>> PureWindowsPath('foo') == PureWindowsPath('FOO')
            True
            >>> PureWindowsPath('FOO') in { PureWindowsPath('foo') }
            True
            >>> PureWindowsPath('C:') < PureWindowsPath('d:')
            True
  
          ''',
          'language': 'python3',
        }),
        'heading_path': list([
          'pathlib — Object-oriented filesystem paths',
          'Pure paths',
          'General properties',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 40,
        'page': None,
        'text': '''
