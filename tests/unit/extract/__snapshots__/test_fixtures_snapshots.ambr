          }),
        ]),
        'order': 110,
        'page': None,
        'text': 'The add_argument() method must know whether an optional argument, like -f or --foo, or a positional argument, like a list of filenames, is expected. The first arguments passed to add_argument() must therefore be either a series of flags, or a simple argument name.',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_8fc727a2f231',
        'data': dict({
        }),
        'heading_path': list([
