        'page': None,
        'text': 'Breaking Changes',
        'type': 'heading',
      }),
      dict({
        'block_id': 'b_f84a24275278',
        'data': dict({
          'items': list([
            '🐛 Fix unhandled growing memory for internal server errors, refactor dependencies with yield and except to require raising again as in regular Python. PR #11191 by @tiangolo.',
            "  This is a breaking change (and only slightly) if you used dependencies with yield, used except in those dependencies, and didn't raise again.",
            '  This was reported internally by @rushilsrivastava as a memory leak when the server had unhandled exceptions that would produce internal server errors, the memory allocated before that point would not be released.',
            '  Read the new docs: Dependencies with yield and except.',
          ]),
          'ordered': False,
        }),
        'heading_path': list([
          'Release Notes',
          '0.110.0 (2024-02-24)',
          'Breaking Changes',
        ]),
        'level': None,
        'links': list([
          dict({
            'href': 'https://github.com/tiangolo/fastapi/pull/11191',
            'text': '#11191',
          }),
          dict({
            'href': 'https://github.com/tiangolo',
            'text': '@tiangolo',
          }),
          dict({
            'href': 'https://github.com/rushilsrivastava',
            'text': '@rushilsrivastava',
          }),
          dict({
            'href': 'https://fastapi.tiangolo.com/tutorial/dependencies/dependencies-with-yield/#dependencies-with-yield-and-except',
            'text': 'Dependencies with yield and except',
          }),
        ]),
        'order': 915,
        'page': None,
        'text': "🐛 Fix unhandled growing memory for internal server errors, refactor dependencies with yield and except to require raising again as in regular Python. PR #11191 by @tiangolo. This is a breaking change (and only slightly) if you used dependencies with yield, used except in those dependencies, and didn't raise again. This was reported internally by @rushilsrivastava as a memory leak when the server had unhandled exceptions that would produce internal server errors, the memory allocated before that point would not be released. Read the new docs: Dependencies with yield and except.",
        'type': 'list',
      }),
      dict({
        'block_id': 'b_7c64289c7596',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.110.0 (2024-02-24)',
          'Breaking Changes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 916,
        'page': None,
        'text': 'In short, if you had dependencies that looked like:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_9bbada30e7d9',
        'data': dict({
          'code': '''
            def my_dep():
                try:
                    yield
                except SomeException:
                    pass
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'Release Notes',
          '0.110.0 (2024-02-24)',
          'Breaking Changes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 917,
        'page': None,
        'text': '''
          def my_dep():
              try:
                  yield
              except SomeException:
                  pass
  
        ''',
        'type': 'code',
      }),
      dict({
        'block_id': 'b_67c9a16d683b',
        'data': dict({
        }),
        'heading_path': list([
          'Release Notes',
          '0.110.0 (2024-02-24)',
          'Breaking Changes',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 918,
        'page': None,
        'text': 'Now you need to make sure you raise again after except, just as you would in regular Python:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_e39440560c40',
        'data': dict({
          'code': '''
            def my_dep():
                try:
                    yield
                except SomeException:
                    raise
  
          ''',
          'language': None,
        }),
        'heading_path': list([
