      dict({
        'block_id': 'b_9dfc159996a9',
        'data': dict({
          'code': '''
            from fastapi import FastAPI
            from pydantic import BaseModel
            
            
            class Item(BaseModel):
                name: str
                description: str | None = None
                price: float
                tax: float | None = None
            
            
            app = FastAPI()
            
            
            @app.post("/items/")
            async def create_item(item: Item):
                item_dict = item.model_dump()
                if item.tax is not None:
                    price_with_tax = item.price + item.tax
                    item_dict.update({"price_with_tax": price_with_tax})
                return item_dict
  
          ''',
          'language': None,
        }),
        'heading_path': list([
          'Request Body',
          'Use the model',
        ]),
        'level': None,
        'links': list([
        ]),
        'order': 44,
        'page': None,
        'text': '''
          from fastapi import FastAPI
          from pydantic import BaseModel
          
          
          class Item(BaseModel):
              name: str
              description: str | None = None
              price: float
              tax: float | None = None
          
          
          app = FastAPI()
          
          
          @app.post("/items/")
          async def create_item(item: Item):
              item_dict = item.model_dump()
              if item.tax is not None:
                  price_with_tax = item.price + item.tax
                  item_dict.update({"price_with_tax": price_with_tax})
              return item_dict
  
        ''',
        'type': 'code',
      }),
