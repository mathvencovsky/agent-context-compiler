          'items': list([
            dict({
              'definition': 'Dispatches request methods to the corresponding instance methods. For example, if you implement a get method, it will be used to handle GET requests. This can be useful for defining a REST API. methods is automatically set based on the methods defined on the class. See Class-based Views for a detailed guide.',
              'term': 'class flask.views.MethodView',
            }),
          ]),
        }),
        'heading_path': list([
