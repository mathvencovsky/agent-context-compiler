        'level': None,
        'links': list([
        ]),
        'order': 3,
        'page': None,
        'text': 'This configuration enables admonitions, allows to make them collapsible and to nest arbitrary content inside admonitions. Add the following lines to mkdocs.yml:',
        'type': 'paragraph',
      }),
      dict({
        'block_id': 'b_2936a8fcdd08',
        'data': dict({
          'code': '''
