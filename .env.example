# NINA environment configuration.
# Copy this file to .env (`cp .env.example .env`) and adjust as needed.
# NEVER commit .env — it is gitignored. Keep real secrets out of this template.
#
# Every variable below maps 1:1 to a field on app.config.Settings.

# Environment: "dev" or "production".
ENV=dev
# real: OpenAI embeddings + Jina rerank (keys below). fake: no keys, deterministic
# stand-ins so a first assemble works for a demo; refused when ENV=production.
PROVIDERS=real

# Postgres (consumed by docker-compose and by app.config.database_url).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nina

# S3 object storage. Local dev uses SeaweedFS (S3-compatible) on port 8333;
# see docker-compose.yml. SeaweedFS dev mode ignores these credentials, so the
# placeholders below are only used against real AWS S3 in production (M10).
# Host port of the local SeaweedFS S3 gateway (docker-compose.yml); keep it in
# S3_ENDPOINT_URL below.
S3_PORT=8333
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=nina-dev-access-key
S3_SECRET_KEY=nina-dev-secret-key
S3_BUCKET=nina-blobs
S3_REGION=us-east-1

# Fetcher identity (SPEC 3.1).
FETCHER_USER_AGENT=AgentContextBot/0.1 (+<contact>)
FETCHER_CONTACT_URL=https://example.com/contact

# Fetcher limits (SPEC 3.1).
MAX_BODY_BYTES=15728640
TOTAL_TIMEOUT=20
CONNECT_TIMEOUT=5
MAX_REDIRECTS=5

# Fetcher destination policy (SPEC 3.1). Comma-separated port allow-list.
ALLOWED_PORTS=80,443

# robots.txt per-domain cache TTL in seconds (SPEC 3.2 — 24h default).
ROBOTS_CACHE_TTL_SECONDS=86400

# resolve cache TTL in seconds (SPEC §5 — 24h default).
RESOLVE_CACHE_TTL_SECONDS=86400

# Render decision threshold (SPEC 3.3).
RENDER_MIN_TEXT_CHARS=500

# Browser render wait cap in ms (SPEC 3.4 — domcontentloaded + networkidle, 15s).
RENDER_NETWORKIDLE_TIMEOUT_MS=15000

# Embeddings (M6, SPEC §5). text-embedding-3-small -> 1536 dims.
EMBEDDING_DIM=1536
EMBEDDING_MODEL=text-embedding-3-small
# OpenAI key for the real embeddings adapter. Leave empty to reuse the answerer
# key: when unset it falls back to BENCH_ANSWERER_API_KEY. Tests never read it.
EMBEDDINGS_API_KEY=

# Reranker (M7, SPEC §6). Jina reranker for the real adapter; tests use the
# deterministic fake and never read the key. Leave empty here — the real .env
# holds the key.
RERANKER_API_KEY=
RERANKER_MODEL=jina-reranker-v2-base-multilingual

# Retrieval / selection parameters (SPEC 6). Calibrated and frozen in M8 Stage 1
# on the dev split only (DECISIONS.md 2026-10-13); the test split was not touched.
# SELECTION_LAMBDA moved to 0.0 in M10a Phase 3 (DECISIONS.md 2026-10-16).
SELECTION_LAMBDA=0.0
MIN_VALUE=0.0
COVERAGE_LOW=0.6137
COVERAGE_HIGH=0.7746
RRF_K=60
# NEW M8 precision knob: per-list weight the weighted RRF gives the lexical
# (exact-term) ranking vs the vector ranking (fixed at 1.0). Default 1.0 is the
# identity (reproduces plain RRF); dev-calibrated and frozen like the above.
LEXICAL_WEIGHT=1.0

# Rate limit + render quota (M9, SPEC §8). Process-local token bucket per API
# key: RATE_LIMIT_CAPACITY is the burst size (tokens) and
# RATE_LIMIT_REFILL_PER_SEC the steady refill rate; each /v1 request costs one
# token (429 + Retry-After on overflow). RENDER_DAILY_QUOTA caps browser renders
# per key per UTC day (429 'rate_limited' + Retry-After until UTC midnight).
# Overridable per key via api_keys.limits JSONB.
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SEC=1.0
RENDER_DAILY_QUOTA=200

# Benchmark LLM API keys (M2, SPEC §10). Leave empty unless running the real
# benchmark: tests and the deterministic fake provider never read them.
# BENCH_ANSWERER_API_KEY is the OpenAI key (answerer, gpt-6.1-sol);
# BENCH_JUDGE_API_KEY is the Anthropic key (judge, claude-sonnet-5-5).
BENCH_ANSWERER_API_KEY=
BENCH_JUDGE_API_KEY=

# M10 agent (read by bench/m10_agent.py, not by app.config; PREREG §4): the
# Anthropic key of the dedicated workspace that only agent sessions bill to.
# In M10, BENCH_ANSWERER_API_KEY serves the primary judge (gpt-6.1-sol) and
# BENCH_JUDGE_API_KEY the second judge (claude-opus-5-5): keep that one outside
# the agent's workspace, so the Console cost check (PREREG §6) sees agent spend only.
M10_AGENT_API_KEY=
# M10 context7_live arm (PREREG §3, Amendment 8): a Context7 API key from
# context7.com/dashboard. A free account is enough for the pilot.
CONTEXT7_API_KEY=
